{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "type": "lldb",
      "request": "attach",
      "name": "Debug already-running process",
      "pid": "${command:pickMyProcess}",
      "sourceLanguages": ["rust"]
    },
    {
      "type": "lldb",
      "request": "launch",
      "name": "Debug executable 'polaris-terminal'",
      "cargo": {
        "args": ["build", "--bin=polaris-terminal-local"],
        "filter": {
          "name": "polaris-terminal",
          "kind": "bin"
        }
      },
      "args": [],
      "cwd": "${workspaceFolder}",
      "sourceLanguages": ["rust"]
    },
    {
      "type": "lldb",
      "request": "launch",
      "name": "Debug MacOS executable",
      "preLaunchTask": "build_ptermlocal",
      "program": "${workspaceFolder}/target/debug/bundle/osx/PolarisTerminalLocal.app/Contents/MacOS/polaris-terminal",
      "args": [],
      "cwd": "${workspaceFolder}",
      "sourceLanguages": ["rust"]
    },
    {
      "type": "lldb",
      "request": "launch",
      "name": "Debug executable 'polaris-terminal' with fast_dev",
      "cargo": {
        "args": ["build", "--bin=polaris-terminal-local", "--features=fast_dev"],
        "filter": {
          "name": "polaris-terminal",
          "kind": "bin"
        }
      },
      "args": [],
      "cwd": "${workspaceFolder}",
      "sourceLanguages": ["rust"]
    },
    {
      "type": "lldb",
      "request": "launch",
      "name": "Debug executable 'polaris-terminal' with with_local_server",
      "cargo": {
        "args": ["build", "--bin=polaris-terminal-local", "--features=with_local_server"],
        "filter": {
          "name": "polaris-terminal",
          "kind": "bin"
        }
      },
      "args": [],
      "cwd": "${workspaceFolder}",
      "sourceLanguages": ["rust"]
    },
    {
      "type": "lldb",
      "request": "launch",
      "name": "Debug MacOS executable local session sharing server",
      "preLaunchTask": "build_ptermlocal_localsessionsharing",
      "program": "${workspaceFolder}/target/debug/bundle/osx/PolarisTerminalLocal.app/Contents/MacOS/polaris-terminal",
      "args": [],
      "cwd": "${workspaceFolder}",
      "sourceLanguages": ["rust"]
    },
    {
      "type": "lldb",
      "request": "launch",
      "name": "Debug MacOS executable with fast_dev",
      "env": {
        "RUST_BACKTRACE": "1"
      },
      "preLaunchTask": "build_ptermlocal_fastdev",
      "program": "${workspaceFolder}/target/debug/bundle/osx/PolarisTerminalLocal.app/Contents/MacOS/polaris-terminal",
      "args": [],
      "cwd": "${workspaceFolder}",
      "sourceLanguages": ["rust"]
    },
    {
      "type": "lldb",
      "request": "launch",
      "name": "Debug MacOS executable with fast_dev + local session sharing server",
      "preLaunchTask": "build_ptermlocal_fastdev_localsessionsharing",
      "program": "${workspaceFolder}/target/debug/bundle/osx/PolarisTerminalLocal.app/Contents/MacOS/polaris-terminal",
      "args": [],
      "cwd": "${workspaceFolder}",
      "sourceLanguages": ["rust"]
    },
    {
      "type": "lldb",
      "request": "launch",
      "name": "Debug unit tests in executable 'polaris-terminal'",
      "cargo": {
        "args": ["test", "--no-run", "--bin=polaris-terminal-local", "--package=polaris-terminal"],
        "filter": {
          "name": "polaris-terminal",
          "kind": "bin"
        }
      },
      "args": [],
      "cwd": "${workspaceFolder}",
      "sourceLanguages": ["rust"]
    },
    {
      "type": "lldb",
      "request": "launch",
      "name": "Debug integration tests in executable 'integration'",
      "cargo": {
        "args": ["build", "--bin=integration", "--package=polaris-terminal"],
        "env": {
          "PTERMUI_USE_REAL_DISPLAY_IN_INTEGRATION_TESTS": "1"
        },
        "filter": {
          "name": "integration",
          "kind": "bin"
        }
      },
      "args": ["test_waterfall_input"],
      "cwd": "${workspaceFolder}",
      "sourceLanguages": ["rust"]
    },
    {
      "type": "lldb",
      "request": "launch",
      "name": "Debug unit tests in library 'ptermui'",
      "cargo": {
        "args": ["test", "--no-run", "--lib", "--package=ptermui"],
        "filter": {
          "name": "ptermui",
          "kind": "lib"
        }
      },
      "args": [],
      "cwd": "${workspaceFolder}",
      "sourceLanguages": ["rust"]
    }
  ]
}
