# References: cloned upstream repos kept locally for study, never committed
/references/

# Rust
target/
**/*.rs.bk
*.pdb

# Python (Home Assistant glue)
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Build artifacts
dist/
build/
*.whl

# Private local-only working folders - never commit (folders included)
/docs/tasks/
/internal/

# Node / dashboard pillar
node_modules/
.next/
.turbo/
*.tsbuildinfo
next-env.d.ts
.astro/
coverage/
# pdf.js runtime assets, staged into public/ at build time from pdfjs-dist
dashboard/apps/web/public/pdfjs/
# Minecraft item icons, staged into public/ at build time from resources/mcicons
dashboard/apps/web/public/mcicons/
# Prisma generated client + local dev database
dashboard/packages/db/generated/
dashboard/packages/db/prisma/schema.sqlite.prisma
dashboard/.dev-data/
*.db
*.db-journal

# Prebuilt on-device agent binaries (produced by CI, never committed)
plugins/*/homeassistant/custom_components/*/bin/polaris-unas-agent-*

# Secrets / local env / logs - never commit
.env
.env.*
*.env
!.env.example
!*.env.example
# Generated SSH access keys for the Docker connector (never commit)
secrets/
**/secrets/ssh/
# ...but a screen *about* secrets is source, not a secret. Without this the whole
# route is silently dropped: it builds locally and 404s wherever it is deployed.
# The directory itself has to be re-included - a rule inside one that is excluded
# is never even looked at.
!dashboard/apps/web/src/app/(app)/apps/runners/secrets/
id_ed25519
id_ed25519.pub
known_hosts
*.log
secrets.*
# ...but a TypeScript module *about* secrets is source, not a secret. `secrets.*`
# is here for credential dumps (secrets.json, secrets.env, secrets.yaml); a .ts
# file is never one. Same trap as the route above, and it fails the same silent
# way: the file builds locally, is never committed, and the build dies wherever
# it is checked out fresh.
!**/secrets.ts
*.pem
*.key

# Editor / OS
.idea/
.vscode/
.DS_Store
Thumbs.db
