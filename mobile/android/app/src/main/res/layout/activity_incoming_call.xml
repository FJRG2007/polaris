<?xml version="1.0" encoding="utf-8"?>
<!-- The incoming-call screen: who is calling at the top, Decline and Answer at the bottom, as a phone draws it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fitsSystemWindows="true"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp">

    <ImageView
        android:layout_width="88dp"
        android:layout_height="88dp"
        android:layout_marginTop="72dp"
        android:contentDescription="@null"
        android:src="@drawable/logo_tile" />

    <TextView
        android:id="@+id/call_caller"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:ellipsize="end"
        android:fontFamily="@font/plex_sans_semibold"
        android:gravity="center"
        android:maxLines="2"
        android:textColor="@color/foreground"
        android:textSize="28sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="@string/call_incoming"
        android:textColor="@color/muted"
        android:textSize="16sp" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="48dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/call_decline"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/call_decline_button"
                android:contentDescription="@string/call_decline"
                android:src="@drawable/ic_call_end" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/call_decline"
                android:textColor="@color/foreground"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/call_answer"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/call_answer_button"
                android:contentDescription="@string/call_answer"
                android:src="@drawable/ic_call" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/call_answer"
                android:textColor="@color/foreground"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
