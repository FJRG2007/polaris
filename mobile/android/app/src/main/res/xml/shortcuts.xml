<?xml version="1.0" encoding="utf-8"?>
<!-- Holding the icon: the list of Polaris servers, even while the one open does not answer. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutId="change_server"
        android:shortcutShortLabel="@string/change_server_short"
        android:shortcutLongLabel="@string/change_server">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetClass="app.polaris.mobile.HostsActivity"
            android:targetPackage="app.polaris.mobile" />
    </shortcut>
    <shortcut
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutId="vault_autofill"
        android:shortcutShortLabel="@string/vault_shortcut"
        android:shortcutLongLabel="@string/vault_title">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetClass="app.polaris.mobile.VaultActivity"
            android:targetPackage="app.polaris.mobile" />
    </shortcut>
</shortcuts>
