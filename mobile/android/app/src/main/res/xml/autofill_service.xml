<?xml version="1.0" encoding="utf-8"?>
<!-- Polaris Vault as the phone's autofill service. The gear in the phone's autofill settings opens the vault screen.
     Compatibility packages: browsers that draw their pages without the autofill framework are read through
     accessibility instead (the list Bitwarden and Keyguard keep; Firefox needs none). -->
<autofill-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:settingsActivity="app.polaris.mobile.VaultActivity"
    android:supportsInlineSuggestions="true">
    <compatibility-package
        android:name="com.android.chrome"
        android:maxLongVersionCode="10000000000" />
