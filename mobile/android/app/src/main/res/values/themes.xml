<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Every native screen is drawn from the dashboard's tokens and face, never the platform's stock widgets. -->
    <style name="Theme.Polaris" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:colorAccent">@color/primary</item>
        <item name="android:colorPrimary">@color/background</item>
        <item name="android:colorControlActivated">@color/primary</item>
        <item name="android:colorControlHighlight">@color/muted_surface</item>
        <item name="android:textColorPrimary">@color/foreground</item>
        <item name="android:textColorSecondary">@color/muted</item>
        <item name="android:textColorHighlight">@color/primary_disabled</item>
        <item name="android:fontFamily">@font/plex_sans</item>
        <item name="android:buttonStyle">@style/Widget.Polaris.Button</item>
        <item name="android:editTextStyle">@style/Widget.Polaris.Field</item>
        <item name="android:alertDialogTheme">@style/Theme.Polaris.Dialog</item>
    </style>

    <!-- A link landing: nothing of its own on screen but the question it may ask. -->
    <style name="Theme.Polaris.Link" parent="Theme.Polaris">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>

    <!-- The update offer, drawn on the dashboard's card instead of the platform's grey sheet. -->
    <style name="Theme.Polaris.Dialog" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_background</item>
        <item name="android:colorAccent">@color/primary</item>
        <item name="android:textColorPrimary">@color/foreground</item>
        <item name="android:textColorSecondary">@color/muted</item>
        <item name="android:fontFamily">@font/plex_sans</item>
        <item name="android:buttonBarButtonStyle">@style/Widget.Polaris.DialogButton</item>
    </style>

    <style name="Widget.Polaris.Button" parent="android:Widget.Material.Button">
        <item name="android:background">@drawable/button_primary</item>
        <item name="android:textColor">@color/primary_foreground</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/plex_sans_medium</item>
        <item name="android:textSize">15sp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
    </style>

    <style name="Widget.Polaris.Button.Ghost">
        <item name="android:background">@drawable/button_ghost</item>
        <item name="android:textColor">@color/muted</item>
    </style>

    <style name="Widget.Polaris.DialogButton" parent="android:Widget.Material.Button.Borderless.Colored">
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/plex_sans_medium</item>
        <item name="android:textColor">@color/primary</item>
    </style>

    <style name="Widget.Polaris.Field" parent="android:Widget.Material.EditText">
        <item name="android:background">@drawable/field</item>
        <item name="android:textColor">@color/foreground</item>
        <item name="android:textColorHint">@color/muted</item>
        <item name="android:textSize">16sp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:textCursorDrawable">@drawable/cursor</item>
    </style>
</resources>
