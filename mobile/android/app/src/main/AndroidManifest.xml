<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Calls: asked for only when a call needs them. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Messages and calls while the app is closed (NoticeService). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- A ringing call opens its answer screen over the lock screen, as a phone call does. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_REMOTE_MESSAGING" />
    <!-- Location for Chat only, asked when somebody shares it; live sharing runs as a location foreground service. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.DETECT_SCREEN_CAPTURE" />
    <!-- Vault autofill: the phone's own fingerprint/face/PIN prompt opens the vault key. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Chat's + sheet shows the recent photos and videos (DeviceMedia), asked for the first time it opens. Android 14
         adds "Select photos", which grants READ_MEDIA_VISUAL_USER_SELECTED alone. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />

    <!-- Vault autofill names a new login after the app it was typed in, which needs that app to be visible here. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <application
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:localeConfig="@xml/locales_config"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Polaris"
        android:usesCleartextTraffic="true">

        <!-- configChanges: turning the phone keeps the page, a call and a half-typed message as they are. Opened from
             the launcher through one of the entries below, never directly. -->
        <activity
            android:name=".HomeActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize" />

        <!-- The launcher entry with the plain icon. Keeps the name the app's only screen had, so a home-screen icon
             placed before the seasonal ones existed still opens the app. Exactly one entry is on (SeasonIcon). -->
        <activity-alias
            android:name=".MainActivity"
            android:enabled="true"
            android:exported="true"
            android:targetActivity=".HomeActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity-alias>

        <!-- The same entry in each season's dress, off until the page names that season (SeasonIcon). Icons generated
             by mobile/scripts/season-icons.mjs. -->
        <activity-alias
            android:name=".SeasonHalloween"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_halloween"
            android:targetActivity=".HomeActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity-alias>
        <activity-alias
            android:name=".SeasonWinter"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_winter"
            android:targetActivity=".HomeActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity-alias>
        <activity-alias
            android:name=".SeasonNewYear"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_new_year"
            android:targetActivity=".HomeActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity-alias>
        <activity-alias
            android:name=".SeasonLunarNewYear"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_lunar_new_year"
            android:targetActivity=".HomeActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity-alias>

        <!-- configChanges on every screen: turning or unfolding the phone never restarts one, so an address being
             typed, a check in flight and a photo seen once (which cannot be fetched twice) all survive it. -->
        <activity
            android:name=".ServerActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density"
            android:exported="false"
            android:label="@string/server_title"
            android:windowSoftInputMode="adjustResize" />

        <!-- polaris:// links: the desktop app's servers QR, and a Polaris page opened from a link. -->
        <activity
            android:name=".LinkActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@style/Theme.Polaris.Link">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="polaris" android:host="hosts" />
                <data android:scheme="polaris" android:host="open" />
            </intent-filter>
        </activity>

        <!-- Every Polaris on this phone: open, rename, remove or add one. -->
        <activity
            android:name=".HostsActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density"
            android:exported="false"
            android:label="@string/hosts_title" />

        <!-- A photo or video sent to be seen once: its own window, kept out of screenshots (FLAG_SECURE). -->
        <activity
            android:name=".ViewOnceActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />

        <!-- A door on the home screen, and the screen that picks which. -->
        <receiver
            android:name=".DoorWidget"
            android:exported="true"
            android:label="@string/door_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/door_widget_info" />
        </receiver>

        <receiver
            android:name=".DoorPress"
            android:exported="false" />

        <!-- Approve or Deny on "Is this you?": reached only from that notification. -->
        <receiver
            android:name=".SignInAnswer"
            android:exported="false" />

        <!-- A ringing call: its answer screen over the lock screen, and Decline, reached only from the ring. -->
        <activity
            android:name=".IncomingCallActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleInstance"
            android:taskAffinity=""
            android:theme="@style/Theme.Polaris" />

        <receiver
            android:name=".CallDecline"
            android:exported="false" />

        <activity
            android:name=".DoorWidgetConfigure"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.Polaris">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- One connection to the instance for messages and calls while the app is closed. -->
        <service
            android:name=".NoticeService"
            android:exported="false"
            android:foregroundServiceType="remoteMessaging" />

        <!-- Live location shared in Chat, kept moving with the screen off until the share ends. -->
        <service
            android:name=".LiveLocationService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- The VPN in Quick Settings. The tunnel itself runs in the WireGuard library's own VpnService, which its
             manifest adds. -->
        <service
            android:name=".VpnTile"
            android:exported="true"
            android:icon="@drawable/ic_vpn"
            android:label="@string/vpn_tile"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- The system installer's answer to a self-update; only ever sent by this app's own PendingIntent. -->
        <receiver
            android:name=".UpdateResult"
            android:exported="false" />

        <!-- Where the camera writes what is taken from the file picker; never exported, granted per capture. -->
        <provider
            android:name=".CaptureProvider"
            android:authorities="app.polaris.mobile.capture"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!-- Polaris Vault autofill: the service, its screen (also opened from the phone's autofill settings), and the
             two screens that answer the system once the owner has proved who they are. -->
        <service
            android:name=".PolarisAutofillService"
            android:exported="true"
            android:label="@string/vault_title"
            android:permission="android.permission.BIND_AUTOFILL_SERVICE">
            <intent-filter>
                <action android:name="android.service.autofill.AutofillService" />
            </intent-filter>
            <meta-data
                android:name="android.autofill"
                android:resource="@xml/autofill_service" />
        </service>

        <activity
            android:name=".VaultActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density"
            android:exported="true"
            android:label="@string/vault_title" />

        <activity
            android:name=".VaultFillActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@style/Theme.Polaris.Link"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".VaultSaveActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@style/Theme.Polaris.Link" />
    </application>
</manifest>
