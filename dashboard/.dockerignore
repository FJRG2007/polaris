# Keep the build context small and free of host artifacts so the builder
# installs and generates everything fresh (e.g. the Linux Prisma engine, not a
# Windows one copied from a dev machine).
**/node_modules
**/.next
**/dist
**/.turbo
**/.gradle
resources/minecraft/*/build
resources/minecraft/*/run
**/*.tsbuildinfo
packages/db/generated
.dev-data
*.db
*.db-journal
**/.env
**/.env.*
!**/.env.example
secrets
**/secrets
# ...but a screen *about* secrets is source, not a secret. Without this the route
# is left out of the image: it builds from a checkout and answers 404 wherever it
# is deployed. A source tree under a `secrets` name anywhere else needs the same
# line - test/build/docker-context.test.ts fails until it has one.
!apps/web/src/app/(app)/apps/runners/secrets
!apps/web/src/app/(app)/automations/secrets
.git
.gitignore
*.log
coverage
