{
    "name": "@polaris-app/hospitality",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "description": "Hospitality: run a bar or restaurant - the menu, the floor, orders, the kitchen and the till - on the local network. An installable Polaris app.",
    "polaris": {
        "id": "hospitality",
        "extension": "src/lib/hospitality-extension.ts#hospitalityExtension",
        "catalog": {
            "minPolaris": "0.4.5",
            "name": {
                "en-US": "Hospitality",
                "es-ES": "Hostelería"
            },
            "summary": {
                "en-US": "Run a bar or restaurant on your own network.",
                "es-ES": "Lleva un bar o restaurante en tu propia red."
            },
            "description": {
                "en-US": "Keep the menu with prices, taxes and allergens, import it from a spreadsheet and change prices in bulk. Waiters take orders from a phone or tablet and the bar sees them at once, all on the venue's own network, with no internet needed. Uninstalling keeps the menu and every order.",
                "es-ES": "Ten la carta con precios, IVA y alérgenos, impórtala de una hoja y cambia precios de golpe. Los camareros toman comandas desde el móvil o la tablet y la barra las ve al momento, todo en la red del local, sin necesitar internet. Al desinstalar se conservan la carta y los pedidos."
            },
            "category": "Productivity",
            "nav": {
                "category": "work",
                "permission": "hospitality.use"
            },
            "permissions": [
                "hospitality.use",
                "hospitality.manage"
            ],
            "permissionDefs": [
                {
                    "key": "hospitality.use",
                    "label": {
                        "en-US": "Take orders and use the till"
                    }
                },
                {
                    "key": "hospitality.manage",
                    "label": {
                        "en-US": "Run the menu, the floor and the reports"
                    },
                    "implies": [
                        "hospitality.use"
                    ],
                    "writes": true
                }
            ],
            "coreTables": true,
            "events": [
                {
                    "name": "hospitality.order-sent",
                    "permission": "hospitality.use",
                    "label": {
                        "en-US": "Order sent to the kitchen",
                        "es-ES": "Comanda enviada a cocina"
                    },
                    "fields": {
                        "orderId": "id",
                        "venueId": "id",
                        "lines": "number"
                    }
                },
                {
                    "name": "hospitality.bill-paid",
                    "permission": "hospitality.use",
                    "label": {
                        "en-US": "Bill paid",
                        "es-ES": "Cuenta cobrada"
                    },
                    "fields": {
                        "orderId": "id",
                        "venueId": "id",
                        "due": "number",
                        "closed": "boolean"
                    }
                },
                {
                    "name": "hospitality.shift-closed",
                    "permission": "hospitality.use",
                    "label": {
                        "en-US": "Z report closed",
                        "es-ES": "Cierre Z hecho"
                    },
                    "fields": {
                        "venueId": "id",
                        "zNumber": "number",
                        "counted": "number",
                        "expected": "number",
                        "difference": "number"
                    }
                },
                {
                    "name": "hospitality.product-availability",
                    "permission": "hospitality.use",
                    "label": {
                        "en-US": "Product marked available or unavailable",
                        "es-ES": "Producto marcado disponible o agotado"
                    },
                    "fields": {
                        "productId": "id",
                        "venueId": "string",
                        "available": "boolean"
                    }
                },
                {
                    "name": "hospitality.table-waiting",
                    "permission": "hospitality.use",
                    "label": {
                        "en-US": "Table waiting to be served",
                        "es-ES": "Mesa esperando a ser servida"
                    },
                    "fields": {
                        "orderId": "id",
                        "venueId": "id",
                        "ready": "number"
                    }
                }
            ],
            "notificationKinds": [
                {
                    "id": "hospitality.table-waiting",
                    "label": {
                        "en-US": "Your table is ready to serve",
                        "es-ES": "Tu mesa está lista para servir"
                    },
                    "description": {
                        "en-US": "What you took for a table is ready at the pass.",
                        "es-ES": "Lo que pediste para una mesa está listo en el pase."
                    },
                    "level": "info",
                    "target": "/hospitality",
                    "defaults": {
                        "inapp": true,
                        "email": false
                    }
                }
            ],
            "automationSteps": [
                {
                    "type": "hospitality.action.setAvailability",
                    "label": {
                        "en-US": "Set a product's availability",
                        "es-ES": "Cambiar la disponibilidad de un producto"
                    },
                    "description": {
                        "en-US": "Take a product off the menu or put it back, everywhere or in one venue.",
                        "es-ES": "Quita un producto de la carta o vuelve a ponerlo, en todos los locales o en uno."
                    },
                    "permission": "hospitality.manage",
                    "fields": [
                        {
                            "key": "productId",
                            "kind": "id",
                            "label": {
                                "en-US": "Product",
                                "es-ES": "Producto"
                            },
                            "hint": {
                                "en-US": "Its id, or a reference to an earlier step.",
                                "es-ES": "Su id, o una referencia a un paso anterior."
                            },
                            "required": true
                        },
                        {
                            "key": "venueId",
                            "kind": "id",
                            "label": {
                                "en-US": "Venue",
                                "es-ES": "Local"
                            },
                            "hint": {
                                "en-US": "Empty for every venue.",
                                "es-ES": "Vacío para todos los locales."
                            }
                        },
                        {
                            "key": "available",
                            "kind": "boolean",
                            "label": {
                                "en-US": "Available",
                                "es-ES": "Disponible"
                            }
                        }
                    ],
                    "output": {
                        "productId": "id",
                        "available": "boolean"
                    }
                },
                {
                    "type": "hospitality.action.fireOrder",
                    "label": {
                        "en-US": "Send an order to the kitchen",
                        "es-ES": "Enviar una comanda a cocina"
                    },
                    "description": {
                        "en-US": "Fire what is still pending on an order: all of it, or one course.",
                        "es-ES": "Marcha lo pendiente de una comanda: todo, o un plato."
                    },
                    "permission": "hospitality.use",
                    "fields": [
                        {
                            "key": "orderId",
                            "kind": "id",
                            "label": {
                                "en-US": "Order",
                                "es-ES": "Comanda"
                            },
                            "required": true
                        },
                        {
                            "key": "course",
                            "kind": "number",
                            "label": {
                                "en-US": "Course",
                                "es-ES": "Plato"
                            },
                            "hint": {
                                "en-US": "Empty for everything pending.",
                                "es-ES": "Vacío para todo lo pendiente."
                            },
                            "min": 0,
                            "max": 9
                        }
                    ],
                    "output": {
                        "orderId": "id",
                        "sent": "number"
                    }
                }
            ],
            "mcpTools": [
                {
                    "name": "hospitality_open_orders",
                    "title": {
                        "en-US": "List open orders",
                        "es-ES": "Ver comandas abiertas"
                    },
                    "description": {
                        "en-US": "Lists the orders still open (not yet paid), newest first, in one venue or all: table, covers, total in cents, waiter and when it opened. Read only; it does not send, change or close anything.",
                        "es-ES": "Lista las comandas aún abiertas (sin cobrar), las más recientes primero, en un local o en todos: mesa, comensales, total en céntimos, camarero y hora de apertura. Solo lectura; no envía, cambia ni cierra nada."
                    },
                    "permission": "hospitality.use",
                    "readOnly": true,
                    "fields": [
                        {
                            "key": "venueId",
                            "kind": "id",
                            "label": {
                                "en-US": "Venue",
                                "es-ES": "Local"
                            },
                            "hint": {
                                "en-US": "Leave empty for every venue.",
                                "es-ES": "Vacío para todos los locales."
                            }
                        }
                    ],
                    "output": {
                        "count": "number"
                    },
                    "items": {
                        "orderId": "id",
                        "venueId": "id",
                        "table": "string",
                        "covers": "number",
                        "total": "number",
                        "waiter": "string",
                        "openedAt": "string"
                    }
                },
                {
                    "name": "hospitality_product_availability",
                    "title": {
                        "en-US": "Check product availability",
                        "es-ES": "Ver si un producto está disponible"
                    },
                    "description": {
                        "en-US": "Says whether a product can be ordered right now, everywhere or in one venue (a venue's own setting wins). Read only; to change it use the automation step.",
                        "es-ES": "Dice si un producto se puede pedir ahora, en todos los locales o en uno (manda el ajuste del local). Solo lectura; para cambiarlo usa el paso de automatización."
                    },
                    "permission": "hospitality.use",
                    "readOnly": true,
                    "fields": [
                        {
                            "key": "productId",
                            "kind": "id",
                            "label": {
                                "en-US": "Product",
                                "es-ES": "Producto"
                            },
                            "required": true
                        },
                        {
                            "key": "venueId",
                            "kind": "id",
                            "label": {
                                "en-US": "Venue",
                                "es-ES": "Local"
                            },
                            "hint": {
                                "en-US": "Leave empty for every venue.",
                                "es-ES": "Vacío para todos los locales."
                            }
                        }
                    ],
                    "output": {
                        "productId": "id",
                        "name": "string",
                        "available": "boolean"
                    }
                }
            ],
            "sections": [
                {
                    "label": {
                        "en-US": "Service",
                        "es-ES": "Servicio"
                    },
                    "path": "/x/hospitality",
                    "keywords": [
                        {
                            "en-US": "tables",
                            "es-ES": "mesas"
                        },
                        {
                            "en-US": "orders",
                            "es-ES": "comandas"
                        }
                    ]
                },
                {
                    "label": {
                        "en-US": "Kitchen",
                        "es-ES": "Cocina"
                    },
                    "path": "/x/hospitality/kitchen",
                    "keywords": [
                        {
                            "en-US": "tickets",
                            "es-ES": "tickets"
                        },
                        {
                            "en-US": "kds",
                            "es-ES": "kds"
                        }
                    ]
                },
                {
                    "label": {
                        "en-US": "Till",
                        "es-ES": "Caja"
                    },
                    "path": "/x/hospitality/till",
                    "keywords": [
                        {
                            "en-US": "z report",
                            "es-ES": "cierre z"
                        },
                        {
                            "en-US": "payments",
                            "es-ES": "cobros"
                        }
                    ],
                    "permission": "hospitality.manage"
                },
                {
                    "label": {
                        "en-US": "Menu",
                        "es-ES": "Carta"
                    },
                    "path": "/x/hospitality/menu",
                    "keywords": [
                        {
                            "en-US": "products",
                            "es-ES": "productos"
                        },
                        {
                            "en-US": "prices",
                            "es-ES": "precios"
                        }
                    ]
                }
            ],
            "chatCommands": [
                {
                    "name": "table",
                    "description": {
                        "en-US": "Whether a table has an order open, and how it stands",
                        "es-ES": "Si una mesa tiene una comanda abierta y cómo va"
                    },
                    "hint": {
                        "en-US": "table",
                        "es-ES": "mesa"
                    },
                    "permission": "hospitality.use"
                }
            ]
        }
    },
    "dependencies": {
        "@polaris/app-host": "0.1.0",
        "@polaris/core": "0.1.0",
        "@polaris/db": "0.1.0",
        "@polaris/ui": "0.1.0",
        "lucide-react": "0.469.0",
        "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
        "zod": "3.25.76"
    },
    "peerDependencies": {
        "next": "*",
        "react": "^19",
        "react-dom": "^19"
    }
}
