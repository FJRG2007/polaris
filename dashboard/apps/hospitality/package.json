{
    "name": "@polaris-app/hospitality",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "description": "Hospitality: run a bar or restaurant - the menu, the floor, orders, the kitchen and the till - on the local network. An installable Polaris app.",
    "polaris": {
        "id": "hospitality",
        "extension": "src/lib/hospitality-extension.ts#hospitalityExtension",
        "catalog": {
            "minPolaris": "0.4.5",
            "name": {
                "en-US": "Hospitality",
                "es-ES": "Hostelería"
            },
            "summary": {
                "en-US": "Run a bar or restaurant on your own network.",
                "es-ES": "Lleva un bar o restaurante en tu propia red."
            },
            "description": {
                "en-US": "Keep the menu with prices, taxes and allergens, import it from a spreadsheet and change prices in bulk. Waiters take orders from a phone or tablet and the bar sees them at once, all on the venue's own network, with no internet needed. Uninstalling keeps the menu and every order.",
                "es-ES": "Ten la carta con precios, IVA y alérgenos, impórtala de una hoja y cambia precios de golpe. Los camareros toman comandas desde el móvil o la tablet y la barra las ve al momento, todo en la red del local, sin necesitar internet. Al desinstalar se conservan la carta y los pedidos."
            },
            "category": "Productivity",
            "nav": {
                "category": "work",
                "permission": "hospitality.use"
            },
            "permissions": [
                "hospitality.use",
                "hospitality.manage"
            ],
            "permissionDefs": [
                {
                    "key": "hospitality.use",
                    "label": {
                        "en-US": "Take orders and use the till"
                    }
                },
                {
                    "key": "hospitality.manage",
                    "label": {
                        "en-US": "Run the menu, the floor and the reports"
                    },
                    "implies": [
                        "hospitality.use"
                    ],
                    "writes": true
                }
            ],
            "coreTables": true,
            "events": [
                {
                    "name": "hospitality.order-sent",
                    "label": {
                        "en-US": "Order sent to the kitchen",
                        "es-ES": "Comanda enviada a cocina"
                    },
                    "fields": {
                        "orderId": "id",
                        "venueId": "id",
                        "lines": "number"
                    }
                },
                {
                    "name": "hospitality.bill-paid",
                    "label": {
                        "en-US": "Bill paid",
                        "es-ES": "Cuenta cobrada"
                    },
                    "fields": {
                        "orderId": "id",
                        "venueId": "id",
                        "due": "number",
                        "closed": "boolean"
                    }
                },
                {
                    "name": "hospitality.shift-closed",
                    "label": {
                        "en-US": "Z report closed",
                        "es-ES": "Cierre Z hecho"
                    },
                    "fields": {
                        "venueId": "id",
                        "zNumber": "number",
                        "counted": "number",
                        "expected": "number",
                        "difference": "number"
                    }
                },
                {
                    "name": "hospitality.product-availability",
                    "label": {
                        "en-US": "Product marked available or unavailable",
                        "es-ES": "Producto marcado disponible o agotado"
                    },
                    "fields": {
                        "productId": "id",
                        "venueId": "string",
                        "available": "boolean"
                    }
                },
                {
                    "name": "hospitality.table-waiting",
                    "label": {
                        "en-US": "Table waiting to be served",
                        "es-ES": "Mesa esperando a ser servida"
                    },
                    "fields": {
                        "orderId": "id",
                        "venueId": "id",
                        "ready": "number"
                    }
                }
            ],
            "notificationKinds": [
                {
                    "id": "hospitality.table-waiting",
                    "label": {
                        "en-US": "Your table is ready to serve",
                        "es-ES": "Tu mesa está lista para servir"
                    },
                    "description": {
                        "en-US": "What you took for a table is ready at the pass.",
                        "es-ES": "Lo que pediste para una mesa está listo en el pase."
                    },
                    "level": "info",
                    "target": "/hospitality",
                    "defaults": {
                        "inapp": true,
                        "email": false
                    }
                }
            ]
        }
    },
    "dependencies": {
        "@polaris/app-host": "0.1.0",
        "@polaris/core": "0.1.0",
        "@polaris/db": "0.1.0",
        "@polaris/ui": "0.1.0",
        "lucide-react": "0.469.0",
        "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
        "zod": "3.25.76"
    },
    "peerDependencies": {
        "next": "*",
        "react": "^19",
        "react-dom": "^19"
    }
}
