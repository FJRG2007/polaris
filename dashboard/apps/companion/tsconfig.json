{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ES2022",
        "moduleResolution": "Bundler",
        "customConditions": ["node"],
        "lib": ["ES2022"],
        "types": ["node"],
        "strict": true,
        "noImplicitOverride": true,
        "noUncheckedIndexedAccess": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "isolatedModules": true
    },
    "include": ["src/**/*.ts", "test/**/*.ts"]
}
