{
    "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
    "Name": "Polaris",
    "Version": "0.1.0.0",
    "Author": "Polaris",
    "Description": "Keys and dials for your Polaris: send a message, set your status, mute or hang up your call, play a sound, see unread messages, alarms and deployments, and switch the devices in your places.",
    "Icon": "imgs/plugin/marketplace",
    "Category": "Polaris",
    "CategoryIcon": "imgs/plugin/category-icon",
    "CodePath": "bin/plugin.js",
    "SDKVersion": 3,
    "Software": {
        "MinimumVersion": "7.1"
    },
    "OS": [
        {
            "Platform": "mac",
            "MinimumVersion": "12"
        },
        {
            "Platform": "windows",
            "MinimumVersion": "10"
        }
    ],
    "Nodejs": {
        "Version": "24"
    },
    "UUID": "io.github.fjrg2007.polaris",
    "Profiles": [
        {
            "Name": "profiles/polaris",
            "DeviceType": 0,
            "AutoInstall": false,
            "DontAutoSwitchWhenInstalled": true
        },
        {
            "Name": "profiles/polaris-mini",
            "DeviceType": 1,
            "AutoInstall": false,
            "DontAutoSwitchWhenInstalled": true
        },
        {
            "Name": "profiles/polaris-xl",
            "DeviceType": 2,
            "AutoInstall": false,
            "DontAutoSwitchWhenInstalled": true
        },
        {
            "Name": "profiles/polaris-plus",
            "DeviceType": 7,
            "AutoInstall": false,
            "DontAutoSwitchWhenInstalled": true
        },
        {
            "Name": "profiles/polaris-neo",
            "DeviceType": 9,
            "AutoInstall": false,
            "DontAutoSwitchWhenInstalled": true
        },
        {
            "Name": "profiles/polaris-plus-xl",
            "DeviceType": 13,
            "AutoInstall": false,
            "DontAutoSwitchWhenInstalled": true
        }
    ],
    "Actions": [
        {
            "Name": "Folder",
            "UUID": "io.github.fjrg2007.polaris.folder",
            "Icon": "imgs/actions/folder/icon",
            "Tooltip": "Opens a page of Polaris keys made for your deck; the same key there brings you back.",
            "PropertyInspectorPath": "ui/folder.html",
            "Controllers": ["Keypad"],
            "States": [
                {
                    "Image": "imgs/actions/folder/key",
                    "ShowTitle": false,
                    "TitleAlignment": "bottom"
                }
            ]
        },
        {
            "Name": "Action",
            "UUID": "io.github.fjrg2007.polaris.key",
            "Icon": "imgs/actions/key/icon",
            "Tooltip": "Runs a Polaris action or shows its live state.",
            "PropertyInspectorPath": "ui/key.html",
            "Controllers": ["Keypad"],
            "States": [
                {
                    "Image": "imgs/actions/key/key",
                    "ShowTitle": false
                }
            ]
        },
        {
            "Name": "Device dial",
            "UUID": "io.github.fjrg2007.polaris.dial",
            "Icon": "imgs/actions/dial/icon",
            "Tooltip": "Adjusts a Polaris device, such as a light's brightness.",
            "PropertyInspectorPath": "ui/dial.html",
            "Controllers": ["Encoder"],
            "Encoder": {
                "layout": "$B1",
                "Icon": "imgs/actions/dial/encoder",
                "TriggerDescription": {
                    "Rotate": "Adjust",
                    "Push": "Apply",
                    "Touch": "Apply"
                }
            },
            "States": [
                {
                    "Image": "imgs/actions/dial/key"
                }
            ]
        },
        {
            "Name": "Timer",
            "UUID": "io.github.fjrg2007.polaris.timer",
            "Icon": "imgs/actions/timer/icon",
            "Tooltip": "A countdown or stopwatch. Press to start or pause, hold to reset.",
            "PropertyInspectorPath": "ui/timer.html",
            "Controllers": ["Keypad", "Encoder"],
            "Encoder": {
                "layout": "$B1",
                "Icon": "imgs/actions/timer/encoder",
                "TriggerDescription": {
                    "Rotate": "Set the minutes",
                    "Push": "Start or pause",
                    "Touch": "Reset"
                }
            },
            "States": [
                {
                    "Image": "imgs/actions/timer/key",
                    "ShowTitle": false
                }
            ]
        },
        {
            "Name": "Call",
            "UUID": "io.github.fjrg2007.polaris.call",
            "Icon": "imgs/actions/call/icon",
            "Tooltip": "Mute, deafen, camera, record, share your screen or hang up the call you are on in Polaris.",
            "PropertyInspectorPath": "ui/call.html",
            "Controllers": ["Keypad"],
            "States": [
                {
                    "Image": "imgs/actions/call/key",
                    "ShowTitle": false
                }
            ]
        },
        {
            "Name": "Soundboard",
            "UUID": "io.github.fjrg2007.polaris.sound",
            "Icon": "imgs/actions/sound/icon",
            "Tooltip": "Plays one of your sounds into the call you are on.",
            "PropertyInspectorPath": "ui/sound.html",
            "Controllers": ["Keypad"],
            "States": [
                {
                    "Image": "imgs/actions/sound/key",
                    "ShowTitle": false
                }
            ]
        },
        {
            "Name": "Places device",
            "UUID": "io.github.fjrg2007.polaris.places",
            "Icon": "imgs/actions/places/icon",
            "Tooltip": "A device of your places on its own key: shows it, and switches, opens or locks it.",
            "PropertyInspectorPath": "ui/places.html",
            "Controllers": ["Keypad"],
            "States": [
                {
                    "Image": "imgs/actions/places/key",
                    "ShowTitle": false
                }
            ]
        },
        {
            "Name": "Places dial",
            "UUID": "io.github.fjrg2007.polaris.places-dial",
            "Icon": "imgs/actions/places-dial/icon",
            "Tooltip": "Sets a light's brightness or an air conditioner's temperature.",
            "PropertyInspectorPath": "ui/places-dial.html",
            "Controllers": ["Encoder"],
            "Encoder": {
                "layout": "$B1",
                "Icon": "imgs/actions/places-dial/encoder",
                "TriggerDescription": {
                    "Rotate": "Adjust",
                    "Push": "On or off",
                    "Touch": "Apply"
                }
            },
            "States": [
                {
                    "Image": "imgs/actions/places-dial/key"
                }
            ]
        }
    ]
}
