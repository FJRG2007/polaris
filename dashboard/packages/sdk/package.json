{
    "name": "@polaris/sdk",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "description": "Typed client for the Polaris session API: start, prompt and stop agent sessions, and follow one as an event stream.",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "scripts": {
        "build": "tsup src/index.ts --format esm --dts --clean",
        "typecheck": "tsc --noEmit",
        "test": "vitest run"
    },
    "dependencies": {
        "zod": "3.25.76"
    }
}
