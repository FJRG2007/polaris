{
    "name": "@polaris/genoffice-slides",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "description": "GenOffice's slides editor, its renderer half. Ported from GenOffice (Apache-2.0) - see NOTICE. Not wired to a route: the bridge it talks to is an Electron channel, and Polaris' equivalent is server actions.",
    "exports": {
        ".": {
            "types": "./dist/App.d.ts",
            "import": "./dist/App.js",
            "default": "./dist/App.js"
        },
        "./slide": {
            "types": "./dist/SlideThumb.d.ts",
            "import": "./dist/SlideThumb.js",
            "default": "./dist/SlideThumb.js"
        },
        "./images": {
            "types": "./dist/image-loader.d.ts",
            "import": "./dist/image-loader.js",
            "default": "./dist/image-loader.js"
        }
    },
    "scripts": {
        "build": "tsup src/renderer/App.tsx src/renderer/SlideThumb.tsx src/renderer/image-loader.ts --format esm --dts --clean --external react --external react-dom --loader .md=text",
        "typecheck": "tsc --noEmit",
        "test": "vitest run --passWithNoTests"
    },
    "dependencies": {
        "@polaris/docx": "*",
        "@polaris/genoffice-agent": "*",
        "@polaris/genoffice-ai": "*",
        "@polaris/genoffice-i18n": "*",
        "@polaris/genoffice-ui": "*",
        "@polaris/pptx": "*",
        "@polaris/pptx-render": "*",
        "@polaris/project-store": "*",
        "acorn": "8.14.0",
        "konva": "9.3.16",
        "react": "19.0.0",
        "react-dom": "19.0.0",
        "react-konva": "19.0.3"
    },
    "main": "./dist/App.js",
    "types": "./dist/App.d.ts"
}
