// Polaris data model.
//
// Design constraints (do not relitigate):
//   - Postgres in production, but kept SQLite-portable: no Postgres-only column
//     types beyond the id type, no native enums (String + app-level Zod unions),
//     no scalar arrays or JSONB columns (JSON is stored as a stringified String).
//     The gen-sqlite-schema script swaps the datasource provider and strips the
//     Postgres-only @db.Uuid mapping (SQLite stores the uuid as TEXT).
//   - Every surrogate primary key and id reference is a UUIDv7 stored in a native
//     Postgres `uuid` column (@db.Uuid). Natural keys (GeoIpCache.ip) stay text.
//   - Byte counts use BigInt (files can exceed 2^53) and are handled as bigint
//     in application code, never coerced through a lossy Number.
//   - Polaris is a control plane, not a file mirror: the Node table holds rows
//     only for objects Polaris must track (shared or requested items). Live
//     directory listings come from the storage driver and are never persisted.
//   - better-auth owns the User/Session/Account/Verification core fields; the
//     extra columns and the Role/UserRole tables are Polaris additions. better-auth
//     is configured to generate UUIDs so its inserts fit the uuid columns.

generator client {
    provider = "prisma-client-js"
    output   = "../generated/client"
}

datasource db {
    provider = "postgresql"
    url      = env("POLARIS_DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity and access
// ---------------------------------------------------------------------------

model User {
    id            String   @id @default(uuid(7)) @db.Uuid
    name          String
    email         String   @unique
    // Unique handle; sign-in accepts either this or the email.
    username      String?  @unique
    emailVerified Boolean  @default(false)
    image         String?
    // Free-text organisation the account belongs to; shown on the profile only.
    company       String?
    // How this account wants dates, times, temperatures and money written, as
    // stringified JSON holding only the fields it actually chose. Absent fields
    // (and a null column) follow the platform default.
    displayPrefs  String?
    // Which events this account wants told about and how, as stringified JSON
    // keyed by event id. Events absent here (and a null column) follow the
    // catalogue default, so a newly added event never arrives muted.
    notifyPrefs   String?
    // Owned by the better-auth two-factor plugin; flipped on once the user has
    // verified their authenticator, and back off when they disable it.
    twoFactorEnabled Boolean @default(false)
    // Second gate for admin-only routes, independent of role permissions.
    isAdmin       Boolean  @default(false)
    // When set, the account is banned: sign-in is refused and sessions are void.
    bannedAt      DateTime?
    banReason     String?
    createdAt     DateTime @default(now())
    updatedAt     DateTime @updatedAt

    sessions     Session[]
    accounts     Account[]
    roles        UserRole[]
    groups       GroupMember[]
    invitesSent  Invite[]                @relation("InviteInviter")
    connections       StorageConnection[]
    dockerConnections DockerConnection[]
    hosts             Host[]
    shares            Share[]
    shareInvites      ShareInvite[]
    fileRequests      FileRequest[]
    submissions       FileRequestSubmission[]
    dropPointVisits   FileRequestVisit[]
    dropPointTemplates DropPointTemplate[]
    uploads           UploadSession[]
    notifications     Notification[]
    deployTargets     DeployTarget[]
    projects          Project[]
    projectMemberships ProjectMember[]
    deployTickets     DeployTicket[]
    security            UserSecurity?
    securityQuestions   SecurityQuestion[]
    accountRecoveries   AccountRecovery[]
    accessGroups        AccessGroup[]
    accessGroupBindings UserAccessGroup[]
    apiKeys             ApiKey[]
    twoFactors          TwoFactor[]
    sessionStates       SessionState[]
    emails              UserEmail[]
    phone               UserPhone?
    emailVerifications  EmailVerification[]
    passkeys            Passkey[]
    notifyDestinations  NotificationDestination[]
    notifyDeliveries    NotificationDelivery[]
    enrollments         Enrollment[]
    runnerPools         RunnerPool[]
    githubIdentity      GithubIdentity?
}

// Addresses a user owns besides the one they sign in with. The primary stays on
// User.email because that is what authenticates; these are alternates, and any
// of them can be marked as a way to reach the owner if they lose access. Unique
// across the table, and checked against every primary before being added, so one
// address never belongs to two accounts.
model UserEmail {
    id        String   @id @default(uuid(7)) @db.Uuid
    userId    String   @db.Uuid
    email     String   @unique
    recovery  Boolean  @default(false)
    // When the owner proved they can read mail at this address. Null means the
    // address is claimed but unproven; the primary address records the same
    // thing on User.emailVerified, which better-auth owns.
    verifiedAt DateTime?
    createdAt DateTime @default(now())

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
}

// A pending "click this to prove the address is yours" link. The raw token lives
// only in the emailed URL; the row keeps its SHA-256 hash, so a database dump
// yields no usable links. One row per outstanding request, replaced when a new
// link is asked for, and deleted the moment it is spent.
model EmailVerification {
    id        String   @id @default(uuid(7)) @db.Uuid
    userId    String   @db.Uuid
    // The address being proved. Held here rather than resolved through UserEmail
    // so a link keeps meaning the address it was sent to even if the row moves.
    email     String
    tokenHash String   @unique
    expiresAt DateTime
    createdAt DateTime @default(now())

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
}

// The number a second-factor code can be sent to. One per account, keyed by the
// user, because it exists to reach one person rather than to be a directory:
// there is nothing to choose between two numbers at the moment someone is
// waiting on a code. Stored in international form, exactly as it will be dialled.
//
// The pending confirmation lives on the same row - a low-entropy code, hashed
// with the password hasher like the quick-unlock PIN, with an expiry and a cap
// on wrong guesses. A number is only usable as a factor once verifiedAt is set.
model UserPhone {
    userId        String    @id @db.Uuid
    phone         String
    verifiedAt    DateTime?
    codeHash      String?
    codeExpiresAt DateTime?
    attempts      Int       @default(0)
    createdAt     DateTime  @default(now())
    updatedAt     DateTime  @updatedAt

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
    id        String   @id @default(uuid(7)) @db.Uuid
    token     String   @unique
    expiresAt DateTime
    ipAddress String?
    userAgent String?
    userId    String   @db.Uuid
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
    state SessionState?

    @@index([userId])
}

model Account {
    id                    String    @id @default(uuid(7)) @db.Uuid
    accountId             String
    providerId            String
    userId                String    @db.Uuid
    accessToken           String?
    refreshToken          String?
    idToken               String?
    accessTokenExpiresAt  DateTime?
    refreshTokenExpiresAt DateTime?
    scope                 String?
    password              String?
    createdAt             DateTime  @default(now())
    updatedAt             DateTime  @updatedAt

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
}

model Verification {
    id         String   @id @default(uuid(7)) @db.Uuid
    identifier String
    value      String
    expiresAt  DateTime
    createdAt  DateTime @default(now())
    updatedAt  DateTime @updatedAt

    @@index([identifier])
}

// A WebAuthn credential: a passkey held by the user's device or password
// manager, proved by the device rather than typed. Every column here is the
// passkey plugin's to decide; Polaris only stores them.
model Passkey {
    id           String   @id @default(uuid(7)) @db.Uuid
    // What the user calls it, e.g. "iPhone". Set when it is registered.
    name         String?
    publicKey    String
    userId       String   @db.Uuid
    credentialID String
    // Replay counter the authenticator reports on each assertion.
    counter      Int
    // singleDevice | multiDevice, as WebAuthn reports it.
    deviceType   String
    // Whether the credential is synced to the platform's keychain.
    backedUp     Boolean
    // Comma-separated transport hints (usb, nfc, ble, internal, hybrid).
    transports   String?
    // Identifies the authenticator model, for labelling it in the UI.
    aaguid       String?
    // The address it was registered on, which is the only one it signs in on.
    // Null on rows that predate this: those were all issued under the app URL.
    rpId         String?
    createdAt    DateTime @default(now())

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
    @@index([credentialID])
}

model Role {
    id          String     @id @default(uuid(7)) @db.Uuid
    name        String     @unique
    // JSON array of permission keys (or the "*" wildcard). Stored as a string
    // for SQLite portability; validated by @polaris/core on read.
    permissions String
    isSystem    Boolean    @default(false)
    createdAt   DateTime   @default(now())
    users       UserRole[]
}

model UserRole {
    userId String @db.Uuid
    roleId String @db.Uuid
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
    role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

    @@id([userId, roleId])
    @@index([roleId])
}

model Invite {
    id          String    @id @default(uuid(7)) @db.Uuid
    email       String
    // SHA-256 of the invite token; the raw token lives only in the emailed link.
    tokenHash   String    @unique
    roleId      String?   @db.Uuid
    invitedById String    @db.Uuid
    expiresAt   DateTime
    acceptedAt  DateTime?
    createdAt   DateTime  @default(now())
    // How the invite travels and what the recipient presents to claim it:
    // "link" (the admin hands the URL over), "magic" (Polaris emails the URL),
    // or "code" (a short code typed on the join page).
    method      String    @default("link")
    // SHA-256 of the invitation code, for the "code" method. The code itself is
    // shown once at creation and never stored.
    codeHash    String?   @unique
    // Slow hash of an optional one-time password the recipient must also present.
    // Communicated out of band, so a leaked link alone claims nothing.
    passwordHash String?
    // When Polaris sent the invite itself, so the list can report delivery.
    sentAt      DateTime?
    // Where the invite may be claimed from, and the restrictions the account
    // carries afterwards - the same rules, enforced at both moments. JSON string
    // arrays; empty everywhere means no restriction. accessGroupIds names access
    // groups owned by the inviter, resolved when the invite is claimed.
    allowedCidrs      String @default("[]")
    allowedCountries  String @default("[]")
    allowedContinents String @default("[]")
    accessGroupIds    String @default("[]")

    invitedBy User @relation("InviteInviter", fields: [invitedById], references: [id], onDelete: Cascade)

    @@index([email])
}

// ---------------------------------------------------------------------------
// Account security
//
// Everything a user configures about their own account's protection. The rows
// here are per-user, self-service, and never contain a recoverable secret: the
// PIN and the security-question answers go through the same slow hasher as
// passwords, and an API key is only ever stored as the SHA-256 of the issued
// secret.
// ---------------------------------------------------------------------------

// Owned by the better-auth two-factor plugin (TOTP secret + backup codes). The
// secret is encrypted by better-auth under POLARIS_AUTH_SECRET before it lands
// here, and neither column is ever returned to a client.
model TwoFactor {
    id                      String    @id @default(uuid(7)) @db.Uuid
    userId                  String    @db.Uuid
    secret                  String
    backupCodes             String
    verified                Boolean   @default(true)
    failedVerificationCount Int       @default(0)
    lockedUntil             DateTime?

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
    @@index([secret])
}

// A user's own security preferences. One row per user, created lazily the first
// time they change anything (absent means every default below applies).
model UserSecurity {
    userId               String    @id @db.Uuid
    // Hash of the 4-6 digit quick-unlock PIN, or null when none is set.
    // The PIN only re-opens a locked dashboard; signing in always needs the
    // password, so its low entropy never guards the account itself.
    pinHash              String?
    pinUpdatedAt         DateTime?
    // Minutes of inactivity before the dashboard locks. 0 disables the lock.
    idleLockMinutes      Int       @default(0)
    // Absolute session lifetime in minutes, after which the session is signed
    // out regardless of activity. 0 keeps the global default.
    sessionMaxMinutes    Int       @default(0)
    // New sign-ins must be approved from an already-active session.
    requireLoginApproval Boolean   @default(false)
    // Second-factor delivery methods the account accepts, beyond the
    // authenticator, which is always accepted while the factor is on. JSON
    // string array for SQLite portability; empty means authenticator only.
    twoFactorMethods     String    @default("[]")
    // Which method the challenge offers first. Null means the authenticator.
    twoFactorPreferred   String?
    // A short-lived, single-use pass for the approval gate above. Arming or
    // disabling an authenticator replaces the session it was done from, and the
    // replacement is the same person on the same device - not a new sign-in.
    // Bound to the address that asked for it and consumed on first use.
    rotationGraceUntil   DateTime?
    rotationGraceIp      String?
    // Sign-in restrictions set directly on the account, on top of whatever the
    // attached access groups contribute. JSON string arrays for SQLite
    // portability; empty everywhere means no restriction.
    allowedCidrs         String    @default("[]")
    allowedCountries     String    @default("[]")
    allowedContinents    String    @default("[]")
    // Restrictions an administrator imposed on the account. Held apart from the
    // account's own rules above because the two are judged independently: a
    // sign-in must satisfy both, so nothing the user does under Account >
    // Security can widen or drop what an administrator set.
    adminCidrs           String    @default("[]")
    adminCountries       String    @default("[]")
    adminContinents      String    @default("[]")
    createdAt            DateTime  @default(now())
    updatedAt            DateTime  @updatedAt

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// A knowledge-based recovery factor: used to prove identity when the user wants
// to set a new password without knowing the current one. Answers are hashed
// (normalized to lowercase first), so a database dump does not reveal them.
model SecurityQuestion {
    id         String   @id @default(uuid(7)) @db.Uuid
    userId     String   @db.Uuid
    question   String
    answerHash String
    createdAt  DateTime @default(now())

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
}

// A request to get back into an account from outside it: the last way in, for
// someone who has lost the password and every second factor with it. An
// administrator decides it, because nothing an unauthenticated caller can present
// is proof enough on its own - the recovery questions raise the request, they do
// not grant it.
//
// The ticket is a 256-bit token held only by the requester's browser; the row
// keeps its SHA-256, so a database dump yields nothing that can be redeemed. It
// is spent the moment a password is set through it.
model AccountRecovery {
    id        String @id @default(uuid(7)) @db.Uuid
    userId    String @db.Uuid
    tokenHash String @unique
    // Whether the recovery questions were answered before the request was raised.
    // An unverified request is not refused - an account may have no questions set,
    // which is exactly when this route matters - but the decider is told, because
    // it changes what they should check before approving.
    verified  Boolean @default(false)
    // "pending", "approved", "denied", or "used" once a password has been set.
    status    String  @default("pending")
    // Where the request came from, for the administrator judging it.
    requestIp String?
    decidedById String?   @db.Uuid
    decidedAt   DateTime?
    expiresAt   DateTime
    createdAt   DateTime  @default(now())

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
    @@index([status, createdAt])
}

// A named, reusable set of network rules ("Home", "Office") a user attaches to
// their sign-in and to individual API keys, so the same allowlist does not have
// to be retyped per target. Rules are additive: the effective allowlist is the
// union of every attached group plus the target's own inline rules.
model AccessGroup {
    id                String   @id @default(uuid(7)) @db.Uuid
    ownerId           String   @db.Uuid
    name              String
    description       String?
    // JSON string arrays: IP/CIDR rules, ISO country codes, continent codes.
    allowedCidrs      String   @default("[]")
    allowedCountries  String   @default("[]")
    allowedContinents String   @default("[]")
    createdAt         DateTime @default(now())
    updatedAt         DateTime @updatedAt

    owner   User                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
    users   UserAccessGroup[]
    apiKeys ApiKeyAccessGroup[]

    @@unique([ownerId, name])
    @@index([ownerId])
}

// Access groups applied to a user's own sign-ins. An enforced binding was made
// by an administrator: it counts towards the admin rule set rather than the
// account's own, and only an administrator can detach it.
model UserAccessGroup {
    userId   String  @db.Uuid
    groupId  String  @db.Uuid
    enforced Boolean @default(false)

    user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
    group AccessGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

    @@id([userId, groupId])
    @@index([groupId])
}

// Access groups applied to one API key.
model ApiKeyAccessGroup {
    apiKeyId String @db.Uuid
    groupId  String @db.Uuid

    apiKey ApiKey      @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
    group  AccessGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

    @@id([apiKeyId, groupId])
    @@index([groupId])
}

// A personal access token. The secret is shown once at creation and stored only
// as a SHA-256 hash, so a database dump yields no usable keys. A key can never
// exceed its owner's own permissions - `scopes` narrows, it never grants.
model ApiKey {
    id                String    @id @default(uuid(7)) @db.Uuid
    userId            String    @db.Uuid
    name              String
    // Public, non-secret identifier shown in the UI and carried in the key
    // itself, so a key is recognizable without storing the secret.
    prefix            String    @unique
    keyHash           String    @unique
    // JSON array of permission keys this key may exercise.
    scopes            String    @default("[]")
    allowedCidrs      String    @default("[]")
    allowedCountries  String    @default("[]")
    allowedContinents String    @default("[]")
    expiresAt         DateTime?
    lastUsedAt        DateTime?
    lastUsedIp        String?
    revokedAt         DateTime?
    // Set on a token minted from a project's settings: the key still carries its
    // owner's permissions, but may only act on this project. Null is an ordinary
    // account key, which reaches everything its scopes allow.
    projectId         String?   @db.Uuid
    createdAt         DateTime  @default(now())

    user    User                @relation(fields: [userId], references: [id], onDelete: Cascade)
    project Project?            @relation(fields: [projectId], references: [id], onDelete: Cascade)
    groups  ApiKeyAccessGroup[]

    @@index([userId])
    @@index([projectId])
}

// Polaris-owned state for one better-auth session: whether the sign-in has been
// approved, whether the idle lock has engaged, and where it came from. Kept in a
// separate table because better-auth owns the Session row's columns.
model SessionState {
    sessionId  String    @id @db.Uuid
    userId     String    @db.Uuid
    // approved | pending | denied. Only "approved" may use the dashboard.
    approval   String    @default("approved")
    // Set when inactivity locked the dashboard; cleared by a PIN/password unlock.
    lockedAt   DateTime?
    lastSeenAt DateTime  @default(now())
    // The address the session was last evaluated from; a change re-runs the
    // account's network rules instead of trusting the first decision forever.
    ip         String?
    country    String?
    userAgent  String?
    createdAt  DateTime  @default(now())

    session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
    user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
}

// A named bundle of users. Policies attach to a group so a grant applies to
// everyone in it; group membership is the cheapest way to manage access at scale.
model Group {
    id          String        @id @default(uuid(7)) @db.Uuid
    name        String        @unique
    description String?
    isSystem    Boolean       @default(false)
    createdAt   DateTime      @default(now())
    members     GroupMember[]
}

model GroupMember {
    groupId String @db.Uuid
    userId  String @db.Uuid
    group   Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
    user    User  @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@id([groupId, userId])
    @@index([userId])
}

// A reusable authorization policy: a JSON document of allow/deny statements over
// (action, resource) patterns, evaluated by @polaris/core's engine. Attaching a
// policy to a user, group, or role folds its statements into that principal's
// effective permissions. Deny-by-default; an explicit deny overrides any allow.
model Policy {
    id          String             @id @default(uuid(7)) @db.Uuid
    name        String             @unique
    description String?
    // Stringified PolicyDocument JSON (SQLite-portable); validated on read/write.
    document    String
    isSystem    Boolean            @default(false)
    createdAt   DateTime           @default(now())
    updatedAt   DateTime           @updatedAt
    attachments PolicyAttachment[]
}

// Binds a policy to a principal. principalType is "user" | "group" | "role" and
// principalId is that principal's id; kept generic (no FK) so one table covers
// all three without three near-identical join tables.
model PolicyAttachment {
    id            String @id @default(uuid(7)) @db.Uuid
    policyId      String @db.Uuid
    principalType String
    principalId   String @db.Uuid

    policy Policy @relation(fields: [policyId], references: [id], onDelete: Cascade)

    @@unique([policyId, principalType, principalId])
    @@index([principalType, principalId])
}

// A per-path Drive access-control entry: grants (or denies) a principal a set of
// Drive verbs on a connection subtree. Applies to the path and everything under
// it. This is what lets a connection owner share specific folders with other
// users/groups without handing over the whole connection.
model DriveAcl {
    id            String   @id @default(uuid(7)) @db.Uuid
    connectionId  String   @db.Uuid
    // "" means the whole connection; otherwise the subtree root (normalized).
    path          String   @default("")
    principalType String
    principalId   String   @db.Uuid
    // JSON array of Drive verbs: read, write, rename, delete, copy, download.
    actions       String
    effect        String   @default("allow")
    createdById   String   @db.Uuid
    createdAt     DateTime @default(now())

    connection StorageConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

    @@index([connectionId])
    @@index([principalType, principalId])
}

// A password gate ("Polaris access gate") on a Drive path. Browsing, opening, or
// downloading anything at or under a locked path requires unlocking it with the
// password first; the unlock is remembered in a signed, per-lock session cookie.
// The password is stored with the same slow, salted KDF as share/link passwords.
model AccessLock {
    id           String   @id @default(uuid(7)) @db.Uuid
    connectionId String   @db.Uuid
    path         String
    passwordHash String
    createdById  String   @db.Uuid
    createdAt    DateTime @default(now())

    connection StorageConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

    @@unique([connectionId, path])
    @@index([connectionId])
}

// ---------------------------------------------------------------------------
// Storage
// ---------------------------------------------------------------------------

model StorageConnection {
    id                  String   @id @default(uuid(7)) @db.Uuid
    name                String
    kind                String
    ownerId             String   @db.Uuid
    // Non-secret connection config (host, port, share path) as JSON string.
    config              String
    // Envelope-encrypted credentials (AES-256-GCM). Null for anonymous providers.
    encryptedCredential Bytes?
    credentialNonce     Bytes?
    credentialKeyId     String?
    requiresHostd       Boolean  @default(false)
    status              String   @default("active")
    createdAt           DateTime @default(now())
    updatedAt           DateTime @updatedAt

    owner        User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
    mount        StorageMount?
    nodes        Node[]
    shares       Share[]
    fileRequests FileRequest[]
    uploads      UploadSession[]
    itemMeta     DriveItemMeta[]
    folderSizes  DriveFolderSize[]
    trashItems   TrashItem[]
    acls         DriveAcl[]
    locks        AccessLock[]
    scheduledDeletions ScheduledDeletion[]
    deployVolumes      Volume[]

    @@index([ownerId])
}

// A deletion scheduled for a future time. Polaris has no always-on scheduler, so
// due rows are swept lazily (whenever the connection is next browsed) and by an
// optional cron endpoint for exact timing - the same lazy-evaluation approach the
// rest of the app uses for share/link expiry. `permanent` picks delete-for-good
// over the recycle bin.
model ScheduledDeletion {
    id           String   @id @default(uuid(7)) @db.Uuid
    ownerId      String   @db.Uuid
    connectionId String   @db.Uuid
    path         String
    name         String
    permanent    Boolean  @default(false)
    deleteAt     DateTime
    createdAt    DateTime @default(now())

    connection StorageConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

    @@index([ownerId])
    @@index([connectionId])
    @@index([deleteAt])
}

// A Polaris-managed recycle bin entry. "Move to Trash" relocates the item into a
// hidden trash folder on the same connection and records where it came from, so
// it can be listed, restored to its original path, or permanently deleted. Works
// for any backend; UniFi UNAS keeps its own trash, which can be reused later.
model TrashItem {
    id           String   @id @default(uuid(7)) @db.Uuid
    ownerId      String   @db.Uuid
    connectionId String   @db.Uuid
    name         String
    // Where it lived before deletion, and where it now sits in the trash folder.
    originalPath String
    trashPath    String
    kind         String
    size         BigInt   @default(0)
    deletedAt    DateTime @default(now())

    connection StorageConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

    @@index([ownerId])
    @@index([connectionId])
}

// Per-path presentation metadata for a browsed item (not a mirror of the tree):
// custom icon, hidden flag. Keyed by (connection, path); rows exist only for
// items the user has customized. Cascades away with its connection.
model DriveItemMeta {
    id           String   @id @default(uuid(7)) @db.Uuid
    ownerId      String   @db.Uuid
    connectionId String   @db.Uuid
    path         String
    hidden       Boolean  @default(false)
    favorite     Boolean  @default(false)
    // The Polaris user who uploaded/created this item, when known (drop-point
    // uploads, dashboard uploads, new files/folders, copies). Null for items that
    // predate Polaris or were created out of band. Follows the item on move/rename.
    creatorId    String?  @db.Uuid
    icon         String?
    iconColor    String?
    note         String?
    createdAt    DateTime @default(now())
    updatedAt    DateTime @updatedAt

    connection StorageConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

    @@unique([connectionId, path])
    @@index([ownerId])
}

// Measured size of everything under a folder. This is a derived measurement, not
// a mirror of the tree: walking a remote folder is expensive, so the result is
// kept with the time it was taken and reused until it ages out or Polaris itself
// writes under (or above) the path. `partial` marks a walk that hit its budget,
// making `bytes` a lower bound rather than the exact total.
model DriveFolderSize {
    id           String   @id @default(uuid(7)) @db.Uuid
    connectionId String   @db.Uuid
    path         String
    bytes        BigInt   @default(0)
    files        Int      @default(0)
    folders      Int      @default(0)
    partial      Boolean  @default(false)
    computedAt   DateTime @default(now())

    connection StorageConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

    @@unique([connectionId, path])
}

model DockerConnection {
    id                  String   @id @default(uuid(7)) @db.Uuid
    name                String
    ownerId             String   @db.Uuid
    // socket | ssh | tcp
    transport           String
    // Non-secret transport config (host, port, socket path) as JSON string.
    config              String
    // Envelope-encrypted credentials (pasted SSH key / TLS certs). Null for the
    // socket transport and for SSH using the install-provisioned key.
    encryptedCredential Bytes?
    credentialNonce     Bytes?
    credentialKeyId     String?
    status              String   @default("active")
    createdAt           DateTime @default(now())
    updatedAt           DateTime @updatedAt

    owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

    @@index([ownerId])
}

// A global server registered once (SSH) and consumed by multiple apps: Docker
// over SSH in Containers, and SFTP browsing in Drive.
model Host {
    id                  String   @id @default(uuid(7)) @db.Uuid
    name                String
    ownerId             String   @db.Uuid
    // SSH endpoint.
    address             String
    port                Int      @default(22)
    username            String
    // password | key
    authMethod          String
    // Whether the Polaris login on this machine may act as root through
    // password-less sudo. Granted only when the enrollment command was run with
    // --root, and recorded from what the machine reported it ended up with rather
    // than from what was asked for. It decides whether a root shell is offered and
    // whether files can be browsed as root, so a wrong value here is either a
    // capability that silently fails or one that is silently held.
    sudo                Boolean  @default(false)
    // home-nat | home-cgnat | vps | cloud | unknown - where the server lives,
    // which decides how a domain can be pointed at it (see @polaris/core).
    environment         String   @default("unknown")
    // Wildcard domain pointed at THIS server ("apps.example.com" covering
    // *.apps.example.com), so its services get real domains served by its own
    // edge. Null falls back to the IP-derived free subdomain.
    wildcardDomain      String?
    // Server public key (base64) pinned on the trust-on-add test connect.
    hostKey             String?
    // Envelope-encrypted credentials (password, or private key + passphrase).
    encryptedCredential Bytes?
    credentialNonce     Bytes?
    credentialKeyId     String?
    status              String   @default("active")
    createdAt           DateTime @default(now())
    updatedAt           DateTime @updatedAt

    owner         User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
    deployTargets DeployTarget[]
    enrollments   Enrollment[]
    runnerPools   RunnerPool[]

    @@index([ownerId])
}

// An offer to let one machine join Polaris, redeemed by a script run on it.
//
// The alternative to this row is asking an operator to type an SSH password into
// a dashboard, which is the thing worth avoiding: here Polaris mints the key pair
// up front, keeps the private half encrypted (`encryptedKey`, same envelope as
// every other stored credential), and the script installs only `publicKey`. No
// secret travels to the machine and none comes back, so a script intercepted in
// transit yields an attacker nothing but a token that expires in minutes and
// works exactly once.
//
// `hostKeys` is what the machine reported about itself while the script was still
// running as root. Polaris pins against that list on its first connect, which
// closes the window trust-on-add leaves open.
model Enrollment {
    id           String    @id @default(uuid(7)) @db.Uuid
    // server | runner - what the machine becomes once it claims this.
    kind         String    @default("server")
    tokenHash    String    @unique
    createdById  String    @db.Uuid
    // Proposed name; the machine's real hostname replaces it when it reports one.
    name         String
    // Carried onto the Host, so the operator answers "where does it live" once.
    environment  String    @default("unknown")
    // The login the script provisions and Polaris authenticates as.
    username     String
    // The authorized_keys line installed on the machine.
    publicKey    String
    encryptedKey Bytes
    keyNonce     Bytes
    keyKeyId     String
    // Newline-separated public host keys the machine reported, pinned on connect.
    hostKeys     String    @default("")
    // Where Polaris reached it: the claim's source address, not one the script chose.
    address      String?
    port         Int       @default(22)
    claimedAt    DateTime?
    // The Host this produced. Null while pending, and after a failed claim.
    hostId       String?   @db.Uuid
    // Why the claim did not finish, shown next to the command so the operator can
    // fix the machine rather than guess.
    error        String?
    expiresAt    DateTime
    createdAt    DateTime  @default(now())

    createdBy User  @relation(fields: [createdById], references: [id], onDelete: Cascade)
    host      Host? @relation(fields: [hostId], references: [id], onDelete: SetNull)

    @@index([createdById])
    @@index([expiresAt])
}

// A standing offer of compute to GitHub: keep `maxConcurrent` self-hosted runners
// alive on one registered server, so workflows selecting these labels have
// somewhere to land.
//
// The pool is configuration, not state. Nothing here records a running process,
// because a process on somebody else's machine is not something a row can be the
// truth about - RunnerJob tracks the ones Polaris started, and the machine and
// GitHub are both re-read on every reconcile pass rather than believed.
//
// There is no "keep this runner around" column. Every runner a pool starts is
// registered just-in-time and de-registers itself after one job: a runner that
// outlives its job keeps a credential on disk and carries one workflow's leftovers
// into the next, which is the failure this whole design exists to avoid.
model RunnerPool {
    id            String   @id @default(uuid(7)) @db.Uuid
    ownerId       String   @db.Uuid
    // The registered server the runners run on. Null is the box Polaris itself
    // runs on, which has no Host row and is reached through polaris-hostd.
    hostId        String?  @db.Uuid
    name          String
    // repo | repos | account | org | users | group - what the pool was asked to
    // serve. Only `repo` and `org` are single registrations; the rest resolve to a
    // set of them (see RunnerPoolTarget).
    scope         String
    // The rest of the scope, as stringified JSON whose shape depends on `scope`:
    // the repositories picked, the account named, the Polaris people or group
    // chosen. Validated by runnerScopeSchema in @polaris/core on the way in and
    // again on the way out, since a column is not a type.
    scopeConfig   String   @default("{}")
    // Labels a workflow selects with `runs-on`, as a stringified JSON array.
    labels        String
    // How many runners are kept waiting at once. Each is a real process on the
    // machine, so it is bounded (see MAX_RUNNER_CONCURRENCY in @polaris/core).
    maxConcurrent Int      @default(1)
    // What one repository may spend inside this pool. Null is no limit of that
    // kind; the pool's own ceiling is maxConcurrent above. These exist so one busy
    // repository cannot be the only one a shared machine ever serves.
    perTargetConcurrent Int?
    minutesBudget       Int?
    // day | month - the calendar window minutesBudget is measured over.
    minutesWindow       String @default("month")
    jobsPerDay          Int?
    // pause | warn - whether a repository that has spent its budget stops being
    // served, or keeps being served with the overage reported on the pool.
    onExhausted         String @default("pause")
    // When the scope was last turned into targets. A scope that names an account
    // or a group is a question for GitHub and the user directory, and asking it on
    // every pass would spend the connection's rate limit on an answer that changes
    // about as often as somebody creates a repository.
    targetsResolvedAt   DateTime?
    // container | workspace - whether a job is thrown away with a container, or
    // only given an empty directory on the machine itself.
    isolation     String
    enabled       Boolean  @default(true)
    // Why the pool last failed to keep its runners up, shown on the pool rather
    // than left in a log the operator has no reason to open.
    error         String?
    createdAt     DateTime @default(now())
    updatedAt     DateTime @updatedAt

    owner   User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
    host    Host?              @relation(fields: [hostId], references: [id], onDelete: Cascade)
    jobs    RunnerJob[]
    targets RunnerPoolTarget[]

    @@index([ownerId])
    @@index([hostId])
}

// One place a pool registers runners: a repository, or an organization as a whole.
//
// This is derived state, not configuration - it is what the pool's scope resolved
// to the last time it was read, and an account that gains a repository gains a row
// here without anybody editing the pool. It is stored rather than recomputed
// because the columns below are per target and have to survive a pass: what GitHub
// has queued for it, when it last got a runner, and why it is not being served.
model RunnerPoolTarget {
    id           String   @id @default(uuid(7)) @db.Uuid
    poolId       String   @db.Uuid
    // "owner/repo", or "owner" for an organization registration. The identity of
    // the target, and what the placement logic in @polaris/core keys on.
    key          String
    // repo | org, as GitHub's runner endpoints divide them.
    kind         String
    owner        String
    // Null for an organization registration.
    repo         String?
    // Jobs GitHub has waiting that this target could take, as last observed - from
    // a workflow_job webhook where one arrives, and from a poll where none does.
    queued       Int      @default(0)
    // When that count was last refreshed, so a stale one can be told from a zero.
    queuedAt     DateTime?
    // When this pool last started a runner here. Oldest first is what stops one
    // repository from holding every slot on a shared machine.
    lastServedAt DateTime?
    // Why this target is not being served right now (a spent budget), or null.
    blocked      String?
    createdAt    DateTime @default(now())
    updatedAt    DateTime @updatedAt

    pool RunnerPool @relation(fields: [poolId], references: [id], onDelete: Cascade)

    @@unique([poolId, key])
    @@index([poolId])
}

// A Polaris account's GitHub identity, established by the person themselves
// through GitHub's own authorization screen - never typed in on their behalf.
//
// It exists so a pool can serve "these people's repositories" without an
// administrator being able to point somebody else's machine at a stranger's code
// by guessing a login. The numeric id is the identity that matters: GitHub logins
// can be renamed and re-registered by somebody else, so the login here is a label.
model GithubIdentity {
    id        String   @id @default(uuid(7)) @db.Uuid
    userId    String   @unique @db.Uuid
    // GitHub's own id for the account. Unique, so one GitHub account cannot be
    // claimed by two Polaris users.
    githubId  Int      @unique
    login     String
    avatarUrl String?
    linkedAt  DateTime @default(now())

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// One ephemeral runner: registered, started, given a single job, gone.
//
// It is kept after it finishes because it is the only account of what ran on the
// machine and how it ended - the runner itself de-registers, so GitHub stops being
// able to answer that question moments after the job does.
model RunnerJob {
    id             String    @id @default(uuid(7)) @db.Uuid
    poolId         String    @db.Uuid
    // The name registered with GitHub, unique per target.
    name           String
    // GitHub's id for the runner row, so one that never started can still be
    // removed. Null between creating the row and minting the registration.
    githubRunnerId Int?
    // Where it was registered. Denormalized rather than a link to the target row,
    // so a finished job still says what it ran for after the pool stopped serving
    // it - and so usage can be counted per repository over a window without
    // depending on a row that resolution may have removed since.
    targetOwner    String    @default("")
    targetRepo     String?
    // starting | idle | busy | finished | failed
    state          String    @default("starting")
    // When it was first seen taking a job, which is where its consumption starts
    // being counted. A runner that waited an hour and worked for two minutes spent
    // two minutes, and billing it for the hour it sat idle would be a lie.
    busyAt         DateTime?
    // What this one actually got, which can differ from the pool's setting if the
    // machine changed under it.
    isolation      String
    // How to find the runner again on the machine: the container name, or the pid
    // of the detached process. Advisory - liveness is probed, never assumed.
    handle         String?
    error          String?
    startedAt      DateTime  @default(now())
    finishedAt     DateTime?

    pool RunnerPool @relation(fields: [poolId], references: [id], onDelete: Cascade)

    @@index([poolId, state])
    @@index([startedAt])
    // What a repository has spent in the current window is read on every pass, per
    // pool and per target, so the window is part of the index rather than a scan
    // over everything the pool has ever run.
    @@index([poolId, targetOwner, startedAt])
}

model StorageMount {
    id            String    @id @default(uuid(7)) @db.Uuid
    connectionId  String    @unique @db.Uuid
    mountPath     String
    state         String    @default("pending")
    error         String?
    lastCheckedAt DateTime?
    createdAt     DateTime  @default(now())

    connection StorageConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
}

model Node {
    id           String   @id @default(uuid(7)) @db.Uuid
    connectionId String   @db.Uuid
    path         String
    kind         String
    size         BigInt   @default(0)
    mime         String?
    etag         String?
    ownerId      String?  @db.Uuid
    createdAt    DateTime @default(now())
    updatedAt    DateTime @updatedAt

    connection  StorageConnection       @relation(fields: [connectionId], references: [id], onDelete: Cascade)
    shares      Share[]
    submissions FileRequestSubmission[]

    @@unique([connectionId, path])
    @@index([connectionId])
}

// ---------------------------------------------------------------------------
// Sharing (files out)
// ---------------------------------------------------------------------------

model Share {
    id            String    @id @default(uuid(7)) @db.Uuid
    connectionId  String    @db.Uuid
    // Snapshot of the shared path; a Node row backs it when a stable referent is
    // needed (the remote file may be listed live and can vanish out of band).
    path          String
    nodeId        String?   @db.Uuid
    ownerId       String    @db.Uuid
    kind          String    @default("public")
    // SHA-256 of the share token; lookups are by hash so a DB dump yields no links.
    tokenHash     String    @unique
    // The token, envelope-encrypted under the master key, so the owner can reveal
    // the link again after creation. A DB dump alone still yields no working links.
    encryptedToken Bytes?
    tokenNonce     Bytes?
    tokenKeyId     String?
    // argon2 hash of the optional link password.
    passwordHash  String?
    maxDownloads  Int?
    downloadCount Int       @default(0)
    expiresAt     DateTime?
    // Recipient write permissions, each independent so a link can act as a drop box
    // and/or grant specific edits without the others (e.g. rename but not delete).
    // All default false so a share is read-only until the owner opts in.
    allowUpload   Boolean   @default(false)
    allowRename   Boolean   @default(false)
    allowDelete   Boolean   @default(false)
    allowCreateFolder Boolean @default(false)
    // Whether recipients may download the bytes / preview inline in the browser.
    allowDownload Boolean   @default(true)
    allowPreview  Boolean   @default(true)
    // JSON string array of IP/CIDR rules; empty means anyone with the link.
    allowedCidrs  String    @default("[]")
    // JSON string arrays of ISO country codes / continent codes; empty means no
    // geo restriction. Enforced server-side per access after resolving the IP.
    allowedCountries  String @default("[]")
    allowedContinents String @default("[]")
    createdAt     DateTime  @default(now())
    revokedAt     DateTime?

    connection StorageConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
    node       Node?             @relation(fields: [nodeId], references: [id], onDelete: SetNull)
    owner      User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
    invites    ShareInvite[]
    accessLogs ShareAccessLog[]

    @@index([ownerId])
    @@index([connectionId])
}

model ShareInvite {
    id         String @id @default(uuid(7)) @db.Uuid
    shareId    String @db.Uuid
    userId     String @db.Uuid
    permission String @default("download")

    share Share @relation(fields: [shareId], references: [id], onDelete: Cascade)
    user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([shareId, userId])
    @@index([userId])
}

model ShareAccessLog {
    id            String   @id @default(uuid(7)) @db.Uuid
    shareId       String   @db.Uuid
    at            DateTime @default(now())
    // Client IP is stored hashed for privacy while still supporting abuse review.
    ipHash        String?
    // Raw client IP, shown to the share owner in the access log (their own link).
    ip            String?
    userAgentHash String?
    action        String
    reason        String?

    share Share @relation(fields: [shareId], references: [id], onDelete: Cascade)

    @@index([shareId])
}

// ---------------------------------------------------------------------------
// File requests (files in)
// ---------------------------------------------------------------------------

model FileRequest {
    id                      String    @id @default(uuid(7)) @db.Uuid
    ownerId                 String    @db.Uuid
    tokenHash               String    @unique
    title                   String
    instructions            String?
    destinationConnectionId String    @db.Uuid
    destinationPath         String
    requireLogin            Boolean   @default(false)
    // argon2 hash of an optional access PIN/password gating the upload page.
    passwordHash            String?
    maxSizeBytes            BigInt
    // Optional per-file minimum size; null means no minimum.
    minSizeBytes            BigInt?
    maxFiles                Int?
    // JSON string arrays validated by @polaris/core.
    allowedExtensions       String    @default("[]")
    // Blocklist of extensions; takes precedence over allowedExtensions.
    deniedExtensions        String    @default("[]")
    allowedMimeTypes        String    @default("[]")
    allowedCidrs            String    @default("[]")
    // JSON string array of allowed uploader identities (email or username,
    // lowercased, no leading "@"). Non-empty implies sign-in is required.
    allowedUsers            String    @default("[]")
    // JSON string arrays of ISO country codes / continent codes; empty means no
    // geo restriction. Enforced server-side per upload after resolving the IP.
    allowedCountries        String    @default("[]")
    allowedContinents       String    @default("[]")
    // When set, the drop point only starts accepting uploads at this time.
    startsAt                DateTime?
    // Whether an uploader may delete files they submitted, and (optionally) only
    // within this many seconds of the upload. Null window means no time limit.
    allowUploaderDelete     Boolean   @default(false)
    uploaderDeleteWindowSeconds Int?
    expiresAt               DateTime?
    createdAt               DateTime  @default(now())
    revokedAt               DateTime?

    owner       User                    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
    destination StorageConnection       @relation(fields: [destinationConnectionId], references: [id], onDelete: Cascade)
    submissions FileRequestSubmission[]
    visits      FileRequestVisit[]

    @@index([ownerId])
}

// One visitor session on a public drop-point page. Grouped by an opaque cookie
// key so heartbeats and uploads from the same browser fold into one row. The raw
// IP is retained for the owner's Visitors view; ipHash mirrors the log format.
model FileRequestVisit {
    id          String   @id @default(uuid(7)) @db.Uuid
    requestId   String   @db.Uuid
    visitorKey  String
    ip          String?
    ipHash      String?
    userId      String?  @db.Uuid
    userAgent   String?
    uploadCount Int      @default(0)
    firstSeenAt DateTime @default(now())
    lastSeenAt  DateTime @default(now())

    request FileRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
    user    User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

    @@unique([requestId, visitorKey])
    @@index([requestId])
}

// A saved, reusable set of drop-point guardrails owned by a user. `config` is a
// JSON blob of the create-form fields (no destination/title/schedule).
model DropPointTemplate {
    id        String   @id @default(uuid(7)) @db.Uuid
    ownerId   String   @db.Uuid
    name      String
    config    String
    createdAt DateTime @default(now())

    owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

    @@index([ownerId])
}

// Fixed-window rate-limit counters (e.g. password-guess throttling per link+IP).
// A lightweight DB-backed limiter; a distributed deployment can swap in Redis.
model RateLimitCounter {
    id          String   @id @default(uuid(7)) @db.Uuid
    key         String   @unique
    count       Int      @default(0)
    windowStart DateTime @default(now())

    @@index([windowStart])
}

model FileRequestSubmission {
    id                String   @id @default(uuid(7)) @db.Uuid
    requestId         String   @db.Uuid
    submittedByUserId String?  @db.Uuid
    ipHash            String?
    fileName          String
    size              BigInt
    storedNodeId      String?  @db.Uuid
    storedPath        String
    status            String   @default("stored")
    at                DateTime @default(now())

    request     FileRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
    submittedBy User?       @relation(fields: [submittedByUserId], references: [id], onDelete: SetNull)
    storedNode  Node?       @relation(fields: [storedNodeId], references: [id], onDelete: SetNull)

    @@index([requestId])
}

// ---------------------------------------------------------------------------
// Uploads (resumable, both directions)
// ---------------------------------------------------------------------------

model UploadSession {
    id            String   @id @default(uuid(7)) @db.Uuid
    kind          String
    ownerId       String?  @db.Uuid
    connectionId  String   @db.Uuid
    targetPath    String
    totalSize     BigInt
    receivedBytes BigInt   @default(0)
    chunkSize     Int
    // JSON record of received parts (offset + etag) for tus-style resume.
    partsJson     String   @default("[]")
    mime          String?
    fileRequestId String?  @db.Uuid
    status        String   @default("open")
    expiresAt     DateTime
    createdAt     DateTime @default(now())

    owner      User?             @relation(fields: [ownerId], references: [id], onDelete: SetNull)
    connection StorageConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

    @@index([connectionId])
    @@index([status])
}

// ---------------------------------------------------------------------------
// Operations
// ---------------------------------------------------------------------------

model AuditLog {
    id         String   @id @default(uuid(7)) @db.Uuid
    actorId    String?  @db.Uuid
    action     String
    targetType String?
    targetId   String?  @db.Uuid
    metadata   String?
    ipHash     String?
    // The session the action arrived on, so a user can read their own history
    // one device at a time. Deliberately not a foreign key: ending a session
    // must not erase what was done from it.
    sessionId  String?  @db.Uuid
    at         DateTime @default(now())

    @@index([actorId])
    @@index([action])
    @@index([sessionId])
}

model Setting {
    id     String  @id @default(uuid(7)) @db.Uuid
    key    String  @unique
    value  String
    scope  String  @default("global")
    userId String? @db.Uuid

    @@index([scope])
}

// Cache of resolved IP geolocation, so a country/continent allowlist does not hit
// an external provider on every access and a location is remembered for reuse.
// Keyed by IP (a natural key, not a surrogate uuid); refreshed lazily on age-out.
model GeoIpCache {
    ip          String   @id
    countryCode String?
    country     String?
    continent   String?
    source      String?
    updatedAt   DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Integrations (marketplace) and notifications
// ---------------------------------------------------------------------------

// An installed marketplace integration, one row per provider (instance-wide).
// The catalog of available integrations lives in code; this table records which
// have been enabled and their config. Secret material (an API key) is envelope-
// encrypted with the same AES-256-GCM master key as storage credentials, so a DB
// dump yields no usable keys.
model Integration {
    id              String   @id @default(uuid(7)) @db.Uuid
    // Catalog slug, e.g. "virustotal". One install per provider.
    provider        String   @unique
    enabled         Boolean  @default(false)
    // Non-secret config as a stringified JSON object (SQLite-portable).
    config          String   @default("{}")
    // Envelope-encrypted secret (API key); null until configured.
    encryptedSecret Bytes?
    secretNonce     Bytes?
    secretKeyId     String?
    installedById   String?  @db.Uuid
    createdAt       DateTime @default(now())
    updatedAt       DateTime @updatedAt
}

// An in-app notification for one user. Written by server-side events (e.g. a
// drop-point upload scanned by an integration) and surfaced by the bell and the
// notifications page. Cascades away with the user.
model Notification {
    id             String    @id @default(uuid(7)) @db.Uuid
    userId         String    @db.Uuid
    // Category slug driving the icon, e.g. "scan.malicious", "scan.clean".
    type           String
    title          String
    body           String?
    // Optional in-app deep link (e.g. "/drive/drop-points").
    href           String?
    // Styling severity: info | success | warning | danger.
    level          String    @default("info")
    // Who else received the same alert: you | admins | group | everyone. The
    // group name goes in audienceLabel; individual recipients are never listed.
    audience       String    @default("you")
    audienceLabel  String?
    // True when the alert is waiting on the user (approve, review, fix).
    actionRequired Boolean   @default(false)
    // Stringified JSON metadata (connectionId, path, submissionId, ...).
    metadata       String?
    readAt         DateTime?
    createdAt      DateTime  @default(now())

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId, readAt])
    @@index([userId, createdAt])
}

// Somewhere an alert can be sent besides the bell and the account's mailbox: a
// chat webhook (Discord, Slack, or an endpoint of your own) or a phone number.
//
// The target is envelope-encrypted like every other credential in the schema.
// For a webhook that is not caution but necessity - the URL *is* the credential,
// and anyone holding it can post as you - and a phone number gets the same
// treatment so one column has one meaning. targetHint is the masked form the UI
// renders, so listing destinations never needs the master key.
model NotificationDestination {
    id              String    @id @default(uuid(7)) @db.Uuid
    userId          String    @db.Uuid
    // webhook | sms
    kind            String
    name            String
    // Body shape for a webhook: discord | slack | generic. Null for sms.
    format          String?
    // Masked target for display, e.g. "discord.com/api/webhooks/..." or "+34***22".
    targetHint      String
    encryptedTarget Bytes
    targetNonce     Bytes
    targetKeyId     String?
    enabled         Boolean   @default(true)
    // ok | error | untested - the result of the last send or test.
    status          String    @default("untested")
    lastError       String?
    lastUsedAt      DateTime?
    createdAt       DateTime  @default(now())
    updatedAt       DateTime  @updatedAt

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
}

// One attempt to get one event to one place. Kept so the notifications page can
// answer "was I actually told?" - a muted rule, a webhook that 404s and a text
// that never sent all look identical from the bell otherwise.
model NotificationDelivery {
    id              String   @id @default(uuid(7)) @db.Uuid
    userId          String   @db.Uuid
    // Catalogue event id, e.g. "deploy.failed".
    event           String
    // inapp | email | webhook | sms
    kind            String
    // Set for webhook/sms; null for the built-in kinds. Soft pointer, so the
    // record survives the destination being deleted.
    destinationId   String?  @db.Uuid
    // Masked destination as it was at the time, for a row that still reads
    // sensibly after the destination is gone.
    destinationHint String?
    // sent | failed | skipped
    status          String
    // Why it failed, or why it was skipped.
    detail          String?
    createdAt       DateTime @default(now())

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId, createdAt])
}

// The result of an integration scanning a stored file (e.g. VirusTotal on a
// drop-point upload). Kept for the owner's audit trail and to avoid re-scanning
// a known hash. Not FK-bound to the submission so a purged submission does not
// erase the security record.
model FileScan {
    id           String   @id @default(uuid(7)) @db.Uuid
    provider     String   @default("virustotal")
    submissionId String?  @db.Uuid
    connectionId String?  @db.Uuid
    path         String?
    sha256       String?
    // pending | clean | suspicious | malicious | unknown | error | skipped
    verdict      String   @default("pending")
    malicious    Int      @default(0)
    suspicious   Int      @default(0)
    // Provider report permalink, when available.
    permalink    String?
    // Enforcement taken on a detection: none | blocked | quarantined | notified
    action       String   @default("none")
    detail       String?
    createdAt    DateTime @default(now())
    updatedAt    DateTime @updatedAt

    @@index([submissionId])
    @@index([sha256])
}

// An installed marketplace app. The catalog of apps lives in code
// (lib/apps/catalog.ts); this table records each install: which manifest, the
// server it runs on, and the Deploy Application backing a compose-template
// install. Following the Integration precedent, owner/target/application are
// stored as bare uuids (no FK), so installs never couple the shared User /
// DeployTarget / Application models; lifecycle cleanup is done in app code.
// Secret material is envelope-encrypted with the same AES-256-GCM master key as
// storage credentials and integrations.
model InstalledApp {
    id              String   @id @default(uuid(7)) @db.Uuid
    // Catalog manifest id, e.g. "minecraft". Not unique - several instances of
    // the same app may be installed; `singleton` apps are enforced in code.
    catalogId       String
    // Owner who installed it.
    ownerId         String   @db.Uuid
    // Human instance name, e.g. "Survival server".
    name            String
    // DeployTarget the app runs on; null for `builtin` apps with no container.
    targetId        String?  @db.Uuid
    // The Deploy Application backing a `compose-template` install; null until the
    // stack is created, or for non-container apps.
    applicationId   String?  @db.Uuid
    // Non-secret config as a stringified JSON object (SQLite-portable).
    config          String   @default("{}")
    // Envelope-encrypted secret (e.g. an app token); null until configured.
    encryptedSecret Bytes?
    secretNonce     Bytes?
    secretKeyId     String?
    // installing | running | stopped | failed | removed
    status          String   @default("installing")
    installedById   String?  @db.Uuid
    createdAt       DateTime @default(now())
    updatedAt       DateTime @updatedAt

    @@index([ownerId])
    @@index([catalogId])
    @@index([targetId])
    @@index([applicationId])
}

// ---------------------------------------------------------------------------
// Messaging (unified inbox across WhatsApp / Telegram / Discord / Slack)
// ---------------------------------------------------------------------------

// A connected account on a messaging platform (a Telegram bot, a WhatsApp number
// via a chosen provider, a Discord/Slack app). The live adapter runs in the
// messaging bridge; this row is the control-plane record. Credentials are
// envelope-encrypted with the same master key as integrations. owner/assignee/
// assistant are bare uuids (no FK), per the InstalledApp precedent.
model Channel {
    id              String   @id @default(uuid(7)) @db.Uuid
    ownerId         String   @db.Uuid
    // telegram | whatsapp | discord | slack
    platform        String
    // Provider backend within a platform, e.g. WhatsApp: whatsapp-web | whatsapp-cloud.
    provider        String?
    // Human label, e.g. "Support bot".
    name            String
    // Platform-side identity once connected (bot username, phone number, ...).
    externalId      String?
    // disconnected | connecting | connected | error
    status          String   @default("disconnected")
    // Non-secret config as stringified JSON (capability snapshot, webhook ids, ...).
    config          String   @default("{}")
    // Envelope-encrypted credential (bot token / session); null until configured.
    encryptedSecret Bytes?
    secretNonce     Bytes?
    secretKeyId     String?
    createdAt       DateTime @default(now())
    updatedAt       DateTime @updatedAt

    conversations Conversation[]

    @@index([ownerId])
    @@index([platform])
}

// A conversation (thread) on a channel with one contact. Assignable to a human
// agent (assigneeId) or handled by an AI assistant (assistantId, an InstalledApp).
model Conversation {
    id            String    @id @default(uuid(7)) @db.Uuid
    channelId     String    @db.Uuid
    // Platform-side chat/peer id, unique within the channel.
    peerId        String
    // Contact display name / handle.
    peerName      String?
    // open | closed | pending
    status        String    @default("open")
    assigneeId    String?   @db.Uuid
    assistantId   String?   @db.Uuid
    lastMessageAt DateTime?
    unread        Int       @default(0)
    createdAt     DateTime  @default(now())
    updatedAt     DateTime  @updatedAt

    channel  Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
    messages Message[]

    @@unique([channelId, peerId])
    @@index([channelId, status])
    @@index([assigneeId])
}

// A single normalized message in a conversation.
model Message {
    id             String   @id @default(uuid(7)) @db.Uuid
    conversationId String   @db.Uuid
    // inbound | outbound
    direction      String
    // Platform-side message id, for acks and dedup.
    externalId     String?
    // text | image | file | audio | interactive | system
    kind           String   @default("text")
    body           String?
    // Stringified JSON: media ref, interactive prompt/options, poll results, ...
    payload        String?
    // Outbound delivery ack: sent | delivered | read | failed.
    ack            String?
    // Who sent an outbound message: a User id, or null for inbound / AI-sent.
    senderId       String?  @db.Uuid
    createdAt      DateTime @default(now())

    conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

    @@index([conversationId, createdAt])
    @@index([externalId])
}

// A saved contact for starting outbound conversations from the Inbox, per owner.
// A contact is a person, independent of platform. Their messaging handles live in
// ContactIdentity, so the same person can be reached on WhatsApp, Telegram, etc.
// under one entry. owner is a bare uuid (no FK).
model Contact {
    id        String   @id @default(uuid(7)) @db.Uuid
    ownerId   String   @db.Uuid
    name      String
    note      String?
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    identities ContactIdentity[]

    @@index([ownerId])
}

// One messaging handle of a contact on a single platform (a WhatsApp number, a
// Telegram chat id, ...). A given handle belongs to at most one contact per owner.
model ContactIdentity {
    id        String   @id @default(uuid(7)) @db.Uuid
    ownerId   String   @db.Uuid
    contactId String   @db.Uuid
    platform  String
    peerId    String
    createdAt DateTime @default(now())

    contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

    @@unique([ownerId, platform, peerId])
    @@index([contactId])
    @@index([ownerId])
}

// ---------------------------------------------------------------------------
// Deploy (Railway-style app/database orchestration)
// ---------------------------------------------------------------------------

// The "where it runs" abstraction: the local host (via polaris-hostd) or a
// remote SSH Host (EC2/VPS). Holds the per-server runtime engine and the shared
// proxy network deployed services join. A local target has a null hostId.
model DeployTarget {
    id              String   @id @default(uuid(7)) @db.Uuid
    ownerId         String   @db.Uuid
    name            String
    // local | host
    kind            String   @default("local")
    // Null for the local hostd target; otherwise the SSH Host it runs on.
    hostId          String?  @db.Uuid
    // compose | swarm
    runtime         String   @default("compose")
    // Shared user-defined network deployed services join for name-based DNS.
    proxyNetwork    String   @default("polaris-proxy")
    // Hash of the last applied runtime/proxy config, for idempotency and drift.
    lastAppliedHash String?
    status          String   @default("active")
    createdAt       DateTime @default(now())
    updatedAt       DateTime @updatedAt

    owner        User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
    host         Host?             @relation(fields: [hostId], references: [id], onDelete: Cascade)
    applications Application[]
    databases    ManagedDatabase[]
    deployments  Deployment[]
    volumes      Volume[]

    @@unique([ownerId, name])
    @@index([ownerId])
    @@index([hostId])
}

model Project {
    id          String   @id @default(uuid(7)) @db.Uuid
    ownerId     String   @db.Uuid
    name        String
    slug        String
    description String?
    // private | internal. A private project is the owner's and whoever was added
    // to it; an internal one is readable by anyone on the instance holding
    // deploy.read, which is what a home lab with one household usually wants.
    visibility  String   @default("private")
    // Project-level behaviour toggles as a JSON object (see ProjectFlags in
    // @polaris/core). One column rather than a table: they are read together on
    // every project load and never addressed one at a time.
    flags       String   @default("{}")
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    owner        User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
    environments Environment[]
    members      ProjectMember[]
    webhooks     ProjectWebhook[]
    tokens       ApiKey[]

    @@unique([ownerId, slug])
    @@index([ownerId])
}

// Somebody other than the owner who may reach a project. The owner is never a
// row here - ownership is on Project - so removing every member can never lock
// the project away from the person who made it.
model ProjectMember {
    id        String   @id @default(uuid(7)) @db.Uuid
    projectId String   @db.Uuid
    userId    String   @db.Uuid
    // viewer (read) | developer (deploy and configure services) | admin (also
    // project settings and destructive changes).
    role      String   @default("viewer")
    invitedBy String?  @db.Uuid
    createdAt DateTime @default(now())

    project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
    user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([projectId, userId])
    @@index([userId])
}

// Where a project reports its deploys, besides the bell. Project-scoped rather
// than user-scoped (unlike NotificationDestination) because it describes the
// project's own integrations, and survives whoever added it leaving. The URL is
// the credential, so it is envelope-encrypted like every other secret here and
// only the mask is ever read back.
model ProjectWebhook {
    id           String    @id @default(uuid(7)) @db.Uuid
    projectId    String    @db.Uuid
    name         String
    // discord | slack | generic - the body shape posted.
    format       String    @default("generic")
    // Masked URL for display, e.g. "discord.com/api/webhooks/...".
    targetHint   String
    encryptedUrl Bytes
    urlNonce     Bytes
    urlKeyId     String?
    // JSON string array of event ids this endpoint wants, e.g.
    // ["deploy.succeeded","deploy.failed"]. Empty = every deploy event.
    events       String    @default("[]")
    enabled      Boolean   @default(true)
    // ok | error | untested - the result of the last send or test.
    status       String    @default("untested")
    lastError    String?
    lastUsedAt   DateTime?
    createdAt    DateTime  @default(now())
    updatedAt    DateTime  @updatedAt

    project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

    @@index([projectId])
}

// A structural change parked for review instead of applied, Railway-style: it is
// recorded here, drawn on the canvas as pending, and only takes effect when the
// environment's changeset is deployed. Only the destructive changes stage -
// removing a service or a volume - because those are the ones a misclick cannot
// take back; everything else still applies as it always did.
model StagedChange {
    id            String   @id @default(uuid(7)) @db.Uuid
    environmentId String   @db.Uuid
    // service.delete | database.delete | volume.delete
    kind          String
    // application | database | volume
    targetType    String
    targetId      String   @db.Uuid
    // The name as it read when the change was staged, so the changeset still
    // describes itself once the target is gone.
    targetName    String
    // Change-specific detail as JSON (e.g. { "wipe": true } on a volume).
    payload       String   @default("{}")
    createdById   String?  @db.Uuid
    createdAt     DateTime @default(now())

    environment Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)

    @@unique([targetType, targetId, kind])
    @@index([environmentId])
}

// A private container-registry login, owner-scoped, one per registry host. The
// password is envelope-encrypted at rest; deploys `docker login` before pulling a
// private image whose registry matches.
model RegistryCredential {
    id                String   @id @default(uuid(7)) @db.Uuid
    ownerId           String   @db.Uuid
    // Registry host, e.g. "ghcr.io" or "docker.io" (Docker Hub).
    registry          String
    username          String
    encryptedPassword Bytes
    passwordNonce     Bytes
    passwordKeyId     String
    createdAt         DateTime @default(now())
    updatedAt         DateTime @updatedAt

    @@unique([ownerId, registry])
    @@index([ownerId])
}

model Environment {
    id        String   @id @default(uuid(7)) @db.Uuid
    projectId String   @db.Uuid
    name      String
    slug      String
    isDefault Boolean  @default(false)
    // Canvas layout as stringified JSON: { pos: {serviceId:{x,y}}, links: [{source,target}] }.
    layout    String   @default("{}")
    createdAt DateTime @default(now())

    project       Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
    applications  Application[]
    databases     ManagedDatabase[]
    stagedChanges StagedChange[]

    @@unique([projectId, slug])
    @@index([projectId])
}

model Application {
    id                  String    @id @default(uuid(7)) @db.Uuid
    environmentId       String    @db.Uuid
    targetId            String    @db.Uuid
    name                String
    slug                String
    // image | git | dockerfile | nixpacks | buildpacks | static | compose
    sourceType          String
    // JSON: repoUrl, branch, imageRef, dockerfilePath, composeYaml, ...
    sourceConfig        String    @default("{}")
    // JSON: build args, target stage, env-file refs, ...
    buildConfig         String    @default("{}")
    // JSON: healthcheck path/interval/retries (null = none).
    healthcheck         String?
    // running | stopped
    desiredState        String    @default("running")
    replicas            Int       @default(1)
    // Soft pointer to the latest Deployment (no FK, to avoid a relation cycle).
    currentDeploymentId String?   @db.Uuid
    // Auto-deploy on git push (Vercel-style): redeploy when a matching commit lands.
    autoDeploy          Boolean   @default(false)
    // Branch that triggers auto-deploy (falls back to the source branch).
    deployBranch        String?
    // Only auto-deploy when the head commit message matches this (substring, or
    // "regex:<pattern>"); empty = any commit. e.g. "build:".
    commitFilter        String?
    // Last git SHA deployed, for the polling fallback and change detection.
    lastDeployedSha     String?
    // Keep previous deployments running (Railway-style multi-version). Off by
    // default: a new deploy replaces the old container.
    keepReleases        Boolean   @default(false)
    createdAt           DateTime  @default(now())
    updatedAt           DateTime  @updatedAt

    environment Environment  @relation(fields: [environmentId], references: [id], onDelete: Cascade)
    target      DeployTarget @relation(fields: [targetId], references: [id], onDelete: Cascade)
    domains     Domain[]
    volumes     Volume[]

    @@unique([environmentId, slug])
    @@index([targetId])
}

model ManagedDatabase {
    id                  String   @id @default(uuid(7)) @db.Uuid
    environmentId       String   @db.Uuid
    targetId            String   @db.Uuid
    name                String
    slug                String
    // postgres | mysql | mariadb | mongo | redis
    engine              String
    image               String
    version             String
    volumeName          String
    // Container name = DNS hostname on the proxy network.
    containerName       String
    // Optional published TCP port for external access via a per-db forwarder.
    exposePort          Int?
    // Set when this is a logical database living inside another instance's
    // container rather than one of its own. It then has no image, volume or
    // container: it is reached through its parent's, with its own credentials.
    parentId            String?  @db.Uuid
    // How much the database's own user may do inside it: owner | readwrite | readonly.
    privileges          String   @default("owner")
    // Envelope-encrypted generated credentials (JSON: user/password/database).
    encryptedCredential Bytes?
    credentialNonce     Bytes?
    credentialKeyId     String?
    status              String   @default("provisioning")
    createdAt           DateTime @default(now())
    updatedAt           DateTime @updatedAt

    environment Environment       @relation(fields: [environmentId], references: [id], onDelete: Cascade)
    target      DeployTarget      @relation(fields: [targetId], references: [id], onDelete: Cascade)
    // Removing an instance removes the databases that only existed inside it;
    // there is nothing left for them to be reached through.
    parent      ManagedDatabase?  @relation("DatabaseInstance", fields: [parentId], references: [id], onDelete: Cascade)
    children    ManagedDatabase[] @relation("DatabaseInstance")

    @@unique([environmentId, slug])
    @@index([targetId])
    @@index([parentId])
}

// One deploy run: a status row plus a pointer to its streamed log file. The log
// itself lives on disk (tailed live), not in the database.
model Deployment {
    id             String    @id @default(uuid(7)) @db.Uuid
    targetId       String    @db.Uuid
    // application | database | stack
    deployableType String
    deployableId   String    @db.Uuid
    // queued | building | deploying | running | failed | cancelled | rolled_back
    status         String    @default("queued")
    imageTag       String?
    commitSha      String?
    // Head commit message when known (auto-deploy webhook / resolved on deploy).
    commitMessage  String?
    // Commit author (GitHub), resolved at deploy time for the deployment avatar.
    authorName      String?
    authorAvatarUrl String?
    // True when this release was deployed into a project of its own so it could
    // stand beside the ones around it (see keepReleases). Recorded rather than
    // derived, because it decides which container and port serve this release -
    // and that must not change under it when the setting is turned off later.
    isolated       Boolean   @default(false)
    // Relative path (under the deploy dir) of the streamed build/deploy log file.
    logPath        String?
    triggeredById  String?   @db.Uuid
    startedAt      DateTime?
    finishedAt     DateTime?
    error          String?
    createdAt      DateTime  @default(now())

    target DeployTarget @relation(fields: [targetId], references: [id], onDelete: Cascade)

    @@index([deployableType, deployableId])
    @@index([targetId])
}

model Domain {
    id            String   @id @default(uuid(7)) @db.Uuid
    applicationId String   @db.Uuid
    hostname      String   @unique
    // auto (free sslip.io/traefik.me, or a zone name derived from the service) |
    // random (an unguessable name minted in a zone) | lan | custom | duckdns |
    // release (one build's own hostname, alongside the service's own address)
    kind          String   @default("auto")
    // Set only on a "release" hostname: the deployment it serves, so it keeps
    // answering from that build while the service's own domains follow whichever
    // release is current. Soft pointer (no FK), like Deployment.deployableId.
    deploymentId  String?  @db.Uuid
    targetPort    Int
    https         Boolean  @default(true)
    // When off, the hostname stops serving the app (its route is dropped) but the
    // record is kept so it can be re-enabled from the service's domain settings.
    enabled       Boolean  @default(true)
    // le | internal | none
    certResolver  String   @default("le")
    pathPrefix    String?
    createdAt     DateTime @default(now())
    // Reachability, set by the health probe: up | down | unknown. So a free
    // subdomain that resolves but does not actually serve is flagged, not shown
    // as if it works.
    healthStatus  String   @default("unknown")
    healthCheckedAt DateTime?
    // Last observed HTTP status and round-trip, and a short reason when down.
    healthCode    Int?
    healthLatencyMs Int?
    healthDetail  String?

    application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

    @@index([applicationId])
    @@index([deploymentId])
}

// Environment variable or secret, scoped to an application or an environment.
// Polymorphic (no FK) like PolicyAttachment; secrets use the envelope columns.
model EnvVar {
    id             String   @id @default(uuid(7)) @db.Uuid
    // application | environment
    scopeType      String
    scopeId        String   @db.Uuid
    key            String
    isSecret       Boolean  @default(false)
    // Plaintext when not a secret; null when isSecret (see envelope columns).
    value          String?
    encryptedValue Bytes?
    valueNonce     Bytes?
    valueKeyId     String?
    createdAt      DateTime @default(now())
    updatedAt      DateTime @updatedAt

    @@unique([scopeType, scopeId, key])
    @@index([scopeType, scopeId])
}

// Web Application Firewall rules for Deploy. Polymorphic (no FK) scoping like
// EnvVar so one table covers global, project, environment, and application scope,
// resolved nearest-scope-wins. Materialized into each server's edge (Traefik) so
// the rules keep enforcing when the Polaris control plane is down.
model WafRule {
    id           String   @id @default(uuid(7)) @db.Uuid
    // polaris | global | project | environment | application
    scopeType    String
    // "" for the polaris and global scopes; otherwise the Project/Environment/
    // Application id. Not a uuid column because those two carry the empty string.
    scopeId      String
    // JSON string arrays of CIDR/IP, SQLite-portable like FileRequest.allowedCidrs.
    ipAllowlist  String   @default("[]")
    ipDenylist   String   @default("[]")
    requireLogin Boolean  @default(false)
    // Enabled managed rule packs as a JSON array of ids (see waf-presets.ts). Ids,
    // not their contents: the pack's rules are expanded at the edge, so improving a
    // list ships as a release rather than a migration over everyone's saved rules.
    presets      String   @default("[]")
    // Ordered custom rules as a JSON array (conditions -> block | allow), evaluated
    // first-match-wins after the IP lists.
    rules        String   @default("[]")
    createdAt    DateTime @default(now())
    updatedAt    DateTime @updatedAt

    @@unique([scopeType, scopeId])
    @@index([scopeType, scopeId])
}

/// One address the edge blocks for what it did, rather than for what it claims to
/// be: a jail ban, or an operator's own manual entry.
///
/// Individual entries only, and deliberately so. Bulk feeds (the Tor exit list is a
/// few thousand addresses that turn over daily) live in WafIpFeed as one row each -
/// putting them here would mean thousands of row writes per refresh to represent one
/// list that is always replaced whole.
model WafBan {
    id       String  @id @default(uuid(7)) @db.Uuid
    ip       String  @unique
    /// ban | reputation | manual - mirrors WafIntelReason.
    reason   String
    /// Which jail decided it, the provider that flagged it, or "operator".
    source   String
    note     String?
    /// When it lifts. Null for a manual entry meant to stand until it is removed.
    until    DateTime?
    /// Times this address has been banned, so a repeat offender is held longer.
    offences Int      @default(1)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([until])
}

/// A bulk address list Polaris fetches and republishes to the edge: the Tor exit
/// list today, any other feed later. One row per feed, holding the whole list, so a
/// refresh is one write and a stale feed is one timestamp to look at.
model WafIpFeed {
    /// Feed id ("tor").
    id        String   @id
    /// The addresses, as a JSON string array.
    entries   String   @default("[]")
    /// Whether the operator has this feed switched on.
    enabled   Boolean  @default(false)
    /// When it was last fetched successfully, so staleness is visible.
    fetchedAt DateTime?
    /// Why the last refresh failed, if it did.
    error     String?
    updatedAt DateTime @updatedAt
}

model Volume {
    id            String   @id @default(uuid(7)) @db.Uuid
    targetId      String   @db.Uuid
    applicationId String?  @db.Uuid
    name          String
    mountPath     String
    // volume | bind | nas
    kind          String   @default("volume")
    // For "volume": the named-volume name. For "bind": a subpath confined under
    // the host volume root. For "nas": a subpath confined under the storage
    // connection's mount (the connection id is prefixed when the plan is built).
    source        String?
    // Storage connection backing a "nas" volume; null for volume/bind.
    connectionId  String?  @db.Uuid
    // Optional human-readable size cap (e.g. "10G"); null for unlimited.
    sizeLimit     String?
    createdAt     DateTime @default(now())

    target      DeployTarget       @relation(fields: [targetId], references: [id], onDelete: Cascade)
    application Application?       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
    connection  StorageConnection? @relation(fields: [connectionId], references: [id], onDelete: Restrict)

    @@index([applicationId])
    @@index([targetId])
    @@index([connectionId])
}

// One-shot bearer ticket for a terminal/logs WebSocket. The client presents the
// raw token (hashed here) over Sec-WebSocket-Protocol; the sidecar burns it once.
model DeployTicket {
    id           String    @id @default(uuid(7)) @db.Uuid
    tokenHash    String    @unique
    userId       String    @db.Uuid
    targetId     String    @db.Uuid
    // Container id/name (or a host marker) the ticket authorizes.
    containerRef String
    // terminal | logs
    mode         String    @default("terminal")
    expiresAt    DateTime
    usedAt       DateTime?
    createdAt    DateTime  @default(now())

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
}

// ---------------------------------------------------------------------------
// Metrics (time-series consumption history)
// ---------------------------------------------------------------------------

// One raw consumption sample for a subject: a deployed Application container or a
// Drive StorageConnection (a NAS/server). Kept a short window at full resolution
// then folded into MetricRollup, so raw growth stays bounded. Percentages are
// derived at read time from the byte columns - never stored. subjectId is a
// polymorphic reference (no FK) resolved by subjectType. The natural composite
// key (subject + timestamp) is the query index and enforces one sample per tick;
// it is not an enumerable integer, so the UUID-id rule does not apply here.
model MetricSample {
    // app | storage
    subjectType    String
    subjectId      String   @db.Uuid
    ts             DateTime @default(now())
    cpuPercent     Float?
    cpuTempC       Float?
    memUsedBytes   BigInt?
    memTotalBytes  BigInt?
    diskUsedBytes  BigInt?
    diskTotalBytes BigInt?

    @@id([subjectType, subjectId, ts])
    @@index([ts])
}

// Hourly aggregate of MetricSample rows, retained far longer than raw so the
// 7d/30d (and wider) ranges read a compact table instead of scanning raw. The
// avg columns are the charted line; cpuPercentMax preserves spikes that
// averaging would hide. `samples` is how many raw points were folded in.
model MetricRollup {
    subjectType       String
    subjectId         String   @db.Uuid
    // Start of the UTC hour bucket this row aggregates.
    bucket            DateTime
    cpuPercentAvg     Float?
    cpuPercentMax     Float?
    cpuTempCAvg       Float?
    memUsedBytesAvg   BigInt?
    memTotalBytesAvg  BigInt?
    diskUsedBytesAvg  BigInt?
    diskTotalBytesAvg BigInt?
    samples           Int      @default(0)

    @@id([subjectType, subjectId, bucket])
    @@index([bucket])
}

// ---------------------------------------------------------------------------
// Watch (monitoring and alerting)
// ---------------------------------------------------------------------------

// A CloudWatch-style alarm: a condition over a target's metric or reachability
// that fires events (and notifications) on state transitions. owner/target are
// bare uuids (no FK), so an alarm can watch any subject without coupling.
model Alarm {
    id              String    @id @default(uuid(7)) @db.Uuid
    ownerId         String    @db.Uuid
    name            String
    // application | domain | host
    targetType      String
    targetId        String    @db.Uuid
    // cpu | memory | http | service - http/service are reachability (no threshold).
    metric          String
    // gt | lt, for threshold metrics.
    operator        String    @default("gt")
    // Threshold as a percent for cpu/memory; null for reachability alarms.
    threshold       Float?
    // Consecutive breaching evaluations before firing, to ride out blips.
    forPeriods      Int       @default(2)
    enabled         Boolean   @default(true)
    // ok | alarm | insufficient
    state           String    @default("insufficient")
    // Breaches counted so far toward forPeriods.
    breachStreak    Int       @default(0)
    lastEvaluatedAt DateTime?
    // Optional messaging channel + peer to also notify when the alarm fires.
    notifyChannelId String?   @db.Uuid
    notifyPeerId    String?
    createdAt       DateTime  @default(now())
    updatedAt       DateTime  @updatedAt

    events AlarmEvent[]

    @@index([ownerId])
    @@index([enabled])
    @@index([targetType, targetId])
}

// A state transition of an alarm - the event log Watch generates (fired/cleared).
model AlarmEvent {
    id        String   @id @default(uuid(7)) @db.Uuid
    alarmId   String   @db.Uuid
    // triggered | resolved
    kind      String
    // The value that caused it (percent) for a metric alarm.
    value     Float?
    detail    String?
    createdAt DateTime @default(now())

    alarm Alarm @relation(fields: [alarmId], references: [id], onDelete: Cascade)

    @@index([alarmId, createdAt])
}
