// Polaris data model.
//
// Design constraints (do not relitigate):
//   - Postgres in production, but kept SQLite-portable: no Postgres-only column
//     types beyond the id type, no native enums (String + app-level Zod unions),
//     no scalar arrays or JSONB columns (JSON is stored as a stringified String).
//     The gen-sqlite-schema script swaps the datasource provider and strips the
//     Postgres-only @db.Uuid mapping (SQLite stores the uuid as TEXT).
//   - Every surrogate primary key and id reference is a UUIDv7 stored in a native
//     Postgres `uuid` column (@db.Uuid). Natural keys (GeoIpCache.ip) stay text.
//   - Byte counts use BigInt (files can exceed 2^53) and are handled as bigint
//     in application code, never coerced through a lossy Number.
//   - Polaris is a control plane, not a file mirror: the Node table holds rows
//     only for objects Polaris must track (shared or requested items). Live
//     directory listings come from the storage driver and are never persisted.
//   - better-auth owns the User/Session/Account/Verification core fields; the
//     extra columns and the Role/UserRole tables are Polaris additions. better-auth
//     is configured to generate UUIDs so its inserts fit the uuid columns.

generator client {
    provider = "prisma-client-js"
    output   = "../generated/client"
}

datasource db {
    provider = "postgresql"
    url      = env("POLARIS_DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity and access
// ---------------------------------------------------------------------------

model User {
    id            String   @id @default(uuid(7)) @db.Uuid
    // What this account is called wherever it appears. better-auth owns this
    // column, so it keeps its name - but it is a chosen label rather than a
    // person's name: it need not be what their passport says and it need not
    // resemble their username. The two columns below are the name.
    name          String
    // Their name, in the two halves every form on earth asks for. Both optional
    // because every account that existed before them has neither, and nothing
    // here may stop working for one: `name` is what gets drawn, and these are
    // what somebody is actually called.
    firstName     String?
    lastName      String?
    email         String   @unique
    // Unique handle; sign-in accepts either this or the email.
    username      String?  @unique
    emailVerified Boolean  @default(false)
    image         String?
    // Free-text organisation the account belongs to; shown on the profile only.
    company       String?
    // What this account says about itself, in its own words. Shown wherever a
    // profile is opened - the panel beside a direct message, the card on a name -
    // and nowhere it would be mistaken for something Polaris asserts.
    description   String   @default("")
    // How this account wants dates, times, temperatures and money written, as
    // stringified JSON holding only the fields it actually chose. Absent fields
    // (and a null column) follow the platform default.
    displayPrefs  String?
    // Which events this account wants told about and how, as stringified JSON
    // keyed by event id. Events absent here (and a null column) follow the
    // catalogue default, so a newly added event never arrives muted.
    notifyPrefs   String?
    // How this account has arranged its Overview - which cards, in what order and
    // size, and the links it pinned - as stringified JSON. Cards absent here (and
    // a null column) follow the catalogue, so one added later still appears.
    overviewPrefs String?
    // Owned by the better-auth two-factor plugin; flipped on once the user has
    // verified their authenticator, and back off when they disable it.
    twoFactorEnabled Boolean @default(false)
    // What this account wants everybody else to see: auto | busy | away |
    // invisible. `auto` is the default and means "work it out from whether I am
    // here", which is what it says for almost everybody almost always. The other
    // three are deliberate - a person saying do not disturb, or stepping away,
    // or choosing not to be seen at all - and they outrank what the sessions
    // say, because that is the whole point of choosing one.
    presence      String   @default("auto")
    // A line this account is choosing to show: "back on Monday", "heads down".
    // Separate from `presence` on purpose, and the two are answers to different
    // questions - one is whether to expect a reply, the other is why. Empty is
    // no status, which is what almost everybody has almost always.
    statusText    String   @default("")
    // When that line clears itself. Null means "until I clear it", which is the
    // one people forget: a status set for an afternoon and still there a week
    // later is worse than none, because everybody has stopped reading it. A
    // lapsed one is worked out on read rather than swept by a job - nothing has
    // to run for it to be right.
    statusUntil   DateTime?
    // When that choice stops applying, after which the account is back on `auto`.
    // Null means "until I change it", which is what a status set with no window
    // is. It exists because of the status people forget: do not disturb put on
    // for a meeting and still on two days later is worse than never setting one,
    // since everybody around them stops expecting an answer and nobody is told.
    presenceUntil DateTime?
    // When that choice was made. Only a status schedule reads it, and only to
    // answer the one question a repeating window raises: was this chosen before
    // the window opened, or inside it? A choice made inside a window is somebody
    // overruling their own rule for this morning and it stands until the window
    // closes; one made before it is the rule's to take over. Null for an account
    // that has never chosen, which is every account until it does.
    presenceSetAt DateTime?
    // Second gate for admin-only routes, independent of role permissions.
    isAdmin       Boolean  @default(false)
    // When set, the account is banned: sign-in is refused and sessions are void.
    bannedAt      DateTime?
    banReason     String?
    // When a ban ends, for one that was meant to. Null is a ban with no end.
    //
    // Nothing reads this to decide whether somebody is banned - `bannedAt` alone
    // says that, in the fifteen places that ask - so a suspension is lifted by
    // clearing that column when this moment passes. The sweep that does it is
    // `suspensions`; until it runs, the account stays out, which is the safe way
    // round for the ten seconds it can be wrong by.
    bannedUntil   DateTime?
    // When this account's groups or roles last moved. An edge token states the
    // principals its holder had when it was minted and the guard trusts that offline
    // for hours, so without this a membership change would not reach a service that is
    // already running. Published to the edge (pruned to the token lifetime) so a token
    // that predates the change is spotted there and re-minted. Deliberately not on the
    // session: changing who somebody is in must not sign them out.
    principalsMovedAt DateTime?
    createdAt     DateTime @default(now())
    updatedAt     DateTime @updatedAt

    sessions     Session[]
    accounts     Account[]
    roles        UserRole[]
    permissionOverrides UserPermission[]
    groups       GroupMember[]
    invitesSent  Invite[]                @relation("InviteInviter")
    connections       StorageConnection[]
    dockerConnections DockerConnection[]
    dataConnections   DataConnection[]
    hosts             Host[]
    hostGroups        HostGroup[]
    shares            Share[]
    shareInvites      ShareInvite[]
    fileRequests      FileRequest[]
    submissions       FileRequestSubmission[]
    snippets           Snippet[]
    snippetsSubmitted  Snippet[]              @relation("SnippetSubmitter")
    snippetInvites     SnippetInvite[]
    textRequests       TextRequest[]
    vault              VaultAccount?
    dropPointVisits   FileRequestVisit[]
    dropPointTemplates DropPointTemplate[]
    uploads           UploadSession[]
    notifications     Notification[]
    deployTargets     DeployTarget[]
    projects          Project[]
    projectMemberships ProjectMember[]
    deployTickets     DeployTicket[]
    security            UserSecurity?
    securityQuestions   SecurityQuestion[]
    accountRecoveries   AccountRecovery[]
    accessGroups        AccessGroup[]
    accessGroupBindings UserAccessGroup[]
    apiKeys             ApiKey[]
    twoFactors          TwoFactor[]
    sessionStates       SessionState[]
    trustedDevices      TrustedDevice[]
    accountDevices      AccountDevice[]
    deviceCodes         DeviceCode[]
    emails              UserEmail[]
    phone               UserPhone?
    avatar              UserAvatar?
    banner              UserBanner?
    emailVerifications  EmailVerification[]
    passkeys            Passkey[]
    notifyDestinations  NotificationDestination[]
    notifyDeliveries    NotificationDelivery[]
    enrollments         Enrollment[]
    runnerPools         RunnerPool[]
    agentRepos          AgentRepo[]
    agentDefaults       AgentDefaults[]
    modelKeys           UserModelKey[]
    linkedAccounts      UserConnection[]
    taskSpaces          TaskSpace[]
    taskSpaceMemberships TaskSpaceMember[]
    taskFolderMemberships TaskFolderMember[]
    taskAssignments     TaskAssignee[]
    following           Follow[]
    comments            Comment[]
    taskTimeEntries     TaskTimeEntry[]
    taskReminders       TaskReminder[]
    taskViews           TaskView[]
    taskGoals           TaskGoal[]
    ownedOrgs           Organization[]       @relation("OrganizationOwner")
    orgMemberships      OrganizationMember[]
    orgInvitations      OrganizationInvitation[] @relation("OrganizationInvitee")
    orgInvitesSent      OrganizationInvitation[] @relation("OrganizationInviter")
    teamMemberships     TeamMember[]
    ownedDomains        OwnerDomain[]
    successor           AccountSuccessor?    @relation("AccountSuccessorHolder")
    successorTo         AccountSuccessor[]   @relation("AccountSuccessorHeir")
    notes               Note[]
    chatSpaces          ChatSpace[]
    chatSpaceMemberships ChatSpaceMember[]
    chatSpaceBans       ChatSpaceBan[] @relation("ChatSpaceBanUser")
    chatSpaceBansMade   ChatSpaceBan[] @relation("ChatSpaceBanBy")
    chatSpaceInvites     ChatSpaceInvite[]
    chatSavedMedia       ChatSavedMedia[]
    chatChannelMemberships ChatChannelMember[]
    chatPollVotes        ChatPollVote[]
    contactNamesGiven    ContactName[]       @relation("ContactNamesGiven")
    contactNamesReceived ContactName[]       @relation("ContactNamesReceived")
    chatReportsMade     ChatReport[]         @relation("ChatReportsMade")
    chatScheduled       ChatScheduledMessage[]
    chatReportsHandled  ChatReport[]         @relation("ChatReportsHandled")
    searches            SearchHistory[]
    backupDestinations  BackupDestination[]
    backupPlans         BackupPlan[]
    protectedResources  ProtectedResource[]
    backupJobs          BackupJob[]
    ownedVaults         VaultOrganization[]  @relation("VaultOwner")
    privacy             UserPrivacy?
    privacyLists        PrivacyList[]
    privacyListedOn     PrivacyListMember[]
    privacyFieldLists   PrivacyFieldList[]
    friendshipsAsked    Friendship[]         @relation("FriendshipRequester")
    friendshipsReceived Friendship[]         @relation("FriendshipAddressee")
    blocking            UserBlock[]          @relation("UserBlockBlocker")
    blockedBy           UserBlock[]          @relation("UserBlockBlocked")
    presenceSchedules   PresenceSchedule[]
}

// What somebody last searched for, so the panel opens on their own work.
//
// The browser keeps the same list in local storage, which is what the panel
// paints from the instant it opens; this copy exists so the list follows the
// account to another browser or another machine. Both are capped at the same
// handful, and a repeat is the same row with a newer timestamp rather than a
// second one - the point is to recognize what you were doing, and a list that
// says the same task nine times says nothing.
//
// It records what was opened or what was run, never every keystroke on the way
// there, and it is private to the account: nobody else, administrator included,
// has a reason to read what somebody looked for.
model SearchHistory {
    id     String @id @default(uuid(7)) @db.Uuid
    userId String @db.Uuid
    // What makes two entries the same search, built by the shared helper in
    // @polaris/core so the browser's copy and this one collapse identically.
    key    String
    // "result" for something that was opened, "query" for words that were run.
    kind   String
    // The command it was made under, absent for an unscoped search.
    scope  String?
    term   String @default("")
    // What to show. Held rather than resolved, so a remembered row still reads
    // as itself after the thing it points at is renamed or removed.
    label  String
    // Where it opens, always a path inside Polaris. Null for a remembered query,
    // which is put back in the field instead.
    href   String?
    usedAt DateTime @default(now())

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([userId, key])
    @@index([userId, usedAt])
}

// Something somebody wrote down for themselves.
//
// The same text everything else in Polaris is written in - Markdown, mentions
// and Polaris references included - with none of the surroundings: no space, no
// list, no sharing and no second reader. That is the whole point of having it
// beside Tasks rather than inside them. A note is where a thought lands before
// it is work, and half of them never become work.
//
// Private without qualification: only the account that wrote one reads it, an
// instance administrator included, and it goes when the account does.
model Note {
    id        String   @id @default(uuid(7)) @db.Uuid
    userId    String   @db.Uuid
    title     String   @default("Untitled")
    // Markdown, stored as written so it stays portable out of Polaris.
    body      String   @default("")
    // The note this one sits under, or null at the top level. Notes nest because
    // a page of notes is a filing problem the moment there are thirty of them,
    // and the shape people reach for is the one a notebook already has: a few
    // subjects, each with pages under it. There is no separate folder to create
    // and keep in step - any note can hold others.
    parentId  String?  @db.Uuid
    // Kept at the top of the list, for the few that are read every day.
    pinned    Boolean  @default(false)
    archived  Boolean  @default(false)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
    // Deleting a note frees its children rather than taking them with it: the
    // text under a heading is not owned by the heading, and a delete that
    // silently removed a subtree would be the one destructive action in Polaris
    // that never said how much it was about to destroy.
    parent   Note?  @relation("NoteTree", fields: [parentId], references: [id], onDelete: SetNull)
    children Note[] @relation("NoteTree")

    @@index([userId, archived, updatedAt])
    @@index([userId, parentId])
}

// The account somebody named to take over their own if they die.
//
// One row per account, and only ever written by the account itself: naming a
// successor is a statement about your own estate, so nobody - not an
// administrator, not the successor - can put themselves in this column. The
// acknowledgement the owner read when they named one is kept as `acknowledgedAt`
// rather than as a boolean, because what matters later is that consent was given
// and when, not that a checkbox was true at some unrecorded moment.
//
// It is not a will and it is not a role. What it grants inside Polaris is
// deliberately narrow and lives in the services that read it, so widening it is
// a change somebody has to make on purpose.
model AccountSuccessor {
    userId         String   @id @db.Uuid
    successorId    String   @db.Uuid
    acknowledgedAt DateTime @default(now())
    updatedAt      DateTime @updatedAt

    user      User @relation("AccountSuccessorHolder", fields: [userId], references: [id], onDelete: Cascade)
    successor User @relation("AccountSuccessorHeir", fields: [successorId], references: [id], onDelete: Cascade)

    @@index([successorId])
}

// Addresses a user owns besides the one they sign in with. The primary stays on
// User.email because that is what authenticates; these are alternates, and any
// of them can be marked as a way to reach the owner if they lose access. Unique
// across the table, and checked against every primary before being added, so one
// address never belongs to two accounts.
model UserEmail {
    id        String   @id @default(uuid(7)) @db.Uuid
    userId    String   @db.Uuid
    email     String   @unique
    recovery  Boolean  @default(false)
    // When the owner proved they can read mail at this address. Null means the
    // address is claimed but unproven; the primary address records the same
    // thing on User.emailVerified, which better-auth owns.
    verifiedAt DateTime?
    createdAt DateTime @default(now())

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
}

// A pending "click this to prove the address is yours" link. The raw token lives
// only in the emailed URL; the row keeps its SHA-256 hash, so a database dump
// yields no usable links. One row per outstanding request, replaced when a new
// link is asked for, and deleted the moment it is spent.
model EmailVerification {
    id        String   @id @default(uuid(7)) @db.Uuid
    userId    String   @db.Uuid
    // The address being proved. Held here rather than resolved through UserEmail
    // so a link keeps meaning the address it was sent to even if the row moves.
    email     String
    tokenHash String   @unique
    expiresAt DateTime
    createdAt DateTime @default(now())

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
}

// The number a second-factor code can be sent to. One per account, keyed by the
// user, because it exists to reach one person rather than to be a directory:
// there is nothing to choose between two numbers at the moment someone is
// waiting on a code. Stored in international form, exactly as it will be dialled.
//
// The pending confirmation lives on the same row - a low-entropy code, hashed
// with the password hasher like the quick-unlock PIN, with an expiry and a cap
// on wrong guesses. A number is only usable as a factor once verifiedAt is set.
model UserPhone {
    userId        String    @id @db.Uuid
    phone         String
    verifiedAt    DateTime?
    codeHash      String?
    codeExpiresAt DateTime?
    attempts      Int       @default(0)
    createdAt     DateTime  @default(now())
    updatedAt     DateTime  @updatedAt

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// A profile photo somebody uploaded. The bytes are not here: they go to whatever
// storage the instance keeps uploads on (a NAS if it has one), and this records
// which storage and where, so a photo written before a NAS was connected stays
// readable on the disk it was written to. One row per account - a new photo
// replaces the old one rather than piling up versions nobody asked for.
model UserAvatar {
    userId       String   @id @db.Uuid
    // Null when the bytes are on the disk Polaris runs on.
    connectionId String?
    // Where the bytes are under that storage, relative to its root.
    path         String
    mime         String
    // Bytes. Capped at upload, so an Int is enough and stays JSON-safe.
    size         Int      @default(0)
    updatedAt    DateTime @updatedAt

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// The wide picture across the top of somebody's profile. Kept exactly like the
// photo above - same storages, same one-row-replaces-the-last rule - and a
// separate table rather than two more columns on that one because they are two
// pictures with two lifetimes: taking your photo down is not taking your banner
// down, and a row that had to describe both would need every column twice.
//
// An account with no row is not missing anything: the profile draws a colour
// worked out from the face above it, which is what almost everybody will have.
model UserBanner {
    userId       String   @id @db.Uuid
    connectionId String?
    path         String
    mime         String
    size         Int      @default(0)
    updatedAt    DateTime @updatedAt

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// A browser allowed to sign in without answering the second-factor challenge,
// because somebody ticked "remember this device".
//
// The pass itself is a Verification row: better-auth writes one keyed by a random
// identifier, hands the browser a signed cookie naming it, and rotates the pair
// on every sign-in it lets through. That row carries nothing but the user id and
// an expiry, which is why an account could previously only be told how many of
// these existed and offered to drop the lot.
//
// This is the half Polaris keeps: what the device looked like when it was
// remembered, so the owner can recognise one in the list and end that one. It is
// a label, never the pass - deleting a row here forgets a device, and the
// Verification row is what actually decides whether the challenge is skipped.
model TrustedDevice {
    id String @id @default(uuid(7)) @db.Uuid
    // The Verification row this describes. Follows better-auth's rotation, so
    // one long-lived device stays one row rather than accumulating a new one per
    // sign-in.
    identifier String @unique
    userId     String @db.Uuid
    // Client-supplied, exactly like a session's: shown so a person can tell
    // their phone from their laptop, never an input to a decision.
    userAgent String?
    // The brands that browser announced, read the same way a session's are.
    userAgentBrands String?
    // The system it announced, which outranks the user-agent's claim: a browser
    // emulating a phone rewrites the string and leaves this alone.
    userAgentPlatform String?
    ip        String?
    host      String?
    createdAt DateTime @default(now())
    // Bumped whenever the pass is used, so a device nobody has touched in weeks
    // is visible as one worth forgetting.
    lastSeenAt DateTime @default(now())

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
}

// Every browser this account has ever signed in from, and when it first did.
//
// Distinct from TrustedDevice above, which is only the browsers that asked to
// skip the second-factor challenge and which expires with the pass it describes.
// This one never expires and covers every device, because what it exists to
// answer is "how long has this machine been on the account" - and a device that
// signed in yesterday must not be able to erase that fact by declining to be
// remembered, or by waiting for a pass to lapse.
//
// A session would be the obvious place to read it from, except that sessions are
// ended and expire, so the account's oldest laptop would look new again the
// morning after it was signed out. The first sighting has to outlive them.
//
// Identity is the browser's own description of itself, which two identical
// machines share and which anyone able to set a header can copy. That is the
// safe direction: the worst it does is let a device that has already stolen the
// password skip a wait, and the wait was never the thing keeping them out.
model AccountDevice {
    id     String @id @default(uuid(7)) @db.Uuid
    userId String @db.Uuid
    // Exactly what the browser said it was - matched, not read, so it is stored
    // raw and the label is derived when it is shown.
    userAgent String
    // What it announced and where from when it was first seen. Kept as first
    // seen rather than last: this row is about the device's age on the account.
    userAgentBrands String?
    // The system it announced, preferred over the user-agent's claim when the
    // device is described.
    userAgentPlatform String?
    ip              String?
    host            String?
    firstSeenAt DateTime @default(now())
    lastSeenAt  DateTime @default(now())

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([userId, userAgent])
    @@index([userId])
}

model Session {
    id        String   @id @default(uuid(7)) @db.Uuid
    token     String   @unique
    expiresAt DateTime
    ipAddress String?
    userAgent String?
    userId    String   @db.Uuid
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
    state SessionState?

    @@index([userId])
    // The firewall asks which accounts an address holds sessions on. Without the
    // index that is a scan of every session open on the instance.
    @@index([ipAddress])
}

model Account {
    id                    String    @id @default(uuid(7)) @db.Uuid
    accountId             String
    providerId            String
    userId                String    @db.Uuid
    accessToken           String?
    refreshToken          String?
    idToken               String?
    accessTokenExpiresAt  DateTime?
    refreshTokenExpiresAt DateTime?
    scope                 String?
    password              String?
    createdAt             DateTime  @default(now())
    updatedAt             DateTime  @updatedAt

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
}

model Verification {
    id         String   @id @default(uuid(7)) @db.Uuid
    identifier String
    value      String
    expiresAt  DateTime
    createdAt  DateTime @default(now())
    updatedAt  DateTime @updatedAt

    @@index([identifier])
}

// A WebAuthn credential: a passkey held by the user's device or password
// manager, proved by the device rather than typed. Every column down to
// `aaguid` is the passkey plugin's to decide; Polaris only stores them. The two
// after it are Polaris's own, recorded as the registration goes past.
model Passkey {
    id           String   @id @default(uuid(7)) @db.Uuid
    // What the user calls it, e.g. "iPhone". Set when it is registered.
    name         String?
    publicKey    String
    userId       String   @db.Uuid
    credentialID String
    // Replay counter the authenticator reports on each assertion.
    counter      Int
    // singleDevice | multiDevice, as WebAuthn reports it.
    deviceType   String
    // Whether the credential is synced to the platform's keychain.
    backedUp     Boolean
    // Comma-separated transport hints (usb, nfc, ble, internal, hybrid).
    transports   String?
    // Identifies the authenticator model, for labelling it in the UI.
    aaguid       String?
    // The address it was registered on, which is the only one it signs in on.
    // Null on rows that predate this: those were all issued under the app URL.
    rpId         String?
    // The browser that registered it, as that browser described itself. It is
    // what puts a passkey next to the sessions and the remembered pass of the
    // same device; client-supplied, so a label and never a decision.
    userAgent    String?
    // The brands that browser announced, from the client-hints header. Brave,
    // Vivaldi and Arc report themselves as Chrome in the user-agent on purpose,
    // and this is the only place they say otherwise.
    userAgentBrands String?
    // The system it announced, from the same header family. Believed over the
    // user-agent, which a browser emulating a phone rewrites and this outlives.
    userAgentPlatform String?
    // Where the registration came from. Nothing decides on it; it is what
    // answers "was this me?" about a credential the owner does not recognise.
    ip           String?
    createdAt    DateTime @default(now())
    // When this credential last proved a sign-in. Null until it has been used
    // once, and on rows that predate the column - a passkey nobody can date is
    // the one worth looking at, so it is shown as unused rather than hidden.
    lastUsedAt   DateTime?

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
    @@index([credentialID])
}

model Role {
    id          String     @id @default(uuid(7)) @db.Uuid
    name        String     @unique
    // JSON array of permission keys (or the "*" wildcard). Stored as a string
    // for SQLite portability; validated by @polaris/core on read.
    permissions String
    isSystem    Boolean    @default(false)
    createdAt   DateTime   @default(now())
    users       UserRole[]
}

model UserRole {
    userId String @db.Uuid
    roleId String @db.Uuid
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
    role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

    @@id([userId, roleId])
    @@index([roleId])
}

model Invite {
    id          String    @id @default(uuid(7)) @db.Uuid
    email       String
    // SHA-256 of the invite token; the raw token lives only in the emailed link.
    tokenHash   String    @unique
    roleId      String?   @db.Uuid
    invitedById String    @db.Uuid
    expiresAt   DateTime
    acceptedAt  DateTime?
    createdAt   DateTime  @default(now())
    // How the invite travels and what the recipient presents to claim it:
    // "link" (the admin hands the URL over), "magic" (Polaris emails the URL),
    // or "code" (a short code typed on the join page).
    method      String    @default("link")
    // SHA-256 of the invitation code, for the "code" method. The code itself is
    // shown once at creation and never stored.
    codeHash    String?   @unique
    // Slow hash of an optional one-time password the recipient must also present.
    // Communicated out of band, so a leaked link alone claims nothing.
    passwordHash String?
    // When Polaris sent the invite itself, so the list can report delivery.
    sentAt      DateTime?
    // Where the invite may be claimed from, and the restrictions the account
    // carries afterwards - the same rules, enforced at both moments. JSON string
    // arrays; empty everywhere means no restriction. accessGroupIds names access
    // groups owned by the inviter, resolved when the invite is claimed.
    allowedCidrs      String @default("[]")
    allowedCountries  String @default("[]")
    allowedContinents String @default("[]")
    accessGroupIds    String @default("[]")
    // What the claimant is given on one resource, as a stringified ResourceGrant
    // intent. Set when somebody who runs a server invites a helper to it, so the
    // grant arrives with the account rather than having to be given afterwards.
    // Narrowed again at claim time to what the inviter still holds: an invite must
    // not be a way to hand out reach you have since lost.
    pendingGrant      String?
    // Created by somebody who is not an administrator, under the sharing policy.
    delegated         Boolean @default(false)

    invitedBy User @relation("InviteInviter", fields: [invitedById], references: [id], onDelete: Cascade)

    @@index([email])
}

// ---------------------------------------------------------------------------
// Account security
//
// Everything a user configures about their own account's protection. The rows
// here are per-user, self-service, and never contain a recoverable secret: the
// PIN and the security-question answers go through the same slow hasher as
// passwords, and an API key is only ever stored as the SHA-256 of the issued
// secret.
// ---------------------------------------------------------------------------

// Owned by the better-auth two-factor plugin (TOTP secret + backup codes). The
// secret is encrypted by better-auth under POLARIS_AUTH_SECRET before it lands
// here, and neither column is ever returned to a client.
model TwoFactor {
    id                      String    @id @default(uuid(7)) @db.Uuid
    userId                  String    @db.Uuid
    secret                  String
    backupCodes             String
    verified                Boolean   @default(true)
    failedVerificationCount Int       @default(0)
    lockedUntil             DateTime?

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
    @@index([secret])
}

// A user's own security preferences. One row per user, created lazily the first
// time they change anything (absent means every default below applies).
model UserSecurity {
    userId               String    @id @db.Uuid
    // Hash of the 4-6 digit quick-unlock PIN, or null when none is set.
    // The PIN only re-opens a locked dashboard; signing in always needs the
    // password, so its low entropy never guards the account itself.
    pinHash              String?
    pinUpdatedAt         DateTime?
    // Minutes of inactivity before the dashboard locks. 0 disables the lock.
    idleLockMinutes      Int       @default(0)
    // Absolute session lifetime in minutes, after which the session is signed
    // out regardless of activity. 0 keeps the global default.
    sessionMaxMinutes    Int       @default(0)
    // New sign-ins must be approved from an already-active session.
    requireLoginApproval Boolean   @default(false)
    // Answer the second-factor challenge after signing in with a connected
    // GitHub or Google account too, rather than letting that account stand for
    // both steps. Off by default; the instance policy can demand it of everyone,
    // and this is how one account asks for it when the instance does not.
    challengeConnectionSignIn Boolean @default(false)
    // Second-factor delivery methods the account accepts, beyond the
    // authenticator, which is always accepted while the factor is on. JSON
    // string array for SQLite portability; empty means authenticator only.
    twoFactorMethods     String    @default("[]")
    // Which method the challenge offers first. Null means the authenticator.
    twoFactorPreferred   String?
    // The factor is armed but its authenticator secret belongs to nobody.
    //
    // An account can meet the instance's second-factor requirement with an email
    // code instead of an authenticator. better-auth has one factor and arms it
    // with a TOTP secret either way, so that path mints a secret the owner is
    // never shown. Recorded here because everything that offers the authenticator
    // reads "the factor is on" as "there is an app to open", and would otherwise
    // put a code field in front of somebody who has no way to fill it. Cleared the
    // moment a real authenticator is verified.
    //
    // False by default and never backfilled: every factor armed before this
    // existed was armed by scanning a QR, and an account with no row at all is one
    // that armed its factor through better-auth directly - both are real.
    totpUnclaimed        Boolean   @default(false)
    // A short-lived, single-use pass for the approval gate above. Arming or
    // disabling an authenticator replaces the session it was done from, and the
    // replacement is the same person on the same device - not a new sign-in.
    // Bound to the address that asked for it and consumed on first use.
    rotationGraceUntil   DateTime?
    rotationGraceIp      String?
    // The sign-in in progress, waiting for the session it belongs to.
    //
    // A sign-in and the session row Polaris keeps beside it are written by two
    // different requests: better-auth creates the session while answering the
    // sign-in, and the guard writes SessionState on that session's first request.
    // A second factor makes it three - the password, the code that follows, and
    // the navigation after it - so what each step learned is left here and
    // collected when the session state is finally written.
    //
    // Transient by design: overwritten at the start of every sign-in, consumed by
    // the session it produced, and ignored once stale, so a sign-in nobody
    // finished can never label somebody else's session.
    pendingSignInMethod  String?
    pendingSignInFactor  String?
    pendingSignInAt      DateTime?
    // The device that let that sign-in through, when one did: the session that
    // scanned its code. Travels with the note above and is collected by the same
    // session, because the scan happens on one device and the session it opens is
    // written by another. The label is kept beside the id so the record survives
    // the scanning session being signed out.
    pendingAuthorizerId     String?   @db.Uuid
    pendingAuthorizerDevice String?
    // A recent password confirmation, so an action that has just asked for the
    // password does not ask again for the ceremony it starts. Bound to the
    // session that proved it, because it is that browser's proof and nobody
    // else's, and short enough that a walked-away-from screen does not carry it.
    reauthUntil          DateTime?
    reauthSessionId      String?   @db.Uuid
    // Days a device newly seen on this account waits before it may change
    // anything under Security. 0 turns the wait off, which is the default: it
    // protects an account whose password has just been taken, at the cost of
    // making a genuine new laptop wait, and that is the owner's call to make.
    newDeviceGraceDays   Int       @default(0)
    // Sign-in restrictions set directly on the account, on top of whatever the
    // attached access groups contribute. JSON string arrays for SQLite
    // portability; empty everywhere means no restriction.
    allowedCidrs         String    @default("[]")
    allowedCountries     String    @default("[]")
    allowedContinents    String    @default("[]")
    // Restrictions an administrator imposed on the account. Held apart from the
    // account's own rules above because the two are judged independently: a
    // sign-in must satisfy both, so nothing the user does under Account >
    // Security can widen or drop what an administrator set.
    adminCidrs           String    @default("[]")
    adminCountries       String    @default("[]")
    adminContinents      String    @default("[]")
    createdAt            DateTime  @default(now())
    updatedAt            DateTime  @updatedAt

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// A knowledge-based recovery factor: used to prove identity when the user wants
// to set a new password without knowing the current one. Answers are hashed
// (normalized to lowercase first), so a database dump does not reveal them.
model SecurityQuestion {
    id         String   @id @default(uuid(7)) @db.Uuid
    userId     String   @db.Uuid
    question   String
    answerHash String
    createdAt  DateTime @default(now())

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
}

// A request to get back into an account from outside it: the last way in, for
// someone who has lost the password and every second factor with it. An
// administrator decides it, because nothing an unauthenticated caller can present
// is proof enough on its own - the recovery questions raise the request, they do
// not grant it.
//
// The ticket is a 256-bit token held only by the requester's browser; the row
// keeps its SHA-256, so a database dump yields nothing that can be redeemed. It
// is spent the moment a password is set through it.
model AccountRecovery {
    id        String @id @default(uuid(7)) @db.Uuid
    userId    String @db.Uuid
    tokenHash String @unique
    // Whether the recovery questions were answered before the request was raised.
    // An unverified request is not refused - an account may have no questions set,
    // which is exactly when this route matters - but the decider is told, because
    // it changes what they should check before approving.
    verified  Boolean @default(false)
    // "pending", "approved", "denied", or "used" once a password has been set.
    status    String  @default("pending")
    // Where the request came from, for the administrator judging it.
    requestIp String?
    decidedById String?   @db.Uuid
    decidedAt   DateTime?
    expiresAt   DateTime
    createdAt   DateTime  @default(now())

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
    @@index([status, createdAt])
}

// A named, reusable set of network rules ("Home", "Office") a user attaches to
// their sign-in and to individual API keys, so the same allowlist does not have
// to be retyped per target. Rules are additive: the effective allowlist is the
// union of every attached group plus the target's own inline rules.
model AccessGroup {
    id                String   @id @default(uuid(7)) @db.Uuid
    ownerId           String   @db.Uuid
    name              String
    description       String?
    // JSON string arrays: IP/CIDR rules, ISO country codes, continent codes.
    allowedCidrs      String   @default("[]")
    allowedCountries  String   @default("[]")
    allowedContinents String   @default("[]")
    createdAt         DateTime @default(now())
    updatedAt         DateTime @updatedAt

    owner   User                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
    users   UserAccessGroup[]
    apiKeys ApiKeyAccessGroup[]

    @@unique([ownerId, name])
    @@index([ownerId])
}

// Access groups applied to a user's own sign-ins. An enforced binding was made
// by an administrator: it counts towards the admin rule set rather than the
// account's own, and only an administrator can detach it.
model UserAccessGroup {
    userId   String  @db.Uuid
    groupId  String  @db.Uuid
    enforced Boolean @default(false)

    user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
    group AccessGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

    @@id([userId, groupId])
    @@index([groupId])
}

// Access groups applied to one API key.
model ApiKeyAccessGroup {
    apiKeyId String @db.Uuid
    groupId  String @db.Uuid

    apiKey ApiKey      @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
    group  AccessGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

    @@id([apiKeyId, groupId])
    @@index([groupId])
}

// A personal access token. The secret is shown once at creation and stored only
// as a SHA-256 hash, so a database dump yields no usable keys. A key can never
// exceed its owner's own permissions - `scopes` narrows, it never grants.
model ApiKey {
    id                String    @id @default(uuid(7)) @db.Uuid
    userId            String    @db.Uuid
    name              String
    // Public, non-secret identifier shown in the UI and carried in the key
    // itself, so a key is recognizable without storing the secret.
    prefix            String    @unique
    keyHash           String    @unique
    // JSON array of permission keys this key may exercise.
    scopes            String    @default("[]")
    allowedCidrs      String    @default("[]")
    allowedCountries  String    @default("[]")
    allowedContinents String    @default("[]")
    // Which clients may present the key, beside where from. JSON string arrays
    // of patterns, matched against the request's user-agent; empty allow means
    // any client, and a deny match refuses whatever the allow list says.
    allowedUserAgents String    @default("[]")
    deniedUserAgents  String    @default("[]")
    expiresAt         DateTime?
    lastUsedAt        DateTime?
    lastUsedIp        String?
    // What last presented it, so a key that is being used from somewhere
    // unexpected can be recognised as such rather than only dated.
    lastUsedUserAgent String?
    revokedAt         DateTime?
    // Set on a token minted from a project's settings: the key still carries its
    // owner's permissions, but may only act on this project. Null is an ordinary
    // account key, which reaches everything its scopes allow.
    projectId         String?   @db.Uuid
    createdAt         DateTime  @default(now())

    user    User                @relation(fields: [userId], references: [id], onDelete: Cascade)
    project Project?            @relation(fields: [projectId], references: [id], onDelete: Cascade)
    groups  ApiKeyAccessGroup[]

    @@index([userId])
    @@index([projectId])
}

// Polaris-owned state for one better-auth session: whether the sign-in has been
// approved, whether the idle lock has engaged, and where it came from. Kept in a
// separate table because better-auth owns the Session row's columns.
model SessionState {
    sessionId  String    @id @db.Uuid
    userId     String    @db.Uuid
    // approved | pending | denied. Only "approved" may use the dashboard.
    approval   String    @default("approved")
    // Set when inactivity locked the dashboard; cleared by a PIN/password unlock.
    lockedAt   DateTime?
    lastSeenAt DateTime  @default(now())
    // The address the session was last evaluated from; a change re-runs the
    // account's network rules instead of trusting the first decision forever.
    ip         String?
    country    String?
    userAgent  String?
    // The brands the browser announced, from the client-hints header, so a
    // session names the same browser its passkeys and its remembered pass do.
    userAgentBrands String?
    // The system it announced. Read in preference to the user-agent, which says
    // whatever a browser in device-emulation mode has been told to say.
    userAgentPlatform String?
    // The hostname the session was opened on. A deployment answers on several
    // names - polaris.local on the LAN, its domain from outside - and the cookie
    // is host-only, so the same person signed in twice holds two sessions that
    // are otherwise indistinguishable. Client-supplied, like the user-agent: a
    // label to tell them apart, never an input to a decision.
    host       String?
    // How this session proved who it was. `signInMethod` is what identified the
    // account (password, passkey, email-link, qr-code); `secondFactor` is what
    // was asked for on top of it (totp, email-code, whatsapp-code, code,
    // backup-code) - including trusted-device, which is the challenge that was
    // skipped because the browser had been remembered. Both null on a session
    // opened before Polaris recorded any of this, and the screens say so rather
    // than reading an absent second factor as "no second step".
    signInMethod String?
    secondFactor String?
    // The session that let this one in, when one did: the device that approved it
    // from Account > Sessions, or that scanned the code on its sign-in screen.
    // Null for a session nobody had to answer for, which is most of them.
    //
    // No foreign key, and the device label is stored beside the id on purpose: the
    // authorizing session can be signed out, and "a laptop let this in" must not
    // become "nothing let this in" the moment that laptop goes.
    authorizedBySessionId String?  @db.Uuid
    authorizedByDevice    String?
    // An administrator looking at Polaris as somebody else. Exactly one of the
    // two is set: viewAsUserId is another account this session is acting as,
    // viewAsRoleId is a role whose grants stand in for the administrator's own.
    // Both hang off the administrator's own session on purpose - the account
    // being acted as gets no session of its own, so nothing appears on their
    // devices list and nothing survives the administrator signing out.
    // viewAsAt is when it started; the pretence lapses on its own after a while.
    viewAsUserId String?  @db.Uuid
    viewAsRoleId String?  @db.Uuid
    viewAsAt     DateTime?
    createdAt  DateTime  @default(now())

    session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
    user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
    // The other half of the same question: a session that moved to the address
    // is recorded here rather than on the session row.
    @@index([ip])
}

// A sign-in waiting to be let in from a phone: the QR code on the sign-in screen.
// The screen holds the device code, the person scanning holds the short user code,
// and the row is what carries a decision between the two.
//
// Every column down to `scope` is better-auth's device-authorization plugin's to
// write (RFC 8628); Polaris only stores them. The three `request*` columns are
// Polaris additions, recorded when the code is issued, so the person approving is
// shown what they are letting in rather than approving something unnamed. Like
// every user-agent they are client-supplied - a label, never an input to a
// decision.
//
// Rows are short-lived by design (the code expires in minutes) and are consumed
// on the exchange that issues the session, so this table stays near-empty.
model DeviceCode {
    id              String    @id @default(uuid(7)) @db.Uuid
    // The secret the waiting screen polls with. Never leaves that browser.
    deviceCode      String    @unique
    // The short code printed under the QR, and carried in the link it encodes.
    userCode        String    @unique
    // Set once somebody signed in has claimed the code; only they may answer it.
    userId          String?   @db.Uuid
    expiresAt       DateTime
    // pending | approved | denied.
    status          String
    lastPolledAt    DateTime?
    // Milliseconds the waiting screen must leave between polls.
    pollingInterval Int?
    clientId        String?
    scope           String?
    requestIp        String?
    requestUserAgent String?
    // What that browser announced about itself beyond the string above, read the
    // same way every other device record is: the brands name a Chromium that
    // rebadges Chrome, and the platform outranks a user-agent set to a phone's.
    requestUserAgentBrands   String?
    requestUserAgentPlatform String?
    requestHost      String?
    createdAt       DateTime  @default(now())

    user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
    @@index([expiresAt])
}

// A named bundle of users. Policies attach to a group so a grant applies to
// everyone in it; group membership is the cheapest way to manage access at scale.
model Group {
    id          String        @id @default(uuid(7)) @db.Uuid
    name        String        @unique
    description String?
    isSystem    Boolean       @default(false)
    createdAt   DateTime      @default(now())
    members     GroupMember[]
}

model GroupMember {
    groupId String @db.Uuid
    userId  String @db.Uuid
    group   Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
    user    User  @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@id([groupId, userId])
    @@index([userId])
}

// A reusable authorization policy: a JSON document of allow/deny statements over
// (action, resource) patterns, evaluated by @polaris/core's engine. Attaching a
// policy to a user, group, or role folds its statements into that principal's
// effective permissions. Deny-by-default; an explicit deny overrides any allow.
model Policy {
    id          String             @id @default(uuid(7)) @db.Uuid
    name        String             @unique
    description String?
    // Stringified PolicyDocument JSON (SQLite-portable); validated on read/write.
    document    String
    isSystem    Boolean            @default(false)
    createdAt   DateTime           @default(now())
    updatedAt   DateTime           @updatedAt
    attachments PolicyAttachment[]
}

// Binds a policy to a principal. principalType is "user" | "group" | "role" and
// principalId is that principal's id; kept generic (no FK) so one table covers
// all three without three near-identical join tables.
model PolicyAttachment {
    id            String @id @default(uuid(7)) @db.Uuid
    policyId      String @db.Uuid
    principalType String
    principalId   String @db.Uuid

    policy Policy @relation(fields: [policyId], references: [id], onDelete: Cascade)

    @@unique([policyId, principalType, principalId])
    @@index([principalType, principalId])
}

// A per-path Drive access-control entry: grants (or denies) a principal a set of
// Drive verbs on a connection subtree. Applies to the path and everything under
// it. This is what lets a connection owner share specific folders with other
// users/groups without handing over the whole connection.
model DriveAcl {
    id            String   @id @default(uuid(7)) @db.Uuid
    connectionId  String   @db.Uuid
    // "" means the whole connection; otherwise the subtree root (normalized).
    path          String   @default("")
    principalType String
    principalId   String   @db.Uuid
    // JSON array of Drive verbs: read, write, rename, delete, copy, download.
    actions       String
    effect        String   @default("allow")
    createdById   String   @db.Uuid
    createdAt     DateTime @default(now())

    connection StorageConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

    @@index([connectionId])
    @@index([principalType, principalId])
}

// A grant of specific actions on ONE resource to ONE principal: the generic form
// of DriveAcl. Where that scopes Drive verbs to a connection subtree, this scopes
// any permission key to any addressable thing - "install:<uuid>", "project:<uuid>",
// see RESOURCE_KINDS in @polaris/core. Rows are compiled into PolicyStatements and
// resolved by the same engine, so there is still exactly one evaluator.
//
// This is what a role cannot express. A role permission is compiled as
// resources:["*"], which is why it may only answer "can this account use the
// feature at all"; whether it may act on one particular server is this table's
// question, and ownership's.
//
// principalType/principalId stay generic (no FK), following PolicyAttachment.
// resourceId is likewise a soft pointer - it names four different tables - with
// cleanup in app code, following InstalledApp.
model ResourceGrant {
    id            String    @id @default(uuid(7)) @db.Uuid
    // user | group | role - the same three principals every other grant resolves to.
    principalType String
    principalId   String    @db.Uuid
    // install | project | domain | space | drive.
    resourceKind  String
    // The thing's id, or "*" for every resource of this kind. Not @db.Uuid: the
    // wildcard is not a uuid, and a Drive reference carries a path.
    resourceId    String
    // JSON array of permission keys, expanded through IMPLIED_PERMISSIONS on write
    // exactly as a role's grants are. Unknown keys are dropped on read.
    actions       String
    // allow | deny. An explicit deny overrides every allow, ownership included.
    effect        String    @default("allow")
    // Whether the holder may pass on what they hold here, and no more. This is how
    // somebody who runs a server invites a helper without being an administrator.
    canShare      Boolean   @default(false)
    // Why this exists, for whoever reads it in six months.
    note          String?
    grantedById   String    @db.Uuid
    // When it stops applying. Null is indefinite.
    expiresAt     DateTime?
    createdAt     DateTime  @default(now())
    updatedAt     DateTime  @updatedAt

    // One row per (principal, resource): replaced rather than stacked, the way
    // setDriveAcl already treats a repeated grant.
    @@unique([principalType, principalId, resourceKind, resourceId])
    // "everything this principal reaches" - the per-request resolve and the lists.
    @@index([principalType, principalId])
    // "who reaches this thing" - the owner's access panel.
    @@index([resourceKind, resourceId])
    @@index([expiresAt])
}

// A password gate ("Polaris access gate") on a Drive path. Browsing, opening, or
// downloading anything at or under a locked path requires unlocking it with the
// password first; the unlock is remembered in a signed, per-lock session cookie.
// The password is stored with the same slow, salted KDF as share/link passwords.
model AccessLock {
    id           String   @id @default(uuid(7)) @db.Uuid
    connectionId String   @db.Uuid
    path         String
    passwordHash String
    createdById  String   @db.Uuid
    createdAt    DateTime @default(now())

    connection StorageConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

    @@unique([connectionId, path])
    @@index([connectionId])
}

// ---------------------------------------------------------------------------
// Storage
// ---------------------------------------------------------------------------

model StorageConnection {
    id                  String   @id @default(uuid(7)) @db.Uuid
    name                String
    kind                String
    ownerId             String   @db.Uuid
    // Non-secret connection config (host, port, share path) as JSON string.
    config              String
    // Envelope-encrypted credentials (AES-256-GCM). Null for anonymous providers.
    encryptedCredential Bytes?
    credentialNonce     Bytes?
    credentialKeyId     String?
    requiresHostd       Boolean  @default(false)
    status              String   @default("active")
    createdAt           DateTime @default(now())
    updatedAt           DateTime @updatedAt

    owner        User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
    mount        StorageMount?
    nodes        Node[]
    shares       Share[]
    fileRequests FileRequest[]
    uploads      UploadSession[]
    itemMeta     DriveItemMeta[]
    folderSizes  DriveFolderSize[]
    trashItems   TrashItem[]
    acls         DriveAcl[]
    locks        AccessLock[]
    scheduledDeletions ScheduledDeletion[]
    deployVolumes      Volume[]
    backupDestinations BackupDestination[]

    @@index([ownerId])
}

// A deletion scheduled for a future time. Polaris has no always-on scheduler, so
// due rows are swept lazily (whenever the connection is next browsed) and by an
// optional cron endpoint for exact timing - the same lazy-evaluation approach the
// rest of the app uses for share/link expiry. `permanent` picks delete-for-good
// over the recycle bin.
model ScheduledDeletion {
    id           String   @id @default(uuid(7)) @db.Uuid
    ownerId      String   @db.Uuid
    connectionId String   @db.Uuid
    path         String
    name         String
    permanent    Boolean  @default(false)
    deleteAt     DateTime
    createdAt    DateTime @default(now())

    connection StorageConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

    @@index([ownerId])
    @@index([connectionId])
    @@index([deleteAt])
}

// A Polaris-managed recycle bin entry. "Move to Trash" relocates the item into a
// hidden trash folder on the same connection and records where it came from, so
// it can be listed, restored to its original path, or permanently deleted. Works
// for any backend; UniFi UNAS keeps its own trash, which can be reused later.
model TrashItem {
    id           String   @id @default(uuid(7)) @db.Uuid
    ownerId      String   @db.Uuid
    connectionId String   @db.Uuid
    name         String
    // Where it lived before deletion, and where it now sits in the trash folder.
    originalPath String
    trashPath    String
    kind         String
    size         BigInt   @default(0)
    deletedAt    DateTime @default(now())

    connection StorageConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

    @@index([ownerId])
    @@index([connectionId])
}

// Per-path presentation metadata for a browsed item (not a mirror of the tree):
// custom icon, hidden flag. Keyed by (connection, path); rows exist only for
// items the user has customized. Cascades away with its connection.
model DriveItemMeta {
    id           String   @id @default(uuid(7)) @db.Uuid
    ownerId      String   @db.Uuid
    connectionId String   @db.Uuid
    path         String
    hidden       Boolean  @default(false)
    favorite     Boolean  @default(false)
    // The Polaris user who uploaded/created this item, when known (drop-point
    // uploads, dashboard uploads, new files/folders, copies). Null for items that
    // predate Polaris or were created out of band. Follows the item on move/rename.
    creatorId    String?  @db.Uuid
    icon         String?
    iconColor    String?
    note         String?
    createdAt    DateTime @default(now())
    updatedAt    DateTime @updatedAt

    connection StorageConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

    @@unique([connectionId, path])
    @@index([ownerId])
}

// Measured size of everything under a folder. This is a derived measurement, not
// a mirror of the tree: walking a remote folder is expensive, so the result is
// kept with the time it was taken and reused until it ages out or Polaris itself
// writes under (or above) the path. `partial` marks a walk that hit its budget,
// making `bytes` a lower bound rather than the exact total.
model DriveFolderSize {
    id           String   @id @default(uuid(7)) @db.Uuid
    connectionId String   @db.Uuid
    path         String
    bytes        BigInt   @default(0)
    files        Int      @default(0)
    folders      Int      @default(0)
    partial      Boolean  @default(false)
    computedAt   DateTime @default(now())

    connection StorageConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

    @@unique([connectionId, path])
}

model DockerConnection {
    id                  String   @id @default(uuid(7)) @db.Uuid
    name                String
    ownerId             String   @db.Uuid
    // socket | ssh | tcp
    transport           String
    // Non-secret transport config (host, port, socket path) as JSON string.
    config              String
    // Envelope-encrypted credentials (pasted SSH key / TLS certs). Null for the
    // socket transport and for SSH using the install-provisioned key.
    encryptedCredential Bytes?
    credentialNonce     Bytes?
    credentialKeyId     String?
    status              String   @default("active")
    createdAt           DateTime @default(now())
    updatedAt           DateTime @updatedAt

    owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

    @@index([ownerId])
}

// A global server registered once (SSH) and consumed by multiple apps: Docker
// over SSH in Containers, and SFTP browsing in Drive.
model Host {
    id                  String   @id @default(uuid(7)) @db.Uuid
    name                String
    ownerId             String   @db.Uuid
    // SSH endpoint.
    address             String
    port                Int      @default(22)
    username            String
    // password | key
    authMethod          String
    // Whether the Polaris login on this machine may act as root through
    // password-less sudo. Granted only when the enrollment command was run with
    // --root, and recorded from what the machine reported it ended up with rather
    // than from what was asked for. It decides whether a root shell is offered and
    // whether files can be browsed as root, so a wrong value here is either a
    // capability that silently fails or one that is silently held.
    sudo                Boolean  @default(false)
    // home-nat | home-cgnat | vps | cloud | unknown - where the server lives,
    // which decides how a domain can be pointed at it (see @polaris/core).
    environment         String   @default("unknown")
    // Wildcard domain pointed at THIS server ("apps.example.com" covering
    // *.apps.example.com), so its services get real domains served by its own
    // edge. Null falls back to the IP-derived free subdomain.
    wildcardDomain      String?
    // Server public key (base64) pinned on the trust-on-add test connect.
    hostKey             String?
    // What the machine says it runs, as it words it ("Ubuntu 24.04.1 LTS",
    // "macOS 15.3"). Reported at enrollment and refreshed whenever the machine is
    // probed. Kept rather than asked for on every render so the list still says
    // what a server is while the server is unreachable.
    os                  String?
    osProbedAt          DateTime?
    // Id of the Docker daemon reached on this machine, recorded whenever it is
    // sampled. A server registered by SSH can turn out to be the very machine
    // Polaris runs on - the same box has one daemon id however it is reached, so
    // this is what stops it being monitored, charted and listed twice.
    dockerId            String?
    // Envelope-encrypted credentials (password, or private key + passphrase).
    encryptedCredential Bytes?
    credentialNonce     Bytes?
    credentialKeyId     String?
    status              String   @default("active")
    createdAt           DateTime @default(now())
    updatedAt           DateTime @updatedAt

    owner         User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
    deployTargets DeployTarget[]
    enrollments   Enrollment[]
    runnerPools   RunnerPool[]
    groups        HostGroupMember[]
    backupDestinations BackupDestination[]

    @@index([ownerId])
}

/// A named set of servers, so a rule can be written once for "the VPS boxes" or
/// "everything at home" instead of once per machine.
///
/// Membership only - a group carries no settings of its own. What makes it useful is
/// that it is a firewall scope like any other, so the rules attached to it merge into
/// every service running on any of its members.
model HostGroup {
    id      String @id @default(uuid(7)) @db.Uuid
    ownerId String @db.Uuid
    name    String

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    owner   User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
    members HostGroupMember[]

    @@unique([ownerId, name])
    @@index([ownerId])
}

model HostGroupMember {
    groupId String @db.Uuid
    hostId  String @db.Uuid

    group HostGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
    host  Host      @relation(fields: [hostId], references: [id], onDelete: Cascade)

    @@id([groupId, hostId])
    @@index([hostId])
}

// An offer to let one machine join Polaris, redeemed by a script run on it.
//
// The alternative to this row is asking an operator to type an SSH password into
// a dashboard, which is the thing worth avoiding: here Polaris mints the key pair
// up front, keeps the private half encrypted (`encryptedKey`, same envelope as
// every other stored credential), and the script installs only `publicKey`. No
// secret travels to the machine and none comes back, so a script intercepted in
// transit yields an attacker nothing but a token that expires in minutes and
// works exactly once.
//
// `hostKeys` is what the machine reported about itself while the script was still
// running as root. Polaris pins against that list on its first connect, which
// closes the window trust-on-add leaves open.
model Enrollment {
    id           String    @id @default(uuid(7)) @db.Uuid
    // server | runner - what the machine becomes once it claims this.
    kind         String    @default("server")
    tokenHash    String    @unique
    createdById  String    @db.Uuid
    // Proposed name; the machine's real hostname replaces it when it reports one.
    name         String
    // Carried onto the Host, so the operator answers "where does it live" once.
    environment  String    @default("unknown")
    // The login the script provisions and Polaris authenticates as.
    username     String
    // The authorized_keys line installed on the machine.
    publicKey    String
    encryptedKey Bytes
    keyNonce     Bytes
    keyKeyId     String
    // Newline-separated public host keys the machine reported, pinned on connect.
    hostKeys     String    @default("")
    // Where Polaris reached it: the claim's source address, not one the script chose.
    address      String?
    port         Int       @default(22)
    claimedAt    DateTime?
    // The Host this produced. Null while pending, and after a failed claim.
    hostId       String?   @db.Uuid
    // Why the claim did not finish, shown next to the command so the operator can
    // fix the machine rather than guess.
    error        String?
    expiresAt    DateTime
    createdAt    DateTime  @default(now())

    createdBy User  @relation(fields: [createdById], references: [id], onDelete: Cascade)
    host      Host? @relation(fields: [hostId], references: [id], onDelete: SetNull)

    @@index([createdById])
    @@index([expiresAt])
}

// A standing offer of compute to GitHub: keep `maxConcurrent` self-hosted runners
// alive on one registered server, so workflows selecting these labels have
// somewhere to land.
//
// The pool is configuration, not state. Nothing here records a running process,
// because a process on somebody else's machine is not something a row can be the
// truth about - RunnerJob tracks the ones Polaris started, and the machine and
// GitHub are both re-read on every reconcile pass rather than believed.
//
// There is no "keep this runner around" column. Every runner a pool starts is
// registered just-in-time and de-registers itself after one job: a runner that
// outlives its job keeps a credential on disk and carries one workflow's leftovers
// into the next, which is the failure this whole design exists to avoid.
model RunnerPool {
    id            String   @id @default(uuid(7)) @db.Uuid
    ownerId       String   @db.Uuid
    // The registered server the runners run on. Null is the box Polaris itself
    // runs on, which has no Host row and is reached through polaris-hostd.
    hostId        String?  @db.Uuid
    name          String
    // repo | repos | account | org | users | group - what the pool was asked to
    // serve. Only `repo` and `org` are single registrations; the rest resolve to a
    // set of them (see RunnerPoolTarget).
    scope         String
    // The rest of the scope, as stringified JSON whose shape depends on `scope`:
    // the repositories picked, the account named, the Polaris people or group
    // chosen. Validated by runnerScopeSchema in @polaris/core on the way in and
    // again on the way out, since a column is not a type.
    scopeConfig   String   @default("{}")
    // Labels a workflow selects with `runs-on`, as a stringified JSON array.
    labels        String
    // How many runners are kept waiting at once. Each is a real process on the
    // machine, so it is bounded (see MAX_RUNNER_CONCURRENCY in @polaris/core).
    maxConcurrent Int      @default(1)
    // What one repository may spend inside this pool. Null is no limit of that
    // kind; the pool's own ceiling is maxConcurrent above. These exist so one busy
    // repository cannot be the only one a shared machine ever serves.
    perTargetConcurrent Int?
    minutesBudget       Int?
    // day | month - the calendar window minutesBudget is measured over.
    minutesWindow       String @default("month")
    jobsPerDay          Int?
    // pause | warn - whether a repository that has spent its budget stops being
    // served, or keeps being served with the overage reported on the pool.
    onExhausted         String @default("pause")
    // When the scope was last turned into targets. A scope that names an account
    // or a group is a question for GitHub and the user directory, and asking it on
    // every pass would spend the connection's rate limit on an answer that changes
    // about as often as somebody creates a repository.
    targetsResolvedAt   DateTime?
    // container | workspace - whether a job is thrown away with a container, or
    // only given an empty directory on the machine itself.
    isolation     String
    enabled       Boolean  @default(true)
    // Why the pool last failed to keep its runners up, shown on the pool rather
    // than left in a log the operator has no reason to open.
    error         String?
    createdAt     DateTime @default(now())
    updatedAt     DateTime @updatedAt

    owner   User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
    host    Host?              @relation(fields: [hostId], references: [id], onDelete: Cascade)
    jobs    RunnerJob[]
    targets RunnerPoolTarget[]
    secrets RunnerSecret[]
    repos   RunnerRepoConfig[]
    agentRepos AgentRepo[]
    agentDefaults AgentDefaults[]

    @@index([ownerId])
    @@index([hostId])
}

// What one repository is allowed to make this pool's machine do.
//
// Deliberately NOT stored on RunnerPoolTarget, which is derived: a scope that
// momentarily resolves smaller (GitHub answering 502, an installation being
// repaired) deletes target rows and would take the operator's decisions with
// them. Losing "this public repository was reviewed and allowed" to a transient
// API failure, and silently restoring the permissive-looking default when the
// row comes back, is the one data loss here that has a security consequence.
//
// A missing row means the defaults in @polaris/core/runner-policy, which are the
// cautious ones: no public repository served, nothing from a fork.
model RunnerRepoConfig {
    id          String   @id @default(uuid(7)) @db.Uuid
    poolId      String   @db.Uuid
    // "owner/repo", matching RunnerPoolTarget.key. An organization-level pool
    // registers one runner for every repository at once, so its key is the owner
    // and its policy necessarily covers all of them.
    key         String
    // Which events may run here, as a stringified JSON array of the names in
    // RUNNER_EVENTS. Re-read through parseRunnerEvents, which drops anything this
    // version does not know rather than trusting a row a newer Polaris wrote.
    events      String
    // Whether a pull request whose code lives in a fork may run at all.
    allowForks  Boolean  @default(false)
    // Whether this repository being public was reviewed and accepted.
    allowPublic Boolean  @default(false)
    // Whether the secrets set for this repository are put within its jobs' reach.
    secrets     Boolean  @default(true)
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    pool RunnerPool @relation(fields: [poolId], references: [id], onDelete: Cascade)

    @@unique([poolId, key])
    @@index([poolId])
}

// A value a workflow reads out of its environment, held by Polaris rather than
// by GitHub.
//
// GitHub's own secrets are handed to a job by GitHub. These are the other half:
// what the operator wants their own machines to carry - a registry login, an
// internal endpoint, a signing key that should never be uploaded to GitHub at
// all. They are put in the runner's environment when it starts, which is why the
// scope below is exactly the registration: a runner is registered against one
// repository, so a secret scoped to that repository reaches its jobs and no
// others.
//
// The value is envelope-encrypted at rest with the master key, the same way a
// deploy secret and a stored credential are, and is never returned to the client
// once written.
model RunnerSecret {
    id             String   @id @default(uuid(7)) @db.Uuid
    poolId         String   @db.Uuid
    // The environment variable name a workflow step reads.
    key            String
    // "" for every repository the pool serves, else the "owner/repo" it is for.
    // An empty string rather than null so the unique index below actually holds:
    // in SQL, two nulls are not equal, and a pool could end up with two of the
    // same pool-wide secret.
    scopeKey       String   @default("")
    encryptedValue Bytes
    valueNonce     Bytes
    valueKeyId     String
    createdAt      DateTime @default(now())
    updatedAt      DateTime @updatedAt

    pool RunnerPool @relation(fields: [poolId], references: [id], onDelete: Cascade)

    @@unique([poolId, scopeKey, key])
    @@index([poolId])
}

// One place a pool registers runners: a repository, or an organization as a whole.
//
// This is derived state, not configuration - it is what the pool's scope resolved
// to the last time it was read, and an account that gains a repository gains a row
// here without anybody editing the pool. It is stored rather than recomputed
// because the columns below are per target and have to survive a pass: what GitHub
// has queued for it, when it last got a runner, and why it is not being served.
model RunnerPoolTarget {
    id           String   @id @default(uuid(7)) @db.Uuid
    poolId       String   @db.Uuid
    // "owner/repo", or "owner" for an organization registration. The identity of
    // the target, and what the placement logic in @polaris/core keys on.
    key          String
    // repo | org, as GitHub's runner endpoints divide them.
    kind         String
    owner        String
    // Null for an organization registration.
    repo         String?
    // Jobs GitHub has waiting that this target could take, as last observed - from
    // a workflow_job webhook where one arrives, and from a poll where none does.
    queued       Int      @default(0)
    // When that count was last refreshed, so a stale one can be told from a zero.
    queuedAt     DateTime?
    // When this pool last started a runner here. Oldest first is what stops one
    // repository from holding every slot on a shared machine.
    lastServedAt DateTime?
    // Why this target is not being served right now (a spent budget, or a policy
    // that will not have it), or null.
    blocked      String?
    // public | private, as GitHub last reported it, or null when it has not been
    // asked yet. Derived and re-read on an interval, because a repository can be
    // made public long after a pool was pointed at it and that changes who is
    // able to run something on the machine.
    visibility   String?
    // GitHub's own fork pull request approval policy for this repository, as last
    // read. Polaris does not enforce it - GitHub does - but it decides whether the
    // repository page has anything to warn about.
    forkApproval String?
    // When visibility and forkApproval were last read.
    checkedAt    DateTime?
    createdAt    DateTime @default(now())
    updatedAt    DateTime @updatedAt

    pool RunnerPool @relation(fields: [poolId], references: [id], onDelete: Cascade)

    @@unique([poolId, key])
    @@index([poolId])
}

// An outside account one Polaris account has linked: a GitHub account, a Google
// account, whatever a later provider adds.
//
// Two layers of credential, and they belong to different people. The operator
// connects the application once (an Integration row holding the OAuth client),
// and each person authorizes their own account on top of it. Polaris therefore
// never holds one credential that reaches everybody's repositories or calendars,
// and an account that unlinks takes its access with it.
//
// Nothing here is written from a form an administrator fills in on somebody
// else's behalf: a row exists because the provider itself said who authorized,
// or because the owner of the account pasted their own token. That is what makes
// it safe to point a runner pool at "these people's repositories".
//
// Several accounts per provider are allowed, capped by a per-provider limit the
// operator sets (one by default).
model UserConnection {
    id             String   @id @default(uuid(7)) @db.Uuid
    userId         String   @db.Uuid
    // Which service this is: "github", "google".
    provider       String
    // The provider's own id for the account. It is the identity that survives a
    // rename, so it is what uniqueness is enforced on rather than the label.
    accountId      String
    // What to show for it: the GitHub login, the Google address.
    label          String
    avatarUrl      String?
    // How it was authorized: "oauth" (the provider's own screen) or "token" (a
    // personal access token the owner pasted).
    method         String   @default("oauth")
    // Envelope-encrypted credential as a JSON payload (refresh token, access
    // token and its expiry, or the pasted token). Null when the link states an
    // identity and nothing more.
    encryptedToken Bytes?
    tokenNonce     Bytes?
    tokenKeyId     String?
    // What the provider actually granted, so a declined scope is visible rather
    // than showing up as an empty list.
    scope          String   @default("")
    // Whether this account may also sign its owner in here. Seeded when the link
    // is written from what the provider is worth as a way in - true for the
    // services Polaris trusts with a sign-in, false for the rest and for a link
    // nobody authorized - and its owner's from then on. The operator's switch is
    // judged separately: both have to allow it.
    signInEnabled  Boolean  @default(false)
    // Whether this link is known to have stopped working, and which
    // announcement its owner has already had about it: "" while it works or
    // while nothing has looked, "expired" once they have been told. Cleared when
    // it answers again, so a renewed token is announced afresh next time rather
    // than staying quiet because it once ran out.
    healthNotice   String   @default("")
    // The last time the provider was asked whether the credential still works.
    checkedAt      DateTime?
    linkedAt       DateTime @default(now())
    updatedAt      DateTime @updatedAt

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    // One outside account cannot be claimed by two Polaris users.
    @@unique([provider, accountId])
    @@index([userId, provider])
}

// One ephemeral runner: registered, started, given a single job, gone.
//
// It is kept after it finishes because it is the only account of what ran on the
// machine and how it ended - the runner itself de-registers, so GitHub stops being
// able to answer that question moments after the job does.
model RunnerJob {
    id             String    @id @default(uuid(7)) @db.Uuid
    poolId         String    @db.Uuid
    // The name registered with GitHub, unique per target.
    name           String
    // GitHub's id for the runner row, so one that never started can still be
    // removed. Null between creating the row and minting the registration.
    githubRunnerId Int?
    // Where it was registered. Denormalized rather than a link to the target row,
    // so a finished job still says what it ran for after the pool stopped serving
    // it - and so usage can be counted per repository over a window without
    // depending on a row that resolution may have removed since.
    targetOwner    String    @default("")
    targetRepo     String?
    // starting | idle | busy | finished | failed
    state          String    @default("starting")
    // When it was first seen taking a job, which is where its consumption starts
    // being counted. A runner that waited an hour and worked for two minutes spent
    // two minutes, and billing it for the hour it sat idle would be a lie.
    busyAt         DateTime?
    // What this one actually got, which can differ from the pool's setting if the
    // machine changed under it.
    isolation      String
    // How to find the runner again on the machine: the container name, or the pid
    // of the detached process. Advisory - liveness is probed, never assumed.
    handle         String?
    error          String?
    // What the job turned out to be, recorded on the machine by the guard hook and
    // read back when the runner is reaped. It cannot be asked for afterwards: an
    // ephemeral runner de-registers itself the moment its job ends, and GitHub
    // stops being able to say which job it took. Null on a runner that was stood
    // down before anything was ever assigned to it.
    workflow       String?
    jobName        String?
    // GitHub's id for the workflow run, so a row can link to it. Text rather than
    // a number: it is transcribed by a shell script and only ever used as a path
    // segment after being checked against /^\d+$/.
    runId          String?
    event          String?
    actor          String?
    ref            String?
    sha            String?
    // Why the guard refused to let the job run, or null when it ran. A refusal is
    // a run worth showing: somebody's pull request did not build and this is the
    // only place that says why.
    refusedReason  String?
    startedAt      DateTime  @default(now())
    finishedAt     DateTime?

    pool RunnerPool @relation(fields: [poolId], references: [id], onDelete: Cascade)

    @@index([poolId, state])
    @@index([startedAt])
    // What a repository has spent in the current window is read on every pass, per
    // pool and per target, so the window is part of the index rather than a scan
    // over everything the pool has ever run.
    @@index([poolId, targetOwner, startedAt])
}

model StorageMount {
    id            String    @id @default(uuid(7)) @db.Uuid
    connectionId  String    @unique @db.Uuid
    mountPath     String
    state         String    @default("pending")
    error         String?
    lastCheckedAt DateTime?
    createdAt     DateTime  @default(now())

    connection StorageConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
}

model Node {
    id           String   @id @default(uuid(7)) @db.Uuid
    connectionId String   @db.Uuid
    path         String
    kind         String
    size         BigInt   @default(0)
    mime         String?
    etag         String?
    ownerId      String?  @db.Uuid
    createdAt    DateTime @default(now())
    updatedAt    DateTime @updatedAt

    connection  StorageConnection       @relation(fields: [connectionId], references: [id], onDelete: Cascade)
    shares      Share[]
    submissions FileRequestSubmission[]

    @@unique([connectionId, path])
    @@index([connectionId])
}

// ---------------------------------------------------------------------------
// Sharing (files out)
// ---------------------------------------------------------------------------

model Share {
    id            String    @id @default(uuid(7)) @db.Uuid
    connectionId  String    @db.Uuid
    // Snapshot of the shared path; a Node row backs it when a stable referent is
    // needed (the remote file may be listed live and can vanish out of band).
    path          String
    nodeId        String?   @db.Uuid
    ownerId       String    @db.Uuid
    kind          String    @default("public")
    // SHA-256 of the share token; lookups are by hash so a DB dump yields no links.
    tokenHash     String    @unique
    // The token, envelope-encrypted under the master key, so the owner can reveal
    // the link again after creation. A DB dump alone still yields no working links.
    encryptedToken Bytes?
    tokenNonce     Bytes?
    tokenKeyId     String?
    // argon2 hash of the optional link password.
    passwordHash  String?
    maxDownloads  Int?
    downloadCount Int       @default(0)
    expiresAt     DateTime?
    // Recipient write permissions, each independent so a link can act as a drop box
    // and/or grant specific edits without the others (e.g. rename but not delete).
    // All default false so a share is read-only until the owner opts in.
    allowUpload   Boolean   @default(false)
    allowRename   Boolean   @default(false)
    allowDelete   Boolean   @default(false)
    allowCreateFolder Boolean @default(false)
    // Whether an upload may replace a file that is already there. Off by default:
    // a visitor cannot see the folder, so overwriting is never something they
    // chose. With it off, a colliding upload is stored under a numbered name.
    allowOverwrite Boolean  @default(false)
    // Whether recipients may download the bytes / preview inline in the browser.
    allowDownload Boolean   @default(true)
    allowPreview  Boolean   @default(true)
    // JSON string array of IP/CIDR rules; empty means anyone with the link.
    allowedCidrs  String    @default("[]")
    // JSON string arrays of ISO country codes / continent codes; empty means no
    // geo restriction. Enforced server-side per access after resolving the IP.
    allowedCountries  String @default("[]")
    allowedContinents String @default("[]")
    createdAt     DateTime  @default(now())
    revokedAt     DateTime?

    connection StorageConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
    node       Node?             @relation(fields: [nodeId], references: [id], onDelete: SetNull)
    owner      User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
    invites    ShareInvite[]
    accessLogs ShareAccessLog[]

    @@index([ownerId])
    @@index([connectionId])
}

model ShareInvite {
    id         String @id @default(uuid(7)) @db.Uuid
    shareId    String @db.Uuid
    userId     String @db.Uuid
    permission String @default("download")

    share Share @relation(fields: [shareId], references: [id], onDelete: Cascade)
    user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([shareId, userId])
    @@index([userId])
}

model ShareAccessLog {
    id            String   @id @default(uuid(7)) @db.Uuid
    shareId       String   @db.Uuid
    at            DateTime @default(now())
    // Client IP is stored hashed for privacy while still supporting abuse review.
    ipHash        String?
    // Raw client IP, shown to the share owner in the access log (their own link).
    ip            String?
    userAgentHash String?
    action        String
    reason        String?

    share Share @relation(fields: [shareId], references: [id], onDelete: Cascade)

    @@index([shareId])
}

// ---------------------------------------------------------------------------
// File requests (files in)
// ---------------------------------------------------------------------------

model FileRequest {
    id                      String    @id @default(uuid(7)) @db.Uuid
    ownerId                 String    @db.Uuid
    tokenHash               String    @unique
    title                   String
    instructions            String?
    destinationConnectionId String    @db.Uuid
    destinationPath         String
    requireLogin            Boolean   @default(false)
    // argon2 hash of an optional access PIN/password gating the upload page.
    passwordHash            String?
    maxSizeBytes            BigInt
    // Optional per-file minimum size; null means no minimum.
    minSizeBytes            BigInt?
    maxFiles                Int?
    // JSON string arrays validated by @polaris/core.
    allowedExtensions       String    @default("[]")
    // Blocklist of extensions; takes precedence over allowedExtensions.
    deniedExtensions        String    @default("[]")
    allowedMimeTypes        String    @default("[]")
    allowedCidrs            String    @default("[]")
    // JSON string array of allowed uploader identities (email or username,
    // lowercased, no leading "@"). Non-empty implies sign-in is required.
    allowedUsers            String    @default("[]")
    // JSON string arrays of ISO country codes / continent codes; empty means no
    // geo restriction. Enforced server-side per upload after resolving the IP.
    allowedCountries        String    @default("[]")
    allowedContinents       String    @default("[]")
    // When set, the drop point only starts accepting uploads at this time.
    startsAt                DateTime?
    // Whether an uploader may delete files they submitted, and (optionally) only
    // within this many seconds of the upload. Null window means no time limit.
    allowUploaderDelete     Boolean   @default(false)
    uploaderDeleteWindowSeconds Int?
    // Whether an upload may replace a file already in the destination folder. Off
    // by default; a colliding upload is stored under a numbered name instead.
    allowOverwrite          Boolean   @default(false)
    expiresAt               DateTime?
    createdAt               DateTime  @default(now())
    revokedAt               DateTime?

    owner       User                    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
    destination StorageConnection       @relation(fields: [destinationConnectionId], references: [id], onDelete: Cascade)
    submissions FileRequestSubmission[]
    visits      FileRequestVisit[]

    @@index([ownerId])
}

// One visitor session on a public drop-point page. Grouped by an opaque cookie
// key so heartbeats and uploads from the same browser fold into one row. The raw
// IP is retained for the owner's Visitors view; ipHash mirrors the log format.
model FileRequestVisit {
    id          String   @id @default(uuid(7)) @db.Uuid
    requestId   String   @db.Uuid
    visitorKey  String
    ip          String?
    ipHash      String?
    userId      String?  @db.Uuid
    userAgent   String?
    uploadCount Int      @default(0)
    firstSeenAt DateTime @default(now())
    lastSeenAt  DateTime @default(now())

    request FileRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
    user    User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

    @@unique([requestId, visitorKey])
    @@index([requestId])
}

// A saved, reusable set of drop-point guardrails owned by a user. `config` is a
// JSON blob of the create-form fields (no destination/title/schedule).
model DropPointTemplate {
    id        String   @id @default(uuid(7)) @db.Uuid
    ownerId   String   @db.Uuid
    name      String
    config    String
    createdAt DateTime @default(now())

    owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

    @@index([ownerId])
}

// Fixed-window rate-limit counters (e.g. password-guess throttling per link+IP).
// A lightweight DB-backed limiter; a distributed deployment can swap in Redis.
model RateLimitCounter {
    id          String   @id @default(uuid(7)) @db.Uuid
    key         String   @unique
    count       Int      @default(0)
    windowStart DateTime @default(now())

    @@index([windowStart])
}

model FileRequestSubmission {
    id                String   @id @default(uuid(7)) @db.Uuid
    requestId         String   @db.Uuid
    submittedByUserId String?  @db.Uuid
    ipHash            String?
    fileName          String
    size              BigInt
    storedNodeId      String?  @db.Uuid
    storedPath        String
    status            String   @default("stored")
    at                DateTime @default(now())

    request     FileRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
    submittedBy User?       @relation(fields: [submittedByUserId], references: [id], onDelete: SetNull)
    storedNode  Node?       @relation(fields: [storedNodeId], references: [id], onDelete: SetNull)

    @@index([requestId])
}

// ---------------------------------------------------------------------------
// Snippets (text out) and text drop points (text in)
// ---------------------------------------------------------------------------

// A piece of text - a config file, an .env, a stack trace, a few files of code -
// that can be handed out by link the same way a file is.
//
// It is not a Drive file and deliberately does not become one: a snippet has no
// storage connection behind it, and writing secrets onto a NAS in the clear to
// get a share link would be the wrong trade. The bytes live here instead,
// envelope-encrypted under the master key, which is what lets Polaris highlight
// and search them.
//
// The link columns are the same shape as Share's, and the same guards in
// lib/link-guards run over them. The snippet IS the shared thing, so they sit on
// this row rather than on a table beside it: a paste with no link is just one
// whose visibility is private.
model Snippet {
    id          String  @id @default(uuid(7)) @db.Uuid
    ownerId     String  @db.Uuid
    title       String
    description String?
    // private | link | invite
    visibility  String  @default("private")

    // SHA-256 of the link token; lookups are by hash so a dump yields no links.
    // Null until the snippet is shared at all.
    tokenHash      String?   @unique
    // The token, envelope-encrypted, so the owner can reveal the link again.
    encryptedToken Bytes?
    tokenNonce     Bytes?
    tokenKeyId     String?
    // scrypt hash of the optional link password.
    passwordHash   String?
    maxViews       Int?
    viewCount      Int       @default(0)
    expiresAt      DateTime?
    revokedAt      DateTime?
    // Whether serving it once wipes the stored bytes. Distinct from maxViews = 1,
    // which only stops answering: this leaves nothing behind to be read out of a
    // later backup, which is the whole point of a one-time secret.
    burnAfterRead  Boolean   @default(false)
    // Set when the sender sealed the text in their browser under a key that rides
    // in the URL fragment. Polaris then holds ciphertext it cannot read, so the
    // viewer decrypts client-side and nothing here can preview or search it.
    clientSealed   Boolean   @default(false)

    // JSON string arrays, read through the same parser as a share's.
    allowedCidrs      String @default("[]")
    allowedCountries  String @default("[]")
    allowedContinents String @default("[]")

    // Set when a text drop point produced this rather than its owner writing it.
    requestId         String? @db.Uuid
    submittedByUserId String? @db.Uuid
    submittedIpHash   String?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    owner       User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
    request     TextRequest?       @relation(fields: [requestId], references: [id], onDelete: SetNull)
    submittedBy User?              @relation("SnippetSubmitter", fields: [submittedByUserId], references: [id], onDelete: SetNull)
    files       SnippetFile[]
    invites     SnippetInvite[]
    accessLogs  SnippetAccessLog[]

    @@index([ownerId, requestId, updatedAt])
    @@index([requestId])
    @@index([submittedByUserId])
}

// One file inside a snippet. A paste is usually one, but an .env plus the
// compose file that reads it is two, and splitting them is what lets each carry
// its own language.
model SnippetFile {
    id            String @id @default(uuid(7)) @db.Uuid
    snippetId     String @db.Uuid
    name          String
    // The highlight.js token, or "" for plain text.
    language      String @default("")
    encryptedBody Bytes
    bodyNonce     Bytes
    bodyKeyId     String
    // Plaintext length in bytes, so a listing can show the size without
    // decrypting every file in it.
    size          Int
    position      Int    @default(0)

    snippet Snippet @relation(fields: [snippetId], references: [id], onDelete: Cascade)

    @@index([snippetId])
}

model SnippetInvite {
    id        String @id @default(uuid(7)) @db.Uuid
    snippetId String @db.Uuid
    userId    String @db.Uuid

    snippet Snippet @relation(fields: [snippetId], references: [id], onDelete: Cascade)
    user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([snippetId, userId])
    @@index([userId])
}

model SnippetAccessLog {
    id            String   @id @default(uuid(7)) @db.Uuid
    snippetId     String   @db.Uuid
    at            DateTime @default(now())
    // Raw address for the owner's own log, hashed copy for abuse review.
    ip            String?
    ipHash        String?
    userAgentHash String?
    action        String
    reason        String?

    snippet Snippet @relation(fields: [snippetId], references: [id], onDelete: Cascade)

    @@index([snippetId])
}

// The inverse of a snippet link: a URL that asks somebody for text.
//
// A drop point takes files into a folder; this takes an .env, a key or a log
// into the owner's snippets. What arrives is envelope-encrypted at rest like any
// other snippet, which means Polaris can read it - said plainly on the page, so
// nobody mistakes it for end-to-end.
model TextRequest {
    id             String  @id @default(uuid(7)) @db.Uuid
    ownerId        String  @db.Uuid
    tokenHash      String  @unique
    encryptedToken Bytes?
    tokenNonce     Bytes?
    tokenKeyId     String?
    title          String
    instructions   String?
    passwordHash   String?
    requireLogin   Boolean @default(false)
    // JSON string array of allowed sender identities (email or username,
    // lowercased). Non-empty implies sign-in is required.
    allowedUsers   String  @default("[]")
    // Per-submission ceiling in characters, and the cap on how many may arrive.
    maxLength      Int
    maxSubmissions Int?
    // Whether the sender may seal what they send in their own browser. The owner
    // then needs the key from the sender to read it, so it is off by default.
    allowSealed    Boolean @default(false)

    allowedCidrs      String @default("[]")
    allowedCountries  String @default("[]")
    allowedContinents String @default("[]")

    startsAt  DateTime?
    expiresAt DateTime?
    createdAt DateTime  @default(now())
    revokedAt DateTime?

    owner       User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
    submissions Snippet[]

    @@index([ownerId])
}

// ---------------------------------------------------------------------------
// Vault (a Bitwarden-compatible password manager)
// ---------------------------------------------------------------------------

// One account's vault.
//
// Everything valuable in these tables is opaque: the client derives a key from a
// master password Polaris never sees, and what is stored is what came back
// already encrypted. That is not a nicety - it is the whole reason the official
// Bitwarden clients can be pointed at this and keep their guarantees.
//
// So the columns split cleanly in two. `masterPasswordHash` and `securityStamp`
// are authentication, and Polaris owns them. `protectedKey`, `publicKey` and
// `privateKey` are key material, and Polaris only moves them: the first is the
// user's symmetric key wrapped under a key derived from their master password,
// and losing the password loses the vault, by design.
//
// A vault row exists only once somebody sets one up; an account without one is
// simply an account that has not.
model VaultAccount {
    userId         String @id @db.Uuid
    // How the client turns the master password into a key. Reported by prelogin
    // BEFORE anybody is authenticated, because a client cannot derive without it.
    kdf            Int    @default(0)
    kdfIterations  Int    @default(600000)
    // Argon2id only; null on PBKDF2.
    kdfMemory      Int?
    kdfParallelism Int?

    // The client sends a hash of its master key; this is that hash, stretched
    // again here with a slow KDF. A dump therefore yields neither the password
    // nor the value a client would have to present.
    masterPasswordHash String
    masterPasswordHint String?

    // The user's symmetric key, wrapped under the stretched master key, and the
    // RSA pair used to share with organizations. The private key is wrapped
    // under the symmetric key. All three are stored exactly as the client sent
    // them: encrypted strings whose contents nothing here can read.
    protectedKey String
    publicKey    String?
    privateKey   String?

    // Bumped whenever the credentials change. Every access token carries the
    // stamp it was issued under, so changing a master password ends every
    // session everywhere without hunting for tokens to delete.
    securityStamp String

    // Minutes a browser may keep this vault open while it is idle. 0 locks it
    // the moment its owner leaves the vault screens; -1 keeps it until the tab
    // is closed. The key is held by the browser either way - this says how long
    // it may hold it, not where.
    unlockTimeout Int @default(15)

    // What a client's sync compares against to decide whether to pull.
    revisionDate DateTime @default(now())
    createdAt    DateTime @default(now())
    updatedAt    DateTime @updatedAt

    user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
    ciphers        VaultCipher[]
    folders        VaultFolder[]
    favorites      VaultFavorite[]
    sends          VaultSend[]
    devices        VaultDevice[]
    refreshTokens  VaultRefreshToken[]
    memberships    VaultOrgUser[]
    emergencyGiven VaultEmergencyAccess[] @relation("VaultEmergencyGrantor")
    emergencyHeld  VaultEmergencyAccess[] @relation("VaultEmergencyGrantee")
}

// One item: a login, a note, a card, an identity, an SSH key.
//
// `data` is the whole item as the client encrypted it - name, notes, username,
// password, every custom field - as one JSON document of encrypted strings. It
// is deliberately not broken into columns: a schema that had a `username`
// column would invite something to read it, and there is nothing to read.
model VaultCipher {
    id             String    @id @default(uuid(7)) @db.Uuid
    // Exactly one of these is set: a personal item, or an organization's.
    userId         String?   @db.Uuid
    organizationId String?   @db.Uuid
    folderId       String?   @db.Uuid
    type           Int
    data           String
    // Whether opening it asks for the master password again. A client-side
    // prompt, so it is stored in the clear - it protects against a shoulder, not
    // against whoever holds the database.
    reprompt       Int       @default(0)
    createdAt      DateTime  @default(now())
    revisionDate   DateTime  @default(now())
    // Set while it is in the trash. Clients show and restore these, so a delete
    // is not a delete until it is emptied.
    deletedDate    DateTime?

    vault        VaultAccount?           @relation(fields: [userId], references: [userId], onDelete: Cascade)
    organization VaultOrganization?      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
    folder       VaultFolder?            @relation(fields: [folderId], references: [id], onDelete: SetNull)
    collections  VaultCollectionCipher[]
    attachments  VaultAttachment[]
    favorites    VaultFavorite[]

    @@index([userId])
    @@index([organizationId])
    @@index([folderId])
}

// A folder in one person's vault. Its name is encrypted like everything else,
// which is why folders are personal even for items an organization owns: the
// name is readable only by whoever made it.
model VaultFolder {
    id           String   @id @default(uuid(7)) @db.Uuid
    userId       String   @db.Uuid
    name         String
    revisionDate DateTime @default(now())

    vault   VaultAccount  @relation(fields: [userId], references: [userId], onDelete: Cascade)
    ciphers VaultCipher[]

    @@index([userId])
}

// Which items one person starred.
//
// Its own table rather than a column, because an item an organization owns is
// one row seen by everybody in it: a favourite on the row would be one person
// starring something for the whole team.
model VaultFavorite {
    userId   String @db.Uuid
    cipherId String @db.Uuid

    vault  VaultAccount @relation(fields: [userId], references: [userId], onDelete: Cascade)
    cipher VaultCipher  @relation(fields: [cipherId], references: [id], onDelete: Cascade)

    @@id([userId, cipherId])
    @@index([cipherId])
}

// A vault beyond the one every account starts with: a second vault of somebody's
// own, or an organization's.
//
// Both are the same thing and are stored as one row on purpose. A vault is a key
// plus the people who hold it, and "mine alone" is that with one member - so a
// personal second vault costs no second model, and clients that already read
// organizations read it without knowing it is one person's.
//
// Exactly one owner is set. `organizationId` hangs it off a Polaris organization,
// whose roster and permissions are already settled elsewhere; `ownerUserId` makes
// it one person's, and then `name` is what it is called, because there is no
// organization row to take a name from.
//
// The pair is the vault's own. The private key is wrapped under the vault's
// symmetric key, and each member holds that symmetric key wrapped under their own
// public key, which is what lets somebody be added without any existing member
// being online to re-share every item.
model VaultOrganization {
    id             String   @id @default(uuid(7)) @db.Uuid
    organizationId String?  @unique @db.Uuid
    ownerUserId    String?  @db.Uuid
    // Set on a personal vault only. Stored in the clear, like an organization's
    // name: clients read it off the profile to label the vault, and a name they
    // cannot decrypt is a vault that shows up unnamed everywhere.
    name           String?
    publicKey      String
    privateKey     String
    createdAt      DateTime @default(now())
    updatedAt      DateTime @updatedAt

    organization Organization?     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
    owner        User?             @relation("VaultOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
    members      VaultOrgUser[]
    collections  VaultCollection[]
    ciphers      VaultCipher[]

    @@index([ownerUserId])
}

// One person's place in an organization's vault.
//
// Separate from the Polaris roster on purpose: being on the roster says who you
// are, and this says whether the key has been handed to you. Somebody invited
// but not yet confirmed holds no key and can decrypt nothing, however many
// permissions their Polaris role carries.
model VaultOrgUser {
    id     String  @id @default(uuid(7)) @db.Uuid
    orgId  String  @db.Uuid
    // Null while only an address has been invited and no account has accepted.
    userId String? @db.Uuid
    email  String
    // -1 revoked, 0 invited, 1 accepted, 2 confirmed. Only a confirmed member
    // has a key.
    status Int     @default(0)
    // 0 owner, 1 admin, 2 user, 3 manager, 4 custom.
    type   Int     @default(2)
    // The organization's symmetric key, wrapped to this member's public key.
    // Written when an owner confirms them, which is the step that hands it over.
    key    String?
    // Whether they reach every collection without being added to each.
    accessAll Boolean  @default(false)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    organization VaultOrganization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
    vault        VaultAccount?           @relation(fields: [userId], references: [userId], onDelete: SetNull)
    collections  VaultCollectionAccess[]

    @@unique([orgId, email])
    @@index([userId])
}

// A collection: the unit an organization's items are shared by.
model VaultCollection {
    id           String  @id @default(uuid(7)) @db.Uuid
    orgId        String  @db.Uuid
    name         String
    // An id from whatever provisioned it, for a directory sync that has to find
    // the same collection again.
    externalId   String?

    organization VaultOrganization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
    ciphers      VaultCollectionCipher[]
    members      VaultCollectionAccess[]

    @@index([orgId])
}

model VaultCollectionCipher {
    collectionId String @db.Uuid
    cipherId     String @db.Uuid

    collection VaultCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
    cipher     VaultCipher     @relation(fields: [cipherId], references: [id], onDelete: Cascade)

    @@id([collectionId, cipherId])
    @@index([cipherId])
}

model VaultCollectionAccess {
    collectionId String  @db.Uuid
    orgUserId    String  @db.Uuid
    readOnly     Boolean @default(false)
    // Whether the passwords inside are hidden from them while the rest is not.
    hidePasswords Boolean @default(false)

    collection VaultCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
    member     VaultOrgUser    @relation(fields: [orgUserId], references: [id], onDelete: Cascade)

    @@id([collectionId, orgUserId])
    @@index([orgUserId])
}

// A file attached to an item. The bytes go wherever uploads go; the name and the
// key to open them are encrypted strings like everything else.
model VaultAttachment {
    id         String   @id @default(uuid(7)) @db.Uuid
    cipherId   String   @db.Uuid
    fileName   String
    key        String?
    size       BigInt
    // Where the ciphertext landed, in the storage target uploads are configured
    // to use.
    storedPath String
    createdAt  DateTime @default(now())

    cipher VaultCipher @relation(fields: [cipherId], references: [id], onDelete: Cascade)

    @@index([cipherId])
}

// A Send: something handed to somebody outside the vault, for a while.
//
// The key that opens it is not here. It rides in the fragment of the link, which
// a browser never sends, so a Send is unreadable to Polaris in exactly the way a
// sealed snippet is - the same trade, reached from the other direction.
model VaultSend {
    id             String    @id @default(uuid(7)) @db.Uuid
    userId         String    @db.Uuid
    type           Int
    data           String
    key            String
    // Optional password on the link. The client stretches it and sends the
    // result; this is that value hashed again here.
    passwordHash   String?
    maxAccessCount Int?
    accessCount    Int       @default(0)
    expirationDate DateTime?
    // Every Send has an end. Bitwarden's clients require one, and a share with
    // no expiry is not a Send, it is a publication.
    deletionDate   DateTime
    disabled       Boolean   @default(false)
    hideEmail      Boolean   @default(false)
    // The id in the public link, separate from the primary key so the URL does
    // not hand out a database identifier.
    accessId       String    @unique
    // For a file Send: where the ciphertext landed, and how big it is.
    storedPath     String?
    fileSize       BigInt?
    createdAt      DateTime  @default(now())
    revisionDate   DateTime  @default(now())

    vault VaultAccount @relation(fields: [userId], references: [userId], onDelete: Cascade)

    @@index([userId])
}

// A client that has signed in to the vault. Bitwarden clients identify
// themselves with an id they generate and keep, which is what makes "this phone"
// a thing an owner can recognize and end.
model VaultDevice {
    id           String   @id @default(uuid(7)) @db.Uuid
    userId       String   @db.Uuid
    identifier   String
    name         String
    type         Int
    pushToken    String?
    createdAt    DateTime @default(now())
    revisionDate DateTime @default(now())

    vault         VaultAccount        @relation(fields: [userId], references: [userId], onDelete: Cascade)
    refreshTokens VaultRefreshToken[]

    @@unique([userId, identifier])
    @@index([userId])
}

// A refresh token, stored as a hash for the same reason a share token is: what
// is in the database cannot be replayed as a session.
model VaultRefreshToken {
    id        String    @id @default(uuid(7)) @db.Uuid
    userId    String    @db.Uuid
    deviceId  String?   @db.Uuid
    tokenHash String    @unique
    // The stamp the account carried when this was issued. A credential change
    // moves the stamp and every older token stops being accepted.
    stamp     String
    expiresAt DateTime
    createdAt DateTime  @default(now())
    revokedAt DateTime?

    vault  VaultAccount @relation(fields: [userId], references: [userId], onDelete: Cascade)
    device VaultDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

    @@index([userId])
}

// Somebody trusted to reach a vault if its owner cannot.
//
// Polaris already has a successor on the account itself, and this is not that:
// the successor is about the estate, decided by Polaris, and this is a key
// handed to a person by the vault, which Polaris cannot mint on anybody's
// behalf. Both exist because neither can do the other's job.
model VaultEmergencyAccess {
    id        String  @id @default(uuid(7)) @db.Uuid
    grantorId String  @db.Uuid
    // Null until an invited address is claimed by an account.
    granteeId String? @db.Uuid
    email     String
    // 0 view, 1 takeover.
    type      Int     @default(0)
    // 0 invited, 1 accepted, 2 confirmed, 3 recovery initiated, 4 recovery
    // approved.
    status    Int     @default(0)
    // How long the grantor has to refuse after recovery is asked for.
    waitDays  Int     @default(7)
    // The grantor's key, wrapped to the grantee's public key. Written when the
    // grantor confirms them, and it is what makes this real rather than a flag.
    keyEncrypted String?
    recoveryInitiatedDate DateTime?
    lastNotificationDate  DateTime?
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    grantor VaultAccount  @relation("VaultEmergencyGrantor", fields: [grantorId], references: [userId], onDelete: Cascade)
    grantee VaultAccount? @relation("VaultEmergencyGrantee", fields: [granteeId], references: [userId], onDelete: SetNull)

    @@unique([grantorId, email])
    @@index([granteeId])
}

// ---------------------------------------------------------------------------
// Uploads (resumable, both directions)
// ---------------------------------------------------------------------------

model UploadSession {
    id            String   @id @default(uuid(7)) @db.Uuid
    kind          String
    ownerId       String?  @db.Uuid
    connectionId  String   @db.Uuid
    targetPath    String
    totalSize     BigInt
    receivedBytes BigInt   @default(0)
    chunkSize     Int
    // JSON record of received parts (offset + etag) for tus-style resume.
    partsJson     String   @default("[]")
    mime          String?
    fileRequestId String?  @db.Uuid
    status        String   @default("open")
    expiresAt     DateTime
    createdAt     DateTime @default(now())

    owner      User?             @relation(fields: [ownerId], references: [id], onDelete: SetNull)
    connection StorageConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

    @@index([connectionId])
    @@index([status])
}

// ---------------------------------------------------------------------------
// Operations
// ---------------------------------------------------------------------------

model AuditLog {
    id         String   @id @default(uuid(7)) @db.Uuid
    actorId    String?  @db.Uuid
    action     String
    targetType String?
    targetId   String?  @db.Uuid
    metadata   String?
    ipHash     String?
    // The session the action arrived on, so a user can read their own history
    // one device at a time. Deliberately not a foreign key: ending a session
    // must not erase what was done from it.
    sessionId  String?  @db.Uuid
    // The organization the action was about, when it was about one. This is what
    // separates "what Ana did in Acme" from "what Ana did on her own account":
    // an organization's history is the actions taken on its roster, its teams,
    // its roles, its domains and its work, and nothing else about the person.
    // Not a foreign key either, for the same reason as the session - an
    // organization being deleted must not quietly erase the record of it.
    orgId      String?  @db.Uuid
    at         DateTime @default(now())

    @@index([actorId])
    @@index([action])
    @@index([sessionId])
    @@index([orgId])
    // The firewall asks this table what an address did, by hashing the address and
    // matching. Without the index that is a scan of every action ever taken.
    @@index([ipHash])
}

model Setting {
    id     String  @id @default(uuid(7)) @db.Uuid
    key    String  @unique
    value  String
    scope  String  @default("global")
    userId String? @db.Uuid

    @@index([scope])
}

// Cache of resolved IP geolocation, so a country/continent allowlist does not hit
// an external provider on every access and a location is remembered for reuse.
// Keyed by IP (a natural key, not a surrogate uuid); refreshed lazily on age-out.
model GeoIpCache {
    ip          String   @id
    countryCode String?
    country     String?
    continent   String?
    source      String?
    updatedAt   DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Integrations (marketplace) and notifications
// ---------------------------------------------------------------------------

// An installed marketplace integration, one row per provider (instance-wide).
// The catalog of available integrations lives in code; this table records which
// have been enabled and their config. Secret material (an API key) is envelope-
// encrypted with the same AES-256-GCM master key as storage credentials, so a DB
// dump yields no usable keys.
model Integration {
    id              String   @id @default(uuid(7)) @db.Uuid
    // Catalog slug, e.g. "virustotal". One install per provider.
    provider        String   @unique
    enabled         Boolean  @default(false)
    // Non-secret config as a stringified JSON object (SQLite-portable).
    config          String   @default("{}")
    // Envelope-encrypted secret (API key); null until configured.
    encryptedSecret Bytes?
    secretNonce     Bytes?
    secretKeyId     String?
    installedById   String?  @db.Uuid
    createdAt       DateTime @default(now())
    updatedAt       DateTime @updatedAt
}

// An in-app notification for one user. Written by server-side events (e.g. a
// drop-point upload scanned by an integration) and surfaced by the bell and the
// notifications page. Cascades away with the user.
model Notification {
    id             String    @id @default(uuid(7)) @db.Uuid
    userId         String    @db.Uuid
    // Category slug driving the icon, e.g. "scan.malicious", "scan.clean".
    type           String
    title          String
    body           String?
    // Optional in-app deep link (e.g. "/drive/drop-points").
    href           String?
    // Styling severity: info | success | warning | danger.
    level          String    @default("info")
    // Who else received the same alert: you | admins | group | everyone. The
    // group name goes in audienceLabel; individual recipients are never listed.
    audience       String    @default("you")
    audienceLabel  String?
    // True when the alert is waiting on the user (approve, review, fix).
    actionRequired Boolean   @default(false)
    // Stringified JSON metadata (connectionId, path, submissionId, ...).
    metadata       String?
    readAt         DateTime?
    createdAt      DateTime  @default(now())

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId, readAt])
    @@index([userId, createdAt])
}

// Somewhere an alert can be sent besides the bell and the account's mailbox: a
// chat webhook (Discord, Slack, or an endpoint of your own) or a phone number.
//
// The target is envelope-encrypted like every other credential in the schema.
// For a webhook that is not caution but necessity - the URL *is* the credential,
// and anyone holding it can post as you - and a phone number gets the same
// treatment so one column has one meaning. targetHint is the masked form the UI
// renders, so listing destinations never needs the master key.
model NotificationDestination {
    id              String    @id @default(uuid(7)) @db.Uuid
    userId          String    @db.Uuid
    // webhook | sms
    kind            String
    name            String
    // Body shape for a webhook: discord | slack | generic. Null for sms.
    format          String?
    // Masked target for display, e.g. "discord.com/api/webhooks/..." or "+34***22".
    targetHint      String
    encryptedTarget Bytes
    targetNonce     Bytes
    targetKeyId     String?
    enabled         Boolean   @default(true)
    // ok | error | untested - the result of the last send or test.
    status          String    @default("untested")
    lastError       String?
    lastUsedAt      DateTime?
    createdAt       DateTime  @default(now())
    updatedAt       DateTime  @updatedAt

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
}

// One attempt to get one event to one place. Kept so the notifications page can
// answer "was I actually told?" - a muted rule, a webhook that 404s and a text
// that never sent all look identical from the bell otherwise.
model NotificationDelivery {
    id              String   @id @default(uuid(7)) @db.Uuid
    userId          String   @db.Uuid
    // Catalogue event id, e.g. "deploy.failed".
    event           String
    // inapp | email | webhook | sms
    kind            String
    // Set for webhook/sms; null for the built-in kinds. Soft pointer, so the
    // record survives the destination being deleted.
    destinationId   String?  @db.Uuid
    // Masked destination as it was at the time, for a row that still reads
    // sensibly after the destination is gone.
    destinationHint String?
    // sent | failed | skipped
    status          String
    // Why it failed, or why it was skipped.
    detail          String?
    createdAt       DateTime @default(now())

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId, createdAt])
}

// The result of an integration scanning a stored file (e.g. VirusTotal on a
// drop-point upload). Kept for the owner's audit trail and to avoid re-scanning
// a known hash. Not FK-bound to the submission so a purged submission does not
// erase the security record.
model FileScan {
    id           String   @id @default(uuid(7)) @db.Uuid
    provider     String   @default("virustotal")
    submissionId String?  @db.Uuid
    connectionId String?  @db.Uuid
    path         String?
    sha256       String?
    // pending | clean | suspicious | malicious | unknown | error | skipped
    verdict      String   @default("pending")
    malicious    Int      @default(0)
    suspicious   Int      @default(0)
    // Provider report permalink, when available.
    permalink    String?
    // Enforcement taken on a detection: none | blocked | quarantined | notified
    action       String   @default("none")
    detail       String?
    createdAt    DateTime @default(now())
    updatedAt    DateTime @updatedAt

    @@index([submissionId])
    @@index([sha256])
}

// An installed marketplace app. The catalog of apps lives in code
// (lib/apps/catalog.ts); this table records each install: which manifest, the
// server it runs on, and the Deploy Application backing a compose-template
// install. Following the Integration precedent, owner/target/application are
// stored as bare uuids (no FK), so installs never couple the shared User /
// DeployTarget / Application models; lifecycle cleanup is done in app code.
// Secret material is envelope-encrypted with the same AES-256-GCM master key as
// storage credentials and integrations.
model InstalledApp {
    id              String   @id @default(uuid(7)) @db.Uuid
    // Catalog manifest id, e.g. "minecraft". Not unique - several instances of
    // the same app may be installed; `singleton` apps are enforced in code.
    catalogId       String
    // Owner who installed it.
    ownerId         String   @db.Uuid
    // Human instance name, e.g. "Survival server".
    name            String
    // DeployTarget the app runs on; null for `builtin` apps with no container.
    targetId        String?  @db.Uuid
    // The Deploy Application backing a `compose-template` install; null until the
    // stack is created, or for non-container apps.
    applicationId   String?  @db.Uuid
    // Non-secret config as a stringified JSON object (SQLite-portable).
    config          String   @default("{}")
    // Envelope-encrypted secret (e.g. an app token); null until configured.
    encryptedSecret Bytes?
    secretNonce     Bytes?
    secretKeyId     String?
    // installing | running | stopped | failed | removed
    status          String   @default("installing")
    installedById   String?  @db.Uuid
    createdAt       DateTime @default(now())
    updatedAt       DateTime @updatedAt

    @@index([ownerId])
    @@index([catalogId])
    @@index([targetId])
    @@index([applicationId])
}

// Who may connect to a game server, and from where. A game server is not HTTP, so
// none of the WAF tables apply to it: the game's own list holds usernames and has
// no concept of an address, and this is the half that adds one. Enforced on the
// join (see lib/apps/minecraft/player-access), which is the first moment a
// player's address exists.
model GamePlayerAccess {
    id             String   @id @default(uuid(7)) @db.Uuid
    // The InstalledApp this rule belongs to. Bare uuid, per the InstalledApp
    // precedent of not linking installs by foreign key.
    installedAppId String   @db.Uuid
    // Minecraft username or Bedrock gamertag, stored as the operator typed it and
    // compared case-insensitively.
    username       String
    // One IPv4 address, a CIDR range, or "any" for a player whose line moves.
    address        String
    // Why this player is on the list, for whoever reads it in six months.
    note           String?
    createdById    String?  @db.Uuid
    createdAt      DateTime @default(now())
    updatedAt      DateTime @updatedAt

    // One row per address rather than per player: somebody who plays from home
    // and from a laptop is one person and two addresses, and keying this on the
    // name alone meant registering the second quietly replaced the first.
    @@unique([installedAppId, username, address])
    @@index([installedAppId])
    @@index([installedAppId, username])
}

// The last inventory Polaris saw a player carrying.
//
// `data get entity` only answers for somebody who is on the server, and the
// question - what was this person carrying - is nearly always asked about
// somebody who has just logged off, or who was banned an hour ago. So it is read
// on a cadence while they are on and kept, and every screen that shows it says
// how old it is rather than implying it is now.
//
// The latest only. A history would answer a different question (what changed, and
// when) and cost a row per player per cycle to do it.
model PlayerInventorySnapshot {
    id             String   @id @default(uuid(7)) @db.Uuid
    installedAppId String   @db.Uuid
    username       String
    // Stringified InventoryItem[], each stack's own data span included, so what
    // is shown offline is what would be written back.
    items          String
    // When the server was actually asked. Not when the row was written: a sweep
    // that found nothing to do must not make a stale snapshot look fresh.
    takenAt        DateTime

    @@unique([installedAppId, username])
    @@index([installedAppId])
}

// Something an operator decided that the server could not be told yet.
//
// Giving an item needs the player standing there; banning only needs the server
// up. Either way the decision is made at four in the afternoon about somebody who
// is asleep, and until now a human had to remember it. This is that memory, and
// it is drained by the same passes that already run for timeouts and firewall
// bans - no new watcher, no new schedule.
model PlayerActionQueue {
    id             String    @id @default(uuid(7)) @db.Uuid
    installedAppId String    @db.Uuid
    username       String
    // give | clear | set-slot | ban | pardon | op | deop | whitelist-add |
    // whitelist-remove - see QUEUED_KINDS in lib/apps/minecraft/queue.
    kind           String
    // Stringified, shaped by the kind (an item and a count, a slot and a stack).
    payload        String    @default("{}")
    // Whether it waits for the player, or only for the server. A ban lands on a
    // name whether or not it is connected.
    needsPlayer    Boolean   @default(true)
    requestedById  String?   @db.Uuid
    // Dropped rather than applied once this passes: something decided months ago
    // and executed without warning is worse than something that quietly lapsed.
    expiresAt      DateTime
    appliedAt      DateTime?
    // Why the last attempt did not take, for the row that shows it.
    lastError      String?
    createdAt      DateTime  @default(now())

    @@index([installedAppId, username])
    @@index([installedAppId, appliedAt])
    @@index([expiresAt])
}

// One visit to a game server: when somebody arrived, and when they went.
//
// The joins and leaves were always in the container's log and were read out of it
// on demand, which meant the history reached exactly as far back as the log tail
// and ended the moment the container was replaced. Two of them, and an evening
// somebody wants to look back on is gone. This is that evening, kept.
//
// It doubles as the sampler's memory. The rows with no `leftAt` are precisely who
// was on when it last looked, so the next sweep has the roster to compare against
// without storing one anywhere else - a name that appears is an arrival and a name
// that has gone is a departure.
//
// Names rather than accounts: ARK answers with what somebody called themselves and
// Minecraft with a username, and neither is a Polaris user.
model GamePlayerSession {
    id             String    @id @default(uuid(7)) @db.Uuid
    installedAppId String    @db.Uuid
    // As the server spells it. Compared case-insensitively by the reader, because
    // only the server decides how it capitalises a name.
    name           String
    joinedAt       DateTime
    // Open while they are still on. An open session is also how the sweep knows
    // who was there a minute ago.
    leftAt         DateTime?

    @@index([installedAppId, joinedAt])
    @@index([installedAppId, leftAt])
    @@index([installedAppId, name])
}

// How many were playing, once a minute.
//
// Derivable from the sessions above, and kept anyway, because the two answer
// different questions. Sessions say who was on; this says that anybody looked.
// Without it an empty night and a night when Polaris was not running are the same
// flat line, and a chart that cannot tell those apart is a chart that lies.
//
// Deliberately not a column on MetricSample: that table takes a row per subject
// per tick for every application on the platform, and a field only game servers
// could ever fill would be dead weight on all of them.
model GameSample {
    installedAppId String   @db.Uuid
    ts             DateTime @default(now())
    playersOnline  Int

    @@id([installedAppId, ts])
    @@index([ts])
}

// A server somebody already built, kept so they can build that one again.
//
// The blueprints and the maps are compiled into Polaris and are the same for
// everybody, which is right for "a bed wars server" and no help at all once
// somebody has spent an evening getting theirs exactly so. This is that evening,
// written down: the game, what it was built from, and the settings that ended up
// differing from the defaults.
//
// Deliberately not a second kind of blueprint. A blueprint says what a game *is*
// and is Polaris's to define; this says how one person likes theirs, and belongs
// to them - which is why it is a row with an owner rather than an entry in a list
// the whole instance shares.
model ServerTemplate {
    id      String @id @default(uuid(7)) @db.Uuid
    ownerId String @db.Uuid
    name    String
    /** In the person's own words, since a name alone stops meaning anything by the
     *  fourth one. */
    summary String @default("")
    /** minecraft | ark - a template only ever builds the game it came from. */
    game    String
    /** java | bedrock, for the one game that has two. */
    edition String @default("java")
    /** What it was built from, so the same plugins and settings come with it. */
    blueprintId String @default("")
    /** The prebuilt world it was built on, when it was built on one. */
    mapId       String @default("")
    /** The release it was pinned to, LATEST included. */
    version     String @default("LATEST")
    /** Stringified Record<string, string>: the container settings that differed
     *  from what the blueprint would have given it. Only the differences, so a
     *  template made a year ago does not force last year's defaults back onto a
     *  server built from it today. */
    env         String @default("{}")
    concurrentPlayers Int @default(8)
    crossplay   Boolean @default(false)
    createdAt   DateTime @default(now())

    @@unique([ownerId, name])
    @@index([ownerId])
}

// What one person has decided about one game server, for themselves.
//
// Per viewer rather than per server, because a server has several: the owner runs
// four of them and lives in one, while somebody invited to help with that one has
// no opinion about the other three. Whose list a server is kept at the top of, or
// put away from, is therefore not a property of the server at all.
//
// A row exists only for a server somebody has said something about, on the
// DriveItemMeta precedent - the absence of a row is the default, so nothing has to
// be written when a server is created and nothing is left behind for the servers
// nobody has an opinion about. Bare ids, per the InstalledApp precedent.
model GameServerPref {
    id             String   @id @default(uuid(7)) @db.Uuid
    userId         String   @db.Uuid
    installedAppId String   @db.Uuid
    /** Kept at the top of their list. */
    favorite       Boolean  @default(false)
    /** Put away: still theirs, still running, out of the list until asked for. */
    archived       Boolean  @default(false)
    createdAt      DateTime @default(now())
    updatedAt      DateTime @updatedAt

    @@unique([userId, installedAppId])
    @@index([userId])
    @@index([installedAppId])
}

// ---------------------------------------------------------------------------
// Messaging (unified inbox across WhatsApp / Telegram / Discord / Slack)
// ---------------------------------------------------------------------------

// A connected account on a messaging platform (a Telegram bot, a WhatsApp number
// via a chosen provider, a Discord/Slack app). The live adapter runs in the
// messaging bridge; this row is the control-plane record. Credentials are
// envelope-encrypted with the same master key as integrations. owner/assignee/
// assistant are bare uuids (no FK), per the InstalledApp precedent.
model Channel {
    id              String   @id @default(uuid(7)) @db.Uuid
    ownerId         String   @db.Uuid
    // telegram | whatsapp | discord | slack
    platform        String
    // Provider backend within a platform, e.g. WhatsApp: whatsapp-web | whatsapp-cloud.
    provider        String?
    // Human label, e.g. "Support bot".
    name            String
    // Platform-side identity once connected (bot username, phone number, ...).
    externalId      String?
    // disconnected | connecting | connected | error
    status          String   @default("disconnected")
    // Non-secret config as stringified JSON (capability snapshot, webhook ids, ...).
    config          String   @default("{}")
    // Envelope-encrypted credential (bot token / session); null until configured.
    encryptedSecret Bytes?
    secretNonce     Bytes?
    secretKeyId     String?
    createdAt       DateTime @default(now())
    updatedAt       DateTime @updatedAt

    conversations Conversation[]

    @@index([ownerId])
    @@index([platform])
}

// A conversation (thread) on a channel with one contact. Assignable to a human
// agent (assigneeId) or handled by an AI assistant (assistantId, an InstalledApp).
model Conversation {
    id            String    @id @default(uuid(7)) @db.Uuid
    channelId     String    @db.Uuid
    // Platform-side chat/peer id, unique within the channel.
    peerId        String
    // Contact display name / handle.
    peerName      String?
    // open | closed | pending
    status        String    @default("open")
    assigneeId    String?   @db.Uuid
    assistantId   String?   @db.Uuid
    lastMessageAt DateTime?
    unread        Int       @default(0)
    createdAt     DateTime  @default(now())
    updatedAt     DateTime  @updatedAt

    channel  Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
    messages Message[]

    @@unique([channelId, peerId])
    @@index([channelId, status])
    @@index([assigneeId])
}

// A single normalized message in a conversation.
model Message {
    id             String   @id @default(uuid(7)) @db.Uuid
    conversationId String   @db.Uuid
    // inbound | outbound
    direction      String
    // Platform-side message id, for acks and dedup.
    externalId     String?
    // text | image | file | audio | interactive | system
    kind           String   @default("text")
    body           String?
    // Stringified JSON: media ref, interactive prompt/options, poll results, ...
    payload        String?
    // Outbound delivery ack: sent | delivered | read | failed.
    ack            String?
    // Who sent an outbound message: a User id, or null for inbound / AI-sent.
    senderId       String?  @db.Uuid
    createdAt      DateTime @default(now())

    conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

    @@index([conversationId, createdAt])
    @@index([externalId])
}

// A saved contact for starting outbound conversations from the Inbox, per owner.
// A contact is a person, independent of platform. Their messaging handles live in
// ContactIdentity, so the same person can be reached on WhatsApp, Telegram, etc.
// under one entry. owner is a bare uuid (no FK).
model Contact {
    id        String   @id @default(uuid(7)) @db.Uuid
    ownerId   String   @db.Uuid
    name      String
    note      String?
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    identities ContactIdentity[]

    @@index([ownerId])
}

// One messaging handle of a contact on a single platform (a WhatsApp number, a
// Telegram chat id, ...). A given handle belongs to at most one contact per owner.
model ContactIdentity {
    id        String   @id @default(uuid(7)) @db.Uuid
    ownerId   String   @db.Uuid
    contactId String   @db.Uuid
    platform  String
    peerId    String
    createdAt DateTime @default(now())

    contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

    @@unique([ownerId, platform, peerId])
    @@index([contactId])
    @@index([ownerId])
}

// ---------------------------------------------------------------------------
// Deploy (Railway-style app/database orchestration)
// ---------------------------------------------------------------------------

// The "where it runs" abstraction: the local host (via polaris-hostd) or a
// remote SSH Host (EC2/VPS). Holds the per-server runtime engine and the shared
// proxy network deployed services join. A local target has a null hostId.
model DeployTarget {
    id              String   @id @default(uuid(7)) @db.Uuid
    ownerId         String   @db.Uuid
    name            String
    // local | host
    kind            String   @default("local")
    // Null for the local hostd target; otherwise the SSH Host it runs on.
    hostId          String?  @db.Uuid
    // compose | swarm
    runtime         String   @default("compose")
    // Shared user-defined network deployed services join for name-based DNS.
    proxyNetwork    String   @default("polaris-proxy")
    // Hash of the last applied runtime/proxy config, for idempotency and drift.
    lastAppliedHash String?
    status          String   @default("active")
    createdAt       DateTime @default(now())
    updatedAt       DateTime @updatedAt

    owner        User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
    host         Host?             @relation(fields: [hostId], references: [id], onDelete: Cascade)
    applications Application[]
    databases    ManagedDatabase[]
    deployments  Deployment[]
    volumes      Volume[]

    @@unique([ownerId, name])
    @@index([ownerId])
    @@index([hostId])
}

model Project {
    id          String   @id @default(uuid(7)) @db.Uuid
    ownerId     String   @db.Uuid
    // The organization this project belongs to, or null for a personal one. Set
    // from whichever shelf was open when it was created, and never changed by a
    // deploy: the person switching to their own scope must stop seeing a client's
    // services, and the services must not follow them there.
    orgId       String?  @db.Uuid
    name        String
    slug        String
    description String?
    // private | internal. A private project is the owner's and whoever was added
    // to it; an internal one is readable by anyone on the instance holding
    // deploy.read, which is what a home lab with one household usually wants.
    visibility  String   @default("private")
    // Project-level behaviour toggles as a JSON object (see ProjectFlags in
    // @polaris/core). One column rather than a table: they are read together on
    // every project load and never addressed one at a time.
    flags       String   @default("{}")
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    owner        User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
    org          Organization?    @relation(fields: [orgId], references: [id], onDelete: Cascade)
    environments Environment[]
    members      ProjectMember[]
    webhooks     ProjectWebhook[]
    tokens       ApiKey[]

    @@unique([ownerId, slug])
    @@index([ownerId])
    @@index([orgId])
}

// Somebody other than the owner who may reach a project. The owner is never a
// row here - ownership is on Project - so removing every member can never lock
// the project away from the person who made it.
model ProjectMember {
    id        String   @id @default(uuid(7)) @db.Uuid
    projectId String   @db.Uuid
    userId    String   @db.Uuid
    // viewer (read) | developer (deploy and configure services) | admin (also
    // project settings and destructive changes).
    role      String   @default("viewer")
    invitedBy String?  @db.Uuid
    createdAt DateTime @default(now())

    project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
    user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([projectId, userId])
    @@index([userId])
}

// Where a project reports its deploys, besides the bell. Project-scoped rather
// than user-scoped (unlike NotificationDestination) because it describes the
// project's own integrations, and survives whoever added it leaving. The URL is
// the credential, so it is envelope-encrypted like every other secret here and
// only the mask is ever read back.
model ProjectWebhook {
    id           String    @id @default(uuid(7)) @db.Uuid
    projectId    String    @db.Uuid
    name         String
    // discord | slack | generic - the body shape posted.
    format       String    @default("generic")
    // Masked URL for display, e.g. "discord.com/api/webhooks/...".
    targetHint   String
    encryptedUrl Bytes
    urlNonce     Bytes
    urlKeyId     String?
    // JSON string array of event ids this endpoint wants, e.g.
    // ["deploy.succeeded","deploy.failed"]. Empty = every deploy event.
    events       String    @default("[]")
    enabled      Boolean   @default(true)
    // ok | error | untested - the result of the last send or test.
    status       String    @default("untested")
    lastError    String?
    lastUsedAt   DateTime?
    createdAt    DateTime  @default(now())
    updatedAt    DateTime  @updatedAt

    project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

    @@index([projectId])
}

// A structural change parked for review instead of applied, Railway-style: it is
// recorded here, drawn on the canvas as pending, and only takes effect when the
// environment's changeset is deployed. Only the destructive changes stage -
// removing a service or a volume - because those are the ones a misclick cannot
// take back; everything else still applies as it always did.
model StagedChange {
    id            String   @id @default(uuid(7)) @db.Uuid
    environmentId String   @db.Uuid
    // service.delete | database.delete | volume.delete
    kind          String
    // application | database | volume
    targetType    String
    targetId      String   @db.Uuid
    // The name as it read when the change was staged, so the changeset still
    // describes itself once the target is gone.
    targetName    String
    // Change-specific detail as JSON (e.g. { "wipe": true } on a volume).
    payload       String   @default("{}")
    createdById   String?  @db.Uuid
    createdAt     DateTime @default(now())

    environment Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)

    @@unique([targetType, targetId, kind])
    @@index([environmentId])
}

// A private container-registry login, owner-scoped, one per registry host. The
// password is envelope-encrypted at rest; deploys `docker login` before pulling a
// private image whose registry matches.
model RegistryCredential {
    id                String   @id @default(uuid(7)) @db.Uuid
    ownerId           String   @db.Uuid
    // Registry host, e.g. "ghcr.io" or "docker.io" (Docker Hub).
    registry          String
    username          String
    encryptedPassword Bytes
    passwordNonce     Bytes
    passwordKeyId     String
    createdAt         DateTime @default(now())
    updatedAt         DateTime @updatedAt

    @@unique([ownerId, registry])
    @@index([ownerId])
}

model Environment {
    id        String   @id @default(uuid(7)) @db.Uuid
    projectId String   @db.Uuid
    name      String
    slug      String
    isDefault Boolean  @default(false)
    // Canvas layout as stringified JSON: { pos: {serviceId:{x,y}}, links: [{source,target}] }.
    layout    String   @default("{}")
    createdAt DateTime @default(now())

    project       Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
    applications  Application[]
    databases     ManagedDatabase[]
    stagedChanges StagedChange[]

    @@unique([projectId, slug])
    @@index([projectId])
}

model Application {
    id                  String    @id @default(uuid(7)) @db.Uuid
    environmentId       String    @db.Uuid
    targetId            String    @db.Uuid
    name                String
    slug                String
    // image | git | dockerfile | nixpacks | buildpacks | static | compose
    sourceType          String
    // JSON: repoUrl, branch, imageRef, dockerfilePath, composeYaml, ...
    sourceConfig        String    @default("{}")
    // JSON: build args, target stage, env-file refs, ...
    buildConfig         String    @default("{}")
    // JSON: healthcheck path/interval/retries (null = none).
    healthcheck         String?
    // running | stopped
    desiredState        String    @default("running")
    replicas            Int       @default(1)
    // Soft pointer to the latest Deployment (no FK, to avoid a relation cycle).
    currentDeploymentId String?   @db.Uuid
    // Auto-deploy on git push (Vercel-style): redeploy when a matching commit lands.
    autoDeploy          Boolean   @default(false)
    // Branch that triggers auto-deploy (falls back to the source branch).
    deployBranch        String?
    // Only auto-deploy when the head commit message matches this (substring, or
    // "regex:<pattern>"); empty = any commit. e.g. "build:".
    commitFilter        String?
    // Globs (one per line, "!" to exclude) a push must have touched for this service
    // to redeploy. Empty = any change in the repository, which is what a repository
    // holding one service wants. This is what stops a monorepo redeploying every
    // service it holds every time anything in it changes.
    watchPaths          String?
    // Last git SHA deployed, for the polling fallback and change detection.
    lastDeployedSha     String?
    // Keep previous deployments running (Railway-style multi-version). Off by
    // default: a new deploy replaces the old container.
    keepReleases        Boolean   @default(false)
    createdAt           DateTime  @default(now())
    updatedAt           DateTime  @updatedAt

    environment Environment  @relation(fields: [environmentId], references: [id], onDelete: Cascade)
    target      DeployTarget @relation(fields: [targetId], references: [id], onDelete: Cascade)
    domains     Domain[]
    volumes     Volume[]

    @@unique([environmentId, slug])
    @@index([targetId])
}

model ManagedDatabase {
    id                  String   @id @default(uuid(7)) @db.Uuid
    environmentId       String   @db.Uuid
    targetId            String   @db.Uuid
    name                String
    slug                String
    // postgres | mysql | mariadb | mongo | redis
    engine              String
    image               String
    version             String
    volumeName          String
    // Container name = DNS hostname on the proxy network.
    containerName       String
    // Optional published TCP port for external access via a per-db forwarder.
    exposePort          Int?
    // Set when this is a logical database living inside another instance's
    // container rather than one of its own. It then has no image, volume or
    // container: it is reached through its parent's, with its own credentials.
    parentId            String?  @db.Uuid
    // How much the database's own user may do inside it: owner | readwrite | readonly.
    privileges          String   @default("owner")
    // Envelope-encrypted generated credentials (JSON: user/password/database).
    encryptedCredential Bytes?
    credentialNonce     Bytes?
    credentialKeyId     String?
    status              String   @default("provisioning")
    createdAt           DateTime @default(now())
    updatedAt           DateTime @updatedAt

    environment Environment       @relation(fields: [environmentId], references: [id], onDelete: Cascade)
    target      DeployTarget      @relation(fields: [targetId], references: [id], onDelete: Cascade)
    // Removing an instance removes the databases that only existed inside it;
    // there is nothing left for them to be reached through.
    parent      ManagedDatabase?  @relation("DatabaseInstance", fields: [parentId], references: [id], onDelete: Cascade)
    children    ManagedDatabase[] @relation("DatabaseInstance")
    dataConnections DataConnection[]

    @@unique([environmentId, slug])
    @@index([targetId])
    @@index([parentId])
}

// One deploy run: a status row plus a pointer to its streamed log file. The log
// itself lives on disk (tailed live), not in the database.
model Deployment {
    id             String    @id @default(uuid(7)) @db.Uuid
    targetId       String    @db.Uuid
    // application | database | stack
    deployableType String
    deployableId   String    @db.Uuid
    // queued | building | deploying | running | failed | cancelled | rolled_back
    status         String    @default("queued")
    imageTag       String?
    commitSha      String?
    // Head commit message when known (auto-deploy webhook / resolved on deploy).
    commitMessage  String?
    // Commit author (GitHub), resolved at deploy time for the deployment avatar.
    authorName      String?
    authorAvatarUrl String?
    // True when this release was deployed into a project of its own so it could
    // stand beside the ones around it (see keepReleases). Recorded rather than
    // derived, because it decides which container and port serve this release -
    // and that must not change under it when the setting is turned off later.
    isolated       Boolean   @default(false)
    // Relative path (under the deploy dir) of the streamed build/deploy log file.
    logPath        String?
    triggeredById  String?   @db.Uuid
    startedAt      DateTime?
    finishedAt     DateTime?
    error          String?
    createdAt      DateTime  @default(now())

    target DeployTarget @relation(fields: [targetId], references: [id], onDelete: Cascade)

    @@index([deployableType, deployableId])
    @@index([targetId])
}

model Domain {
    id            String   @id @default(uuid(7)) @db.Uuid
    applicationId String   @db.Uuid
    hostname      String   @unique
    // auto (free sslip.io/traefik.me, or a zone name derived from the service) |
    // random (an unguessable name minted in a zone) | lan | custom | duckdns |
    // release (one build's own hostname, alongside the service's own address)
    kind          String   @default("auto")
    // Set only on a "release" hostname: the deployment it serves, so it keeps
    // answering from that build while the service's own domains follow whichever
    // release is current. Soft pointer (no FK), like Deployment.deployableId.
    deploymentId  String?  @db.Uuid
    targetPort    Int
    https         Boolean  @default(true)
    // When off, the hostname stops serving the app (its route is dropped) but the
    // record is kept so it can be re-enabled from the service's domain settings.
    enabled       Boolean  @default(true)
    // le | internal | none
    certResolver  String   @default("le")
    // A certificate the operator supplied for this hostname, served instead of the
    // managed one. The chain is public material and stored as PEM; the private key is
    // encrypted at rest like every other secret. Kept even while it is not being
    // served - a certificate that has lapsed is replaced by the operator, not by us
    // silently discarding what they uploaded.
    certPem       String?
    certKey       String?
    pathPrefix    String?
    createdAt     DateTime @default(now())
    // Reachability, set by the health probe: up | down | unknown. So a free
    // subdomain that resolves but does not actually serve is flagged, not shown
    // as if it works.
    healthStatus  String   @default("unknown")
    healthCheckedAt DateTime?
    // Last observed HTTP status and round-trip, and a short reason when down.
    healthCode    Int?
    healthLatencyMs Int?
    healthDetail  String?
    // Consecutive failed probes, so one bad minute does not page anybody, and the
    // timestamp of the alert that was actually sent - which is also what says the
    // recovery is worth mentioning. Null = nobody has been told this is down.
    healthFailures  Int      @default(0)
    healthAlertedAt DateTime?

    application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

    @@index([applicationId])
    @@index([deploymentId])
}

// Environment variable or secret, scoped to an application or an environment.
// Polymorphic (no FK) like PolicyAttachment; secrets use the envelope columns.
model EnvVar {
    id             String   @id @default(uuid(7)) @db.Uuid
    // application | environment
    scopeType      String
    scopeId        String   @db.Uuid
    key            String
    isSecret       Boolean  @default(false)
    // Plaintext when not a secret; null when isSecret (see envelope columns).
    value          String?
    encryptedValue Bytes?
    valueNonce     Bytes?
    valueKeyId     String?
    createdAt      DateTime @default(now())
    updatedAt      DateTime @updatedAt

    @@unique([scopeType, scopeId, key])
    @@index([scopeType, scopeId])
}

// Web Application Firewall rules for Deploy. Polymorphic (no FK) scoping like
// EnvVar so one table covers global, project, environment, and application scope,
// resolved nearest-scope-wins. Materialized into each server's edge (Traefik) so
// the rules keep enforcing when the Polaris control plane is down.
model WafRule {
    id           String   @id @default(uuid(7)) @db.Uuid
    // polaris | global | project | environment | application
    scopeType    String
    // "" for the polaris and global scopes; otherwise the Project/Environment/
    // Application id. Not a uuid column because those two carry the empty string.
    scopeId      String
    // JSON string arrays of CIDR/IP, SQLite-portable like FileRequest.allowedCidrs.
    ipAllowlist  String   @default("[]")
    ipDenylist   String   @default("[]")
    requireLogin Boolean  @default(false)
    // Who that login admits and who it refuses, as JSON arrays of
    // {ref:"<type>:<id>", from?, until?} - the principal (user, group or role) and the
    // unix-second window the entry applies in, both bounds optional.
    // Empty allow means any account on the instance, which is what requireLogin meant
    // on its own - so a scope only narrows once somebody names someone here. Allow
    // narrows across scopes the way ipAllowlist does (a visitor must satisfy every
    // scope that named anybody, so a child can restrict a parent and never widen it);
    // deny unions like ipDenylist and wins over any allow.
    loginAllowPrincipals String @default("[]")
    loginDenyPrincipals  String @default("[]")
    // Refuse requests whose headers do not hold together as a browser's. Unions
    // across scopes like requireLogin - it refuses traffic, so a narrower scope
    // cannot switch off a broader one's decision to refuse it.
    browserIntegrity Boolean @default(false)
    // Refuse requests whose URL carries a SQL injection payload, and the same for a
    // cross-site scripting one. Two columns rather than one: the reason a scope has to
    // allow SQL-ish text in a query string is not a reason to also stop refusing script
    // tags. Both intersect across scopes like emailObfuscation rather than unioning like
    // the refusals above: they are on by default, and a default that unions is one no
    // scope can ever get out of. Default true is what makes them on everywhere.
    sqlInjectionProtection Boolean @default(true)
    xssProtection          Boolean @default(true)
    // Rewrite email addresses in served HTML. Intersects across scopes instead of
    // unioning: it rewrites the page rather than refusing it, so any scope can turn
    // it off for what it covers. Default true is what makes it on everywhere.
    emailObfuscation Boolean @default(true)
    // Enabled managed rule packs as a JSON array of ids (see waf-presets.ts). Ids,
    // not their contents: the pack's rules are expanded at the edge, so improving a
    // list ships as a release rather than a migration over everyone's saved rules.
    presets      String   @default("[]")
    // Ordered custom rules as a JSON array (conditions -> block | allow), evaluated
    // first-match-wins after the IP lists.
    rules        String   @default("[]")
    createdAt    DateTime @default(now())
    updatedAt    DateTime @updatedAt

    @@unique([scopeType, scopeId])
    @@index([scopeType, scopeId])
}

/// One address the edge blocks for what it did, rather than for what it claims to
/// be: a jail ban, or an operator's own manual entry.
///
/// Individual entries only, and deliberately so. Bulk feeds (the Tor exit list is a
/// few thousand addresses that turn over daily) live in WafIpFeed as one row each -
/// putting them here would mean thousands of row writes per refresh to represent one
/// list that is always replaced whole.
model WafBan {
    id       String  @id @default(uuid(7)) @db.Uuid
    ip       String  @unique
    /// ban | reputation | manual - mirrors WafIntelReason.
    reason   String
    /// Which jail decided it, the provider that flagged it, or "operator".
    source   String
    note     String?
    /// When it lifts. Null for a manual entry meant to stand until it is removed.
    until    DateTime?
    /// Times this address has been banned, so a repeat offender is held longer.
    offences Int      @default(1)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([until])
}

/// A bulk address list Polaris fetches and republishes to the edge: the Tor exit
/// list today, any other feed later. One row per feed, holding the whole list, so a
/// refresh is one write and a stale feed is one timestamp to look at.
// What a reputation provider last said about one address, whatever it said.
//
// The firewall used to remember only the addresses a provider flagged, because a
// flag becomes a ban and a ban is a row. An address that came back clean left
// nothing behind, so it was "not seen before" on the very next sweep - and the
// sweep runs every thirty seconds over the same log window. Twenty-five lookups a
// pass, twice a minute, forever: the same handful of ordinary visitors, asked
// about seventy thousand times a day. This table is the other half of that
// answer, and it is what makes a lookup something that happens once per address
// rather than once per pass.
//
// `rules` is the deny list the verdict was reached under, so changing what counts
// as bad re-asks rather than serving an answer to a different question.
model AddressReputation {
    ip        String   @id
    provider  String
    allow     Boolean
    reason    String?
    rules     String
    checkedAt DateTime @default(now())

    @@index([checkedAt])
}

// A database somebody opens in the data browser.
//
// Two kinds in one table, told apart by `managedDatabaseId`. One Polaris already
// runs is pointed at rather than copied: its address and its credentials are
// read from the managed row every time, so rotating them or moving the container
// does not leave a saved connection pointing at an address that stopped being
// true. Anything else - a database on somebody's laptop, a managed cloud
// instance, the company's own Postgres - is a host, a port and a secret this row
// holds, envelope-encrypted the same way every other credential in Polaris is.
//
// `readOnly` defaults on. A browser opened on a production database must not be
// one keystroke away from an UPDATE with no WHERE, and the person who wants to
// write has to say so.
model DataConnection {
    id                  String    @id @default(uuid(7)) @db.Uuid
    ownerId             String    @db.Uuid
    name                String
    // postgres | mysql | mariadb | mongo | redis
    engine              String
    // Set when this points at a database Polaris runs. The address and the
    // credentials below are then unused and read from that row instead.
    managedDatabaseId   String?   @db.Uuid
    host                String?
    port                Int?
    database            String?
    username            String?
    // Envelope-encrypted secret (JSON: password).
    encryptedCredential Bytes?
    credentialNonce     Bytes?
    credentialKeyId     String?
    tls                 Boolean   @default(false)
    readOnly            Boolean   @default(true)
    lastUsedAt          DateTime?
    createdAt           DateTime  @default(now())
    updatedAt           DateTime  @updatedAt

    owner   User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
    // Losing the database it points at takes the shortcut with it: what is left
    // is a name and an address that answers nothing.
    managed ManagedDatabase? @relation(fields: [managedDatabaseId], references: [id], onDelete: Cascade)

    @@index([ownerId])
    @@index([managedDatabaseId])
}
model WafIpFeed {
    /// Feed id ("tor").
    id        String   @id
    /// The addresses, as a JSON string array.
    entries   String   @default("[]")
    /// Whether the operator has this feed switched on.
    enabled   Boolean  @default(false)
    /// When it was last fetched successfully, so staleness is visible.
    fetchedAt DateTime?
    /// Why the last refresh failed, if it did.
    error     String?
    updatedAt DateTime @updatedAt
}

model Volume {
    id            String   @id @default(uuid(7)) @db.Uuid
    targetId      String   @db.Uuid
    applicationId String?  @db.Uuid
    name          String
    mountPath     String
    // volume | bind | nas
    kind          String   @default("volume")
    // For "volume": the named-volume name. For "bind": a subpath confined under
    // the host volume root. For "nas": a subpath confined under the storage
    // connection's mount (the connection id is prefixed when the plan is built).
    source        String?
    // Storage connection backing a "nas" volume; null for volume/bind.
    connectionId  String?  @db.Uuid
    // Optional human-readable size cap (e.g. "10G"); null for unlimited.
    sizeLimit     String?
    createdAt     DateTime @default(now())

    target      DeployTarget       @relation(fields: [targetId], references: [id], onDelete: Cascade)
    application Application?       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
    connection  StorageConnection? @relation(fields: [connectionId], references: [id], onDelete: Restrict)

    @@index([applicationId])
    @@index([targetId])
    @@index([connectionId])
}

// One-shot bearer ticket for a terminal/logs WebSocket. The client presents the
// raw token (hashed here) over Sec-WebSocket-Protocol; the sidecar burns it once.
model DeployTicket {
    id           String    @id @default(uuid(7)) @db.Uuid
    tokenHash    String    @unique
    userId       String    @db.Uuid
    targetId     String    @db.Uuid
    // Container id/name (or a host marker) the ticket authorizes.
    containerRef String
    // terminal | logs
    mode         String    @default("terminal")
    expiresAt    DateTime
    usedAt       DateTime?
    createdAt    DateTime  @default(now())

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
}

// ---------------------------------------------------------------------------
// Metrics (time-series consumption history)
// ---------------------------------------------------------------------------

// One raw consumption sample for a subject: a deployed Application container or a
// Drive StorageConnection (a NAS/server). Kept a short window at full resolution
// then folded into MetricRollup, so raw growth stays bounded. Percentages are
// derived at read time from the byte columns - never stored. subjectId is a
// polymorphic reference (no FK) resolved by subjectType. The natural composite
// key (subject + timestamp) is the query index and enforces one sample per tick;
// it is not an enumerable integer, so the UUID-id rule does not apply here.
model MetricSample {
    // app | storage
    subjectType    String
    subjectId      String   @db.Uuid
    ts             DateTime @default(now())
    cpuPercent     Float?
    cpuTempC       Float?
    memUsedBytes   BigInt?
    memTotalBytes  BigInt?
    diskUsedBytes  BigInt?
    diskTotalBytes BigInt?
    // Bytes over the container's interfaces since it started, in each direction.
    // Counters, not rates: a rate needs two readings and the gap between them,
    // and only the reader knows which two it is drawing. A restart resets them,
    // which the reader sees as a fall and treats as a gap rather than as traffic.
    netRxBytes     BigInt?
    netTxBytes     BigInt?

    @@id([subjectType, subjectId, ts])
    @@index([ts])
}

// Hourly aggregate of MetricSample rows, retained far longer than raw so the
// 7d/30d (and wider) ranges read a compact table instead of scanning raw. The
// avg columns are the charted line; cpuPercentMax preserves spikes that
// averaging would hide. `samples` is how many raw points were folded in.
model MetricRollup {
    subjectType       String
    subjectId         String   @db.Uuid
    // Start of the UTC hour bucket this row aggregates.
    bucket            DateTime
    cpuPercentAvg     Float?
    cpuPercentMax     Float?
    cpuTempCAvg       Float?
    memUsedBytesAvg   BigInt?
    memTotalBytesAvg  BigInt?
    diskUsedBytesAvg  BigInt?
    diskTotalBytesAvg BigInt?
    // Bytes actually moved during this hour, which is a total rather than an
    // average: the raw columns behind it are counters, so what an hour is worth
    // is how far they advanced inside it.
    netRxBytesSum     BigInt?
    netTxBytesSum     BigInt?
    samples           Int      @default(0)

    @@id([subjectType, subjectId, bucket])
    @@index([bucket])
}

// ---------------------------------------------------------------------------
// Watch (monitoring and alerting)
// ---------------------------------------------------------------------------

// A CloudWatch-style alarm: a condition over a target's metric or reachability
// that fires events (and notifications) on state transitions. owner/target are
// bare uuids (no FK), so an alarm can watch any subject without coupling.
model Alarm {
    id              String    @id @default(uuid(7)) @db.Uuid
    ownerId         String    @db.Uuid
    name            String
    // application | domain | host
    targetType      String
    targetId        String    @db.Uuid
    // cpu | memory | http | service - http/service are reachability (no threshold).
    metric          String
    // gt | lt, for threshold metrics.
    operator        String    @default("gt")
    // Threshold as a percent for cpu/memory; null for reachability alarms.
    threshold       Float?
    // Consecutive breaching evaluations before firing, to ride out blips.
    forPeriods      Int       @default(2)
    enabled         Boolean   @default(true)
    // ok | alarm | insufficient
    state           String    @default("insufficient")
    // Breaches counted so far toward forPeriods.
    breachStreak    Int       @default(0)
    lastEvaluatedAt DateTime?
    // Optional messaging channel + peer to also notify when the alarm fires.
    notifyChannelId String?   @db.Uuid
    notifyPeerId    String?
    createdAt       DateTime  @default(now())
    updatedAt       DateTime  @updatedAt

    events AlarmEvent[]

    @@index([ownerId])
    @@index([enabled])
    @@index([targetType, targetId])
}

// A state transition of an alarm - the event log Watch generates (fired/cleared).
model AlarmEvent {
    id        String   @id @default(uuid(7)) @db.Uuid
    alarmId   String   @db.Uuid
    // triggered | resolved
    kind      String
    // The value that caused it (percent) for a metric alarm.
    value     Float?
    detail    String?
    createdAt DateTime @default(now())

    alarm Alarm @relation(fields: [alarmId], references: [id], onDelete: Cascade)

    @@index([alarmId, createdAt])
}
// ---------------------------------------------------------------------------
// Organizations and teams
// ---------------------------------------------------------------------------

// An account that belongs to a group of people rather than to one person, in the
// shape GitHub made familiar: it has a handle, it has members, and the work it
// owns outlives whoever created it.
//
// It is deliberately not a second kind of `User`. Nobody signs in as an
// organization - there is no password, no session and no permission set on it -
// so none of the authentication surface has to learn about it. It owns things
// and it holds a roster, and that is all.
//
// Whether an instance offers organizations at all, who may create one, and how
// large they may get are administrator settings rather than schema (see
// ORGANIZATION_POLICY in @polaris/core).
model Organization {
    id          String   @id @default(uuid(7)) @db.Uuid
    // The handle in URLs. Unique across the instance and refused when it collides
    // with an account username, so /o/acme can never be ambiguous with a person.
    slug        String   @unique
    name        String
    description String   @default("")
    // Uploaded avatar, resolved the same way an account's is.
    image       String?
    // The account that answers for it. Never also a member row, so removing every
    // member cannot leave an organization nobody can administer. Ownership moves
    // by writing this column, which is what a transfer does.
    ownerId     String   @db.Uuid
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    owner       User                     @relation("OrganizationOwner", fields: [ownerId], references: [id], onDelete: Cascade)
    members     OrganizationMember[]
    invitations OrganizationInvitation[]
    teams    Team[]
    roles    OrgRole[]
    spaces   TaskSpace[]
    chatSpaces ChatSpace[]
    projects Project[]
    domains  OwnerDomain[]
    avatar   OrganizationAvatar?
    vault    VaultOrganization?

    @@index([ownerId])
}

// One organization's photo, kept exactly as an account's is: the bytes live on
// whichever storage the instance sends uploads to, and this row says where.
//
// Separate from Organization.image, which holds a URL somewhere else if one was
// ever set. An upload always wins over it, so the two never disagree about what
// is on screen.
model OrganizationAvatar {
    orgId        String   @id @db.Uuid
    // Null when the bytes are on the disk Polaris runs on.
    connectionId String?
    path         String
    mime         String
    size         Int      @default(0)
    updatedAt    DateTime @updatedAt

    org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

// What one of an organization's roles may do.
//
// Rows rather than a fixed ladder because "admin" means something different in a
// studio, a company and a household, and the people running one should not have
// to bend their vocabulary to ours. Every organization is seeded with `admin` and
// `member` so it works before anybody opens the roles screen; both are marked
// system, so neither can be deleted while a membership may still name it.
//
// A membership stores the slug, not the id: an organization that renames a role
// keeps its roster intact, and the two seeded slugs are exactly the values every
// row written before this table existed already holds.
model OrgRole {
    id          String   @id @default(uuid(7)) @db.Uuid
    orgId       String   @db.Uuid
    slug        String
    name        String
    description String   @default("")
    // JSON array of org permission keys, or ["*"] on the seeded admin. Stored as
    // a string like the instance's own roles; validated by @polaris/core on read.
    permissions String   @default("[]")
    // Seeded by Polaris. Cannot be deleted, and `admin` cannot be edited either.
    system      Boolean  @default(false)
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

    @@unique([orgId, slug])
    @@index([orgId])
}

// A domain somebody brought themselves, for their own deployed services.
//
// Exactly one of userId and orgId is set: a domain belongs to one person or to
// one organization, never to both and never to the instance - the operator's own
// zones are configuration, live in Settings, and are what the dashboard itself is
// reached on. Nothing here can move that.
//
// Verified in two independent steps, and both matter. The TXT record proves the
// person adding it controls the domain, which is what stops somebody claiming a
// name they do not own and being handed certificates for it. The wildcard record
// proves traffic for it arrives here, which is what makes a minted hostname
// actually answer. A domain with the first and not the second is understood but
// not yet usable, and the screen says which is missing.
model OwnerDomain {
    id           String    @id @default(uuid(7)) @db.Uuid
    userId       String?   @db.Uuid
    orgId        String?   @db.Uuid
    // The registrable domain or the subdomain it is delegated to, normalized:
    // no scheme, no wildcard prefix, no port, lowercase.
    domain       String    @unique
    // Published by the owner as a TXT record at _polaris.<domain>. Random, and
    // regenerated when the domain is re-added, so an old record cannot re-verify.
    verifyToken  String
    verifiedAt   DateTime?
    // Whether *.domain was last seen resolving to this instance. Kept apart from
    // verifiedAt: ownership is proven once, reachability is a live fact.
    wildcardOk   Boolean   @default(false)
    checkedAt    DateTime?
    // Why the last check said what it did, in a sentence the owner can act on.
    checkDetail  String?
    createdAt    DateTime  @default(now())
    updatedAt    DateTime  @updatedAt

    user User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
    org  Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)

    @@index([userId])
    @@index([orgId])
}

// Somebody other than the owner on an organization's roster.
//
// Membership on its own reaches no work, exactly as being in a GitHub
// organization hands you no repositories: it puts somebody on the roster and
// makes them available to teams. What opens a space is a team grant, a direct
// space membership, or running the organization that owns it.
model OrganizationMember {
    id        String   @id @default(uuid(7)) @db.Uuid
    orgId     String   @db.Uuid
    userId    String   @db.Uuid
    // member | admin - see ORG_ROLES in @polaris/core. An admin runs the roster,
    // the teams and the organization's spaces; only the owner can rename it,
    // transfer it, or delete it.
    role      String   @default("member")
    createdAt DateTime @default(now())

    org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
    user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([orgId, userId])
    @@index([userId])
}

// Somebody asked to join an organization, waiting on their answer.
//
// Being added to a group is not something that should happen to a person. An
// organization's roster is published to everybody on it - who you work with,
// under what role - and appearing on one you never agreed to join is both a
// surprise and a disclosure. So the row here is the ask, and the membership is
// only written when the person accepts, the same way GitHub has always done it.
//
// The row IS the pending state: accepting deletes it and writes a membership,
// declining and revoking delete it. There is no `status` column, because a
// stored "no" is a thing somebody has to clean up and it would stop the same
// person ever being asked again.
//
// It names an account rather than an address. Polaris only ever adds people who
// already have one here, and storing the address would put a copy of the very
// thing the privacy settings withhold on a row any admin of the organization can
// read.
model OrganizationInvitation {
    id          String   @id @default(uuid(7)) @db.Uuid
    orgId       String   @db.Uuid
    userId      String   @db.Uuid
    // The role they take on if they accept - checked again then, since the
    // organization may have deleted it in the meantime.
    role        String   @default("member")
    invitedById String   @db.Uuid
    // Invitations go stale. One that has sat unanswered for a fortnight is a
    // decision somebody made by not making it, and it must not still be usable
    // a year later when the roster means something else entirely.
    expiresAt   DateTime
    createdAt   DateTime @default(now())

    org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
    user      User         @relation("OrganizationInvitee", fields: [userId], references: [id], onDelete: Cascade)
    invitedBy User         @relation("OrganizationInviter", fields: [invitedById], references: [id], onDelete: Cascade)

    @@unique([orgId, userId])
    @@index([userId])
}

// A named subset of an organization's members, so access is granted to "the
// design team" rather than to seven people who then drift apart from one
// another. Adding somebody to the team is what gives them everything it reaches.
model Team {
    id           String   @id @default(uuid(7)) @db.Uuid
    orgId        String   @db.Uuid
    // Unique within its organization, so two organizations may both have `core`.
    slug         String
    name         String
    description  String   @default("")
    createdAt    DateTime @default(now())
    updatedAt    DateTime @updatedAt

    org          Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
    members      TeamMember[]
    spaceGrants  TaskSpaceTeam[]
    folderGrants TaskFolderTeam[]

    @@unique([orgId, slug])
    @@index([orgId])
}

// Somebody on a team. A maintainer may add and remove that team's own people
// without administering the whole organization, which is what lets a team lead
// run their team.
model TeamMember {
    teamId String @db.Uuid
    userId String @db.Uuid
    // member | maintainer - see TEAM_ROLES in @polaris/core.
    role   String @default("member")

    team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@id([teamId, userId])
    @@index([userId])
}

// A team's access to a whole space, and the role everybody on it gets there.
// Read exactly as a personal space membership is, and where somebody has both
// the stronger one wins.
model TaskSpaceTeam {
    id        String   @id @default(uuid(7)) @db.Uuid
    spaceId   String   @db.Uuid
    teamId    String   @db.Uuid
    // guest | member | admin - the same vocabulary a personal membership uses.
    role      String   @default("member")
    createdAt DateTime @default(now())

    space TaskSpace @relation(fields: [spaceId], references: [id], onDelete: Cascade)
    team  Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)

    @@unique([spaceId, teamId])
    @@index([teamId])
}

// A team's access to one branch of a space, inherited downwards the way a
// personal folder grant is. This is how one project inside a shared space is
// handed to the team that works it, without opening the rest of the space.
model TaskFolderTeam {
    id        String   @id @default(uuid(7)) @db.Uuid
    folderId  String   @db.Uuid
    teamId    String   @db.Uuid
    role      String   @default("member")
    createdAt DateTime @default(now())

    folder TaskFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)
    team   Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)

    @@unique([folderId, teamId])
    @@index([teamId])
}

// ---------------------------------------------------------------------------
// Tasks (work management)
// ---------------------------------------------------------------------------

// The top of the work hierarchy: Space > Folder > List > Task > Subtask. A space
// owns the vocabulary its lists share - statuses, tags, custom fields, sprints -
// so two teams on one instance can run different processes without negotiating a
// single global set of columns.
//
// `prefix` and `taskCounter` produce the reference people quote ("ENG-42"). The
// prefix is fixed when the space is created and unique across the instance, so a
// reference written in a commit message still resolves after a rename.
model TaskSpace {
    id          String   @id @default(uuid(7)) @db.Uuid
    ownerId     String   @db.Uuid
    // The organization this space belongs to, or null for a personal one. An
    // organization's space is reachable by whoever runs that organization and by
    // the teams granted it, and outlives its creator leaving; a personal space is
    // its owner's and whoever they added.
    orgId       String?  @db.Uuid
    name        String
    prefix      String   @unique
    description String   @default("")
    color       String   @default("#7c5cff")
    // private | internal - see SPACE_VISIBILITIES in @polaris/core. On an
    // organization's space `internal` means everybody on that roster rather than
    // everybody on the instance.
    visibility  String   @default("private")
    archived    Boolean  @default(false)
    order       Float    @default(1024)
    // Highest number handed out so far. Never decremented, so a deleted task
    // does not hand its reference to the next one.
    taskCounter Int      @default(0)
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    owner       User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
    org         Organization?     @relation(fields: [orgId], references: [id], onDelete: Cascade)
    members     TaskSpaceMember[]
    teamGrants  TaskSpaceTeam[]
    folders     TaskFolder[]
    lists       TaskList[]
    statuses    TaskStatus[]
    tags        TaskTag[]
    fields      TaskCustomField[]
    tasks       Task[]
    sprints     TaskSprint[]
    goals       TaskGoal[]
    docs        TaskDoc[]
    views       TaskView[]
    automations TaskAutomation[]
    templates   TaskTemplate[]
    forms       TaskForm[]

    @@index([ownerId])
    @@index([orgId])
}

// Somebody other than the owner who may reach a space. The owner is never a row
// here, so removing every member cannot lock the space away from its creator.
model TaskSpaceMember {
    id        String   @id @default(uuid(7)) @db.Uuid
    spaceId   String   @db.Uuid
    userId    String   @db.Uuid
    // guest | member | admin - see SPACE_ROLES in @polaris/core.
    role      String   @default("member")
    createdAt DateTime @default(now())

    space TaskSpace @relation(fields: [spaceId], references: [id], onDelete: Cascade)
    user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([spaceId, userId])
    @@index([userId])
}

// An optional middle layer that groups lists, and other folders. The nesting is
// what lets one space hold the arrangement people already think in - a client,
// then a project inside that client, then that project's lists - without paying
// a whole space per client. Deleting a folder keeps what was inside it and
// lifts it to the folder's own parent, because a folder is an arrangement
// rather than an owner of the work inside it.
model TaskFolder {
    id        String   @id @default(uuid(7)) @db.Uuid
    spaceId   String   @db.Uuid
    parentId  String?  @db.Uuid
    name      String
    order     Float    @default(1024)
    archived  Boolean  @default(false)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    space    TaskSpace          @relation(fields: [spaceId], references: [id], onDelete: Cascade)
    parent   TaskFolder?        @relation("TaskFolderNesting", fields: [parentId], references: [id], onDelete: Cascade)
    children TaskFolder[]       @relation("TaskFolderNesting")
    lists      TaskList[]
    docs       TaskDoc[]
    sprints    TaskSprint[]
    members    TaskFolderMember[]
    teamGrants TaskFolderTeam[]

    @@index([spaceId])
    @@index([parentId])
}

// Somebody granted access to one branch of a space rather than to all of it.
// This is how a client is given their own folder, or a contractor a single
// project, without being shown every other client sitting in the same space. A
// grant reaches everything under the folder it names and nothing beside it, the
// strongest grant on the chain wins, and a space-level role is never reduced by
// one.
model TaskFolderMember {
    id        String   @id @default(uuid(7)) @db.Uuid
    folderId  String   @db.Uuid
    userId    String   @db.Uuid
    // guest | member | admin - the same vocabulary a space membership uses, so
    // one role means one thing wherever it was granted.
    role      String   @default("member")
    createdAt DateTime @default(now())

    folder TaskFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)
    user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([folderId, userId])
    @@index([userId])
}

// Where tasks live. A task cannot exist outside a list, which is what makes the
// list the unit that owns views, automations and intake forms.
model TaskList {
    id          String    @id @default(uuid(7)) @db.Uuid
    spaceId     String    @db.Uuid
    folderId    String?   @db.Uuid
    name        String
    description String    @default("")
    color       String?
    startDate   DateTime?
    dueDate     DateTime?
    order       Float     @default(1024)
    archived    Boolean   @default(false)
    createdAt   DateTime  @default(now())
    updatedAt   DateTime  @updatedAt

    space       TaskSpace        @relation(fields: [spaceId], references: [id], onDelete: Cascade)
    folder      TaskFolder?      @relation(fields: [folderId], references: [id], onDelete: SetNull)
    tasks       Task[]
    views       TaskView[]
    automations TaskAutomation[]
    forms       TaskForm[]
    goalTargets TaskGoalTarget[]

    @@index([spaceId])
    @@index([folderId])
}

// A named workflow stage. Statuses belong to the space rather than to each list:
// a board people move work across has to mean the same thing in every list, and
// per-list overrides are how a workspace ends up with nine spellings of "Done".
model TaskStatus {
    id        String   @id @default(uuid(7)) @db.Uuid
    spaceId   String   @db.Uuid
    name      String
    // See TASK_STATUS_TYPES in @polaris/core: open | active | blocked | done |
    // closed - the kind the product reasons about, so "is this finished" and
    // "is this held up" never depend on the name somebody typed.
    type      String   @default("open")
    color     String   @default("#64748b")
    order     Float    @default(1024)
    createdAt DateTime @default(now())

    space TaskSpace @relation(fields: [spaceId], references: [id], onDelete: Cascade)
    tasks Task[]

    @@index([spaceId])
}

// A cross-cutting label. Space-scoped so one team's labels do not leak into
// another team's tag picker.
model TaskTag {
    id        String   @id @default(uuid(7)) @db.Uuid
    spaceId   String   @db.Uuid
    name      String
    color     String   @default("#7c5cff")
    createdAt DateTime @default(now())

    space TaskSpace     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
    tasks TaskTagLink[]

    @@unique([spaceId, name])
}

// A column a space adds to its tasks. `config` is the per-type settings as
// stringified JSON (options, bounds, currency); see customFieldConfigSchema.
model TaskCustomField {
    id         String   @id @default(uuid(7)) @db.Uuid
    spaceId    String   @db.Uuid
    name       String
    // See CUSTOM_FIELD_TYPES in @polaris/core.
    type       String
    config     String   @default("{}")
    required   Boolean  @default(false)
    // Shown on the card and in the table without opening the task.
    showOnCard Boolean  @default(false)
    order      Float    @default(1024)
    createdAt  DateTime @default(now())

    space  TaskSpace              @relation(fields: [spaceId], references: [id], onDelete: Cascade)
    values TaskCustomFieldValue[]

    @@index([spaceId])
}

// One work item.
//
// `spaceId` is carried alongside `listId` rather than being reached through it:
// the reference counter, the tag and custom-field vocabulary, and every
// cross-list view are all space-scoped, and joining through the list on each of
// those reads costs more than one column. A task therefore moves freely between
// lists in its space and never between spaces, which is also what keeps its
// reference stable.
model Task {
    id           String    @id @default(uuid(7)) @db.Uuid
    spaceId      String    @db.Uuid
    listId       String    @db.Uuid
    parentId     String?   @db.Uuid
    // Per-space sequential, rendered with the space prefix as "ENG-42".
    number       Int
    name         String
    description  String    @default("")
    statusId     String?   @db.Uuid
    // urgent | high | normal | low | none.
    priority     String    @default("none")
    startDate    DateTime?
    dueDate      DateTime?
    // Whether the dates carry a time of day. An all-day task is due at the end
    // of its day, which is what decides when it turns overdue.
    timed        Boolean   @default(false)
    // Minutes.
    timeEstimate Int?
    points       Int?
    milestone    Boolean   @default(false)
    order        Float     @default(1024)
    archived     Boolean   @default(false)
    // Stamped when the task first reaches a done/closed status, and cleared if
    // it is reopened, so a burndown has a real date to count against.
    completedAt  DateTime?
    sprintId     String?   @db.Uuid
    // Recurrence rule as stringified JSON; see recurrenceSchema in @polaris/core.
    recurrence   String?
    // Work somebody has said is held up, beyond the dependency edges below. A
    // date lifts its own block when it passes; a note holds until it is cleared.
    // Either one marks the task blocked, and so does an unfinished blocker.
    blockedUntil DateTime?
    blockedNote  String    @default("")
    // No FK: the trail outlives the account that created the task.
    createdById  String?   @db.Uuid
    createdAt    DateTime  @default(now())
    updatedAt    DateTime  @updatedAt

    space       TaskSpace              @relation(fields: [spaceId], references: [id], onDelete: Cascade)
    list        TaskList               @relation(fields: [listId], references: [id], onDelete: Cascade)
    parent      Task?                  @relation("TaskSubtasks", fields: [parentId], references: [id], onDelete: Cascade)
    subtasks    Task[]                 @relation("TaskSubtasks")
    status      TaskStatus?            @relation(fields: [statusId], references: [id], onDelete: SetNull)
    sprint      TaskSprint?            @relation(fields: [sprintId], references: [id], onDelete: SetNull)
    assignees   TaskAssignee[]
    tags        TaskTagLink[]
    fieldValues TaskCustomFieldValue[]
    checklists  TaskChecklist[]
    blocking    TaskDependency[]       @relation("TaskBlocker")
    blockedBy   TaskDependency[]       @relation("TaskBlocked")
    timeEntries TaskTimeEntry[]
    reminders   TaskReminder[]
    submissions TaskFormSubmission[]
    attachments TaskAttachment[]
    commits     TaskCommit[]
    share       TaskShare?

    @@unique([spaceId, number])
    @@index([listId])
    @@index([spaceId, archived])
    @@index([statusId])
    @@index([parentId])
    @@index([sprintId])
    @@index([dueDate])
}

// Who is doing the work. More than one person can be, which is why this is a
// table and not a column.
model TaskAssignee {
    taskId String @db.Uuid
    userId String @db.Uuid

    task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@id([taskId, userId])
    @@index([userId])
}

// Who is told when it changes, without being asked to do it.
// Somebody who wants to hear about something. Any something: a task, a service,
// a server.
//
// Addressed by subject the way Activity and Comment are, and for the same
// reason - "who hears about this" was a question only a task could answer, so
// the answer for a service was everybody with the permission, or nobody.
//
// `reason` records how they came to be following, which is what lets a screen
// say "you are following this because you commented" rather than leaving
// somebody to wonder why they are being told. It has no effect on delivery.
model Follow {
    subjectType String
    subjectId   String   @db.Uuid
    userId      String   @db.Uuid
    // explicit | commented | assigned | created
    reason      String   @default("explicit")
    createdAt   DateTime @default(now())

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@id([subjectType, subjectId, userId])
    @@index([userId])
    @@index([subjectType, subjectId])
}

model TaskTagLink {
    taskId String @db.Uuid
    tagId  String @db.Uuid

    task Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
    tag  TaskTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

    @@id([taskId, tagId])
    @@index([tagId])
}

// One custom-field answer. Always a string: the field's type decides how it is
// read, which keeps this table one shape however many types exist.
model TaskCustomFieldValue {
    taskId  String @db.Uuid
    fieldId String @db.Uuid
    value   String

    task  Task            @relation(fields: [taskId], references: [id], onDelete: Cascade)
    field TaskCustomField @relation(fields: [fieldId], references: [id], onDelete: Cascade)

    @@id([taskId, fieldId])
    @@index([fieldId])
}

// A comment, or a reply to one. A comment can be handed to somebody as an action
// item and resolved when it is dealt with, so feedback does not need a task of
// its own to be tracked.
//
// Addressed by subject the same way Activity is, and for the same reason: a
// server that keeps failing and a deploy somebody rolled back are things there
// is something to say about, and a foreign key to a task is what stopped anybody
// saying it. Nothing cascades from the subject - `lib/comments` has `forget`,
// and whatever deletes a subject calls it. Replies still cascade from their
// parent, which is a relation this table does have.
model Comment {
    id           String    @id @default(uuid(7)) @db.Uuid
    // task | app | host - CommentSubject in lib/comments. The schema's words,
    // the same ones MetricSample uses: an `app` is a service, a `host` a server.
    subjectType  String
    subjectId    String    @db.Uuid
    parentId     String?   @db.Uuid
    userId       String?   @db.Uuid
    body         String
    // No FKs: both are display references that must survive the account leaving.
    assignedToId String?   @db.Uuid
    resolvedById String?   @db.Uuid
    resolvedAt   DateTime?
    createdAt    DateTime  @default(now())
    updatedAt    DateTime  @updatedAt

    user    User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
    parent  Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
    replies Comment[] @relation("CommentReplies")

    @@index([subjectType, subjectId, createdAt])
    @@index([parentId])
}

// A named group of steps inside one task. Steps are not tasks: they have no
// status, no dates and no reference, which is the whole point of having both.
model TaskChecklist {
    id        String   @id @default(uuid(7)) @db.Uuid
    taskId    String   @db.Uuid
    name      String
    order     Float    @default(1024)
    createdAt DateTime @default(now())

    task  Task                @relation(fields: [taskId], references: [id], onDelete: Cascade)
    items TaskChecklistItem[]

    @@index([taskId])
}

model TaskChecklistItem {
    id          String    @id @default(uuid(7)) @db.Uuid
    checklistId String    @db.Uuid
    name        String
    done        Boolean   @default(false)
    doneAt      DateTime?
    // No FK: a display reference that survives the account leaving.
    assigneeId  String?   @db.Uuid
    order       Float     @default(1024)
    createdAt   DateTime  @default(now())

    checklist TaskChecklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)

    @@index([checklistId])
}

// A directed edge. Only one direction is ever stored, so a dependency cannot
// disagree with itself; "waiting on" is the same row read from the other end.
model TaskDependency {
    id        String   @id @default(uuid(7)) @db.Uuid
    // The task that has to finish first.
    blockerId String   @db.Uuid
    // The task held up by it.
    blockedId String   @db.Uuid
    // blocks | relates - `relates` carries no scheduling meaning.
    type      String   @default("blocks")
    createdAt DateTime @default(now())

    blocker Task @relation("TaskBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
    blocked Task @relation("TaskBlocked", fields: [blockedId], references: [id], onDelete: Cascade)

    @@unique([blockerId, blockedId, type])
    @@index([blockedId])
}

// A stretch of tracked time. A running timer is a row with no `endedAt`; there
// can be at most one of those per person, which the service enforces so a second
// start stops the first rather than double-counting the hour.
model TaskTimeEntry {
    id        String    @id @default(uuid(7)) @db.Uuid
    taskId    String    @db.Uuid
    userId    String    @db.Uuid
    startedAt DateTime  @default(now())
    endedAt   DateTime?
    // Seconds. Written when the timer stops, or straight away for a manual entry.
    seconds   Int       @default(0)
    note      String    @default("")
    billable  Boolean   @default(false)
    createdAt DateTime  @default(now())

    task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([taskId])
    @@index([userId, startedAt])
}

// What changed on a task, for the history panel. `userId` carries no FK so the
// trail survives an account being deleted.
// One line of what happened to something, for any something.
//
// The subject is a name and an id rather than a relation, because a foreign key
// per kind is a column this table would grow every time an app is added, and
// seven apps that each want a history is how Polaris ended up with one that only
// tasks had. The cost of that choice is that nothing cascades: whatever deletes
// a subject calls `forgetActivity` for it, and `lib/activity` is the only place
// that writes here so there is one list of callers to check.
//
// `userId` carries no foreign key on purpose. History outlives the account that
// made it - "who archived this" is still the answer after they leave - so the id
// is kept and the name is looked up when the feed is read.
model Activity {
    id          String   @id @default(uuid(7)) @db.Uuid
    // task | app | host - ActivitySubject in lib/activity. The schema's words,
    // the same ones MetricSample uses: an `app` is a service, a `host` a server.
    subjectType String
    subjectId   String   @db.Uuid
    userId      String?  @db.Uuid
    // created | status | priority | assignee | due | moved | archived | ...
    action      String
    // Human-readable endpoints of the change, already resolved to names so the
    // history does not have to look up a deleted status to render a line.
    fromValue   String?
    toValue     String?
    createdAt   DateTime @default(now())

    @@index([subjectType, subjectId, createdAt])
    @@index([userId, createdAt])
}

// A saved way of looking at work: which tasks, grouped how, sorted how. Bound to
// a list or to a space (a space view spans every list in it). A private view
// belongs to its author; a shared one belongs to the list.
model TaskView {
    id            String   @id @default(uuid(7)) @db.Uuid
    ownerId       String   @db.Uuid
    listId        String?  @db.Uuid
    spaceId       String?  @db.Uuid
    name          String
    // list | board | table | calendar | gantt.
    type          String   @default("list")
    groupBy       String   @default("status")
    sortField     String   @default("priority")
    sortDirection String   @default("asc")
    // Stringified JSON; see taskFilterSchema in @polaris/core.
    filter        String   @default("{}")
    // Stringified JSON array of column ids for the table view.
    columns       String   @default("[]")
    showSubtasks  Boolean  @default(true)
    showClosed    Boolean  @default(false)
    shared        Boolean  @default(true)
    order         Float    @default(1024)
    createdAt     DateTime @default(now())
    updatedAt     DateTime @updatedAt

    owner User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
    list  TaskList?  @relation(fields: [listId], references: [id], onDelete: Cascade)
    space TaskSpace? @relation(fields: [spaceId], references: [id], onDelete: Cascade)

    @@index([listId])
    @@index([spaceId])
    @@index([ownerId])
}

// A time-boxed run of work. Tasks point at a sprint rather than living in one,
// so moving work in and out never changes which list it belongs to.
model TaskSprint {
    id        String   @id @default(uuid(7)) @db.Uuid
    spaceId   String   @db.Uuid
    // The folder whose work this sprint plans. Null is a sprint the whole space
    // runs, which is what every sprint was before folders could nest.
    folderId  String?  @db.Uuid
    name      String
    goal      String   @default("")
    startDate DateTime
    endDate   DateTime
    // planned | active | completed.
    status    String   @default("planned")
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    space  TaskSpace   @relation(fields: [spaceId], references: [id], onDelete: Cascade)
    folder TaskFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
    tasks  Task[]

    @@index([spaceId])
    @@index([folderId])
}

// An objective measured by one or more targets. A `tasks` target counts finished
// work in the list it watches and needs no manual update; every other type is a
// number somebody keeps current.
model TaskGoal {
    id          String    @id @default(uuid(7)) @db.Uuid
    ownerId     String    @db.Uuid
    spaceId     String?   @db.Uuid
    name        String
    description String    @default("")
    dueDate     DateTime?
    color       String    @default("#7c5cff")
    archived    Boolean   @default(false)
    completedAt DateTime?
    createdAt   DateTime  @default(now())
    updatedAt   DateTime  @updatedAt

    owner   User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
    space   TaskSpace?       @relation(fields: [spaceId], references: [id], onDelete: SetNull)
    targets TaskGoalTarget[]

    @@index([ownerId])
    @@index([spaceId])
}

model TaskGoalTarget {
    id           String   @id @default(uuid(7)) @db.Uuid
    goalId       String   @db.Uuid
    name         String
    // number | currency | percent | boolean | tasks.
    type         String   @default("number")
    startValue   Float    @default(0)
    targetValue  Float    @default(100)
    currentValue Float    @default(0)
    unit         String   @default("")
    // Only for `tasks` targets: the list whose finished work is counted.
    listId       String?  @db.Uuid
    order        Float    @default(1024)
    createdAt    DateTime @default(now())

    goal TaskGoal  @relation(fields: [goalId], references: [id], onDelete: Cascade)
    list TaskList? @relation(fields: [listId], references: [id], onDelete: SetNull)

    @@index([goalId])
    @@index([listId])
}

// A rule: when this happens to a task that looks like this, do these things.
// Conditions reuse the saved-view filter, so "only urgent bugs" means the same
// to a rule as it does to a view the reader already understands.
model TaskAutomation {
    id          String    @id @default(uuid(7)) @db.Uuid
    spaceId     String    @db.Uuid
    // Null means the rule covers every list in the space.
    listId      String?   @db.Uuid
    name        String
    // See AUTOMATION_TRIGGERS in @polaris/core.
    trigger     String
    // Stringified JSON: taskFilterSchema and an array of automationActionSchema.
    conditions  String    @default("{}")
    actions     String    @default("[]")
    enabled     Boolean   @default(true)
    runCount    Int       @default(0)
    lastRunAt   DateTime?
    // No FK: the rule outlives whoever wrote it.
    createdById String?   @db.Uuid
    createdAt   DateTime  @default(now())
    updatedAt   DateTime  @updatedAt

    space TaskSpace @relation(fields: [spaceId], references: [id], onDelete: Cascade)
    list  TaskList? @relation(fields: [listId], references: [id], onDelete: Cascade)

    @@index([spaceId])
    @@index([listId])
}

// A task shape worth repeating, stored as the payload a new task is built from
// (subtasks and checklists included).
model TaskTemplate {
    id          String   @id @default(uuid(7)) @db.Uuid
    spaceId     String   @db.Uuid
    name        String
    // Stringified JSON; see taskTemplateSchema in @polaris/core.
    payload     String   @default("{}")
    createdById String?  @db.Uuid
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    space TaskSpace @relation(fields: [spaceId], references: [id], onDelete: Cascade)

    @@index([spaceId])
}

// A public intake form that files what it collects as a task in one list. The
// token is the URL, so it is random and revoked by deleting the form.
model TaskForm {
    id              String   @id @default(uuid(7)) @db.Uuid
    spaceId         String   @db.Uuid
    listId          String   @db.Uuid
    token           String   @unique
    name            String
    intro           String   @default("")
    // Stringified JSON array; see formFieldSchema in @polaris/core.
    fields          String   @default("[]")
    defaultStatusId String?  @db.Uuid
    confirmation    String   @default("")
    requireLogin    Boolean  @default(false)
    enabled         Boolean  @default(true)
    createdById     String?  @db.Uuid
    createdAt       DateTime @default(now())
    updatedAt       DateTime @updatedAt

    space       TaskSpace            @relation(fields: [spaceId], references: [id], onDelete: Cascade)
    list        TaskList             @relation(fields: [listId], references: [id], onDelete: Cascade)
    submissions TaskFormSubmission[]

    @@index([listId])
    @@index([spaceId])
}

// What one person sent through a form, kept alongside the task it opened so an
// answer that was not mapped to a field is never lost.
model TaskFormSubmission {
    id            String   @id @default(uuid(7)) @db.Uuid
    formId        String   @db.Uuid
    taskId        String?  @db.Uuid
    // Stringified JSON object keyed by field id.
    answers       String   @default("{}")
    // No FK: an anonymous submission has no account behind it at all.
    submittedById String?  @db.Uuid
    createdAt     DateTime @default(now())

    form TaskForm @relation(fields: [formId], references: [id], onDelete: Cascade)
    task Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)

    @@index([formId, createdAt])
}

// A personal nudge about one task. Per-user rather than per-task: two people can
// want reminding about the same work at different times.
model TaskReminder {
    id        String    @id @default(uuid(7)) @db.Uuid
    taskId    String    @db.Uuid
    userId    String    @db.Uuid
    remindAt  DateTime
    note      String    @default("")
    sentAt    DateTime?
    createdAt DateTime  @default(now())

    task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId, remindAt])
    @@index([taskId])
}

// A file hanging off a task. Polaris stores the bytes wherever the instance was
// told to put them - a NAS it already has a connection to, or its own disk - and
// keeps only the pointer here, so moving where uploads live never means moving
// rows. `connectionId` is null for the server's own disk; it is not a foreign key
// because a connection can be removed while the file it holds is still described
// here, and a broken pointer says more than a silently deleted attachment.
model TaskAttachment {
    id           String   @id @default(uuid(7)) @db.Uuid
    taskId       String   @db.Uuid
    name         String
    mime         String   @default("application/octet-stream")
    // Bytes. Capped at upload, so an Int is enough and stays JSON-safe.
    size         Int      @default(0)
    connectionId String?
    // Where the bytes are under the chosen storage, relative to its root.
    path         String
    // No FK: the file outlives the account that uploaded it.
    uploadedById String?  @db.Uuid
    createdAt    DateTime @default(now())

    task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

    @@index([taskId])
}

// A commit somebody attached to a task. Stored rather than fetched on read: the
// point of linking one is that the task still says what shipped it long after
// the branch is gone, and a repository that goes private must not blank the
// history of what was done.
model TaskCommit {
    id          String    @id @default(uuid(7)) @db.Uuid
    taskId      String    @db.Uuid
    // "owner/name", as GitHub spells it.
    repository  String
    sha         String
    message     String    @default("")
    url         String
    authorName  String    @default("")
    committedAt DateTime?
    // No FK: the link outlives the account that made it.
    linkedById  String?   @db.Uuid
    createdAt   DateTime  @default(now())

    task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

    @@unique([taskId, repository, sha])
    @@index([taskId])
}

// A document or wiki page. Nests through `parentId`, so a space's knowledge base
// is a tree rather than a flat pile.
model TaskDoc {
    id          String   @id @default(uuid(7)) @db.Uuid
    spaceId     String?  @db.Uuid
    // The folder this page belongs to. Null is a page the whole space shares.
    folderId    String?  @db.Uuid
    parentId    String?  @db.Uuid
    title       String
    // Markdown. Stored as written so it stays portable out of Polaris.
    body        String   @default("")
    icon        String   @default("")
    order       Float    @default(1024)
    archived    Boolean  @default(false)
    // No FKs: a page outlives the account that wrote it.
    createdById String?  @db.Uuid
    updatedById String?  @db.Uuid
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    space    TaskSpace?  @relation(fields: [spaceId], references: [id], onDelete: Cascade)
    folder   TaskFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
    parent   TaskDoc?    @relation("DocTree", fields: [parentId], references: [id], onDelete: Cascade)
    children TaskDoc[]   @relation("DocTree")

    @@index([spaceId])
    @@index([folderId])
    @@index([parentId])
}

// A read-only link to one task for people outside Polaris. At most one per task:
// two live links to the same work is two things to remember to revoke. Turning
// the link off deletes the row, so switching it back on mints a new token and
// whatever was pasted elsewhere stays dead.
//
// The token is stored as written, the way a form's is: it is the whole credential
// and it has to be shown again every time somebody reopens the share dialog.
model TaskShare {
    id     String @id @default(uuid(7)) @db.Uuid
    taskId String @unique @db.Uuid
    token  String @unique
    // Whether the page carries the discussion as well as the work itself.
    showComments Boolean @default(false)
    // How often the link has been opened, so the owner can tell a dead link from
    // one that is being read.
    views        Int      @default(0)
    // No FK: the link outlives the account that created it.
    createdById  String?  @db.Uuid
    createdAt    DateTime @default(now())

    task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Analytics
// ---------------------------------------------------------------------------

/// What is being measured: one deployed service, or Polaris itself.
///
/// A row exists so a site can have a tracker key and a name of its own. Everything
/// else about it - which project it belongs to, which domains answer for it - is
/// already recorded elsewhere and is read from there rather than copied, with the
/// one exception of `hostnames`: the edge log names a host, not an application, and
/// resolving that per line against the domain table would be a query per request.
model AnalyticsSite {
    id        String @id @default(uuid(7)) @db.Uuid
    /// polaris | application
    scopeType String
    /// The application id, or "" for Polaris itself.
    scopeId   String @default("")
    name      String
    /// Hostnames whose edge-log requests belong here, as a JSON string array.
    hostnames String @default("[]")
    /// The key the tracker script carries. Public by nature - it names the site in a
    /// script tag on a page anyone can read - so it grants writing visits and
    /// nothing else, and can be rotated without touching the recorded history.
    publicKey String @unique
    /// Whether the tracker endpoint accepts beats for this site.
    trackerEnabled Boolean @default(false)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    sessions AnalyticsSession[]
    events   AnalyticsEvent[]
    days     AnalyticsDay[]

    @@unique([scopeType, scopeId])
}

/// One visit - one person, one sitting.
///
/// The id is the cookieless session hash, not a surrogate key: salt, site, address
/// and user agent, with the salt rotating daily. That is what makes the id both the
/// natural primary key and unreversible once the day turns over.
///
/// Everything that does not change mid-visit lives here rather than on every event,
/// which is most of the interesting dimensions and the reason the event rows stay
/// narrow.
model AnalyticsSession {
    id         String   @id
    siteId     String   @db.Uuid
    startedAt  DateTime
    lastSeenAt DateTime
    /// Pageviews in this session, for a bounce test that does not need the events.
    views      Int      @default(0)

    /// Kept, where Umami deliberately does not. Polaris already shows addresses in
    /// the firewall, and "who is this and block them" is the reason an operator
    /// opens analytics after seeing a spike. It goes with the rest of the raw row at
    /// the retention window; the daily totals that outlive it hold no address.
    ip             String?
    browser        String
    os             String
    device         String
    country        String?
    language       String?
    screen         String?
    referrerKind   String
    referrerSource String?
    campaign       String?
    medium         String?

    site   AnalyticsSite    @relation(fields: [siteId], references: [id], onDelete: Cascade)
    events AnalyticsEvent[]

    @@index([siteId, startedAt])
    @@index([lastSeenAt])
}

/// A pageview or a custom event.
model AnalyticsEvent {
    id        String   @id @default(uuid(7)) @db.Uuid
    siteId    String   @db.Uuid
    sessionId String
    at        DateTime
    /// pageview | event
    kind      String
    /// The custom event's name. Null for a pageview.
    name      String?
    /// The route, with identifiers grouped, so /post/1 and /post/2 are one row.
    path      String
    /// As requested, when it differs from the grouped route - so a single visit can
    /// still be traced to the exact URL.
    rawPath   String?
    /// Custom event properties, as a JSON string object.
    props     String?

    site    AnalyticsSite    @relation(fields: [siteId], references: [id], onDelete: Cascade)
    session AnalyticsSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

    @@index([siteId, at])
    @@index([sessionId])
    @@index([siteId, kind, at])
}

/// A day of traffic, folded down.
///
/// Raw visits are pruned at the retention window; these are not, so a year-old month
/// is still comparable without keeping a year of rows. One row per dimension value
/// per day, with the total carried as the dimension "total" and an empty value.
///
/// `visitors` is the distinct sessions of that day and does not sum across days -
/// sessions rotate daily, so there is no identity to deduplicate by and pretending
/// otherwise would quietly inflate every multi-day figure. The screen says which it
/// is showing.
model AnalyticsDay {
    id        String   @id @default(uuid(7)) @db.Uuid
    siteId    String   @db.Uuid
    /// UTC midnight.
    day       DateTime
    /// total | path | referrer | channel | browser | os | device | country | event
    dimension String
    /// Empty for the total row.
    value     String   @default("")

    visitors Int @default(0)
    views    Int @default(0)
    /// Sessions that saw exactly one page.
    bounces  Int @default(0)
    /// Summed session length in seconds, over the sessions that had a measurable
    /// one, and how many those were - so the average can be recovered without
    /// storing an average that cannot be re-averaged.
    durationSec Int @default(0)
    measured    Int @default(0)

    site AnalyticsSite @relation(fields: [siteId], references: [id], onDelete: Cascade)

    @@unique([siteId, day, dimension, value])
    @@index([siteId, day])
}

// ---------------------------------------------------------------------------
// Agents (coding agents running against enabled repositories)
// ---------------------------------------------------------------------------

// One repository somebody turned the agent on for.
//
// This is configuration, not derived state: it survives GitHub being briefly
// unreachable, an installation being repaired, and a repository being renamed
// and renamed back. Nothing here is recomputed from the App's installation list,
// which is exactly what stops a transient 502 from quietly disabling a
// repository or resetting the decisions on it.
model AgentRepo {
    id            String   @id @default(uuid(7)) @db.Uuid
    ownerId       String   @db.Uuid
    // "owner/repo". The key every GitHub path, webhook payload and stored run
    // agrees on.
    repoFullName  String
    // The App installation this repository is reached through. Held rather than
    // looked up per dispatch: the lookup costs a rate-limited call on a value
    // that changes when somebody reinstalls the App, and no more often.
    installationId String
    // Whether the repository is private, as last observed. Drives the execution
    // recommendation and the default shell policy, and is refreshed whenever
    // GitHub tells us - a repository that goes public is a different risk.
    isPrivate     Boolean  @default(true)
    // actions | runners | server - where runs happen. See AGENT_EXECUTIONS.
    execution     String
    // The pool `runners` execution uses. Null for the other two.
    poolId        String?  @db.Uuid
    model         String
    // low | medium | high | xhigh | max, landed on the running model's own
    // published range at dispatch. Stored by name so a model changing its range
    // does not silently change what was asked for.
    effort        String   @default("medium")
    // disabled | restricted | enabled - what the agent may do with git.
    push          String   @default("restricted")
    // disabled | restricted | enabled - whether it may run commands, and whether
    // secrets are filtered out of the environment when it does.
    shell         String
    enabled       Boolean  @default(true)
    // Whether pull-request and issue events start runs here. Null inherits from
    // the organization's defaults, and then from the instance's. Storing the
    // inherited value would freeze it the moment the tier above changed.
    pullRequests  Boolean?
    issues        Boolean?
    // off | checks | full - what the Enigma quality gate does once the agent has
    // committed, before anything is pushed. Null inherits, same as above.
    gate          String?
    // When the workflow file was last written into the repository. Null for
    // `server` execution, which needs no workflow at all, and for a repository
    // enabled before the write succeeded.
    workflowInstalledAt DateTime?
    // Why the last dispatch could not be made, shown on the repository rather
    // than left in a log nobody opens.
    error         String?
    createdAt     DateTime @default(now())
    updatedAt     DateTime @updatedAt

    owner       User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
    pool        RunnerPool?       @relation(fields: [poolId], references: [id], onDelete: SetNull)
    automations AgentAutomation[]
    runs        AgentRun[]

    @@unique([ownerId, repoFullName])
    @@index([repoFullName])
    @@index([ownerId])
    @@index([poolId])
}

// What repositories inherit, decided once instead of on every repository.
//
// Two tiers share this table and are told apart by `scope`: the empty string is
// the instance-wide row, and a GitHub account or organization login is that
// account's row. A repository reads its own columns first, then the row for its
// owner login, then the empty-scope row. Every column is nullable because null
// means "inherit" - a tier that stored its inherited value would freeze it the
// moment the tier above it changed, which is exactly what the tiers exist to
// avoid.
// A ceiling on how much agent work something may do.
//
// Set by an administrator, because the money being spent is the deployment's
// (or, once somebody brings their own key, theirs) and neither is a limit the
// person spending it should be able to raise. Every rule that applies to a run
// has to be under its ceiling for the run to start; the most restrictive one
// therefore wins without anything having to rank them.
//
// A rule on a role or a group is PER MEMBER, not a pot they share. That is what
// makes a role a way of setting the same limit for forty people rather than a
// queue for them - and a shared pot would mean one person's Monday could stop
// everybody else's Tuesday, which nobody would be able to see coming. Rules on a
// repository or an account are naturally per that repository or account.
model AgentUsageLimit {
    id          String   @id @default(uuid(7)) @db.Uuid
    // user | role | group | repo | org | everyone. `everyone` carries no subject
    // and is the deployment-wide floor under all the others.
    subjectType String
    // The user, role or group id, the `owner/name` of a repository, or the
    // GitHub account login. Empty for `everyone`.
    subjectId   String
    // runs | tokens. Tokens are what a provider actually bills for; runs are what
    // an operator can reason about. Both exist because neither answers the other.
    metric      String
    // day | week | month, counted as a rolling window back from now rather than
    // from a calendar boundary - a calendar month would let a month's budget be
    // spent twice across a month end.
    period      String
    amount      Int
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    @@unique([subjectType, subjectId, metric, period])
    @@index([subjectType])
}

// A provider credential somebody brought themselves.
//
// Model keys used to be instance-wide only, which made every run on the
// deployment spend one account's money and put the choice of provider in the
// administrator's hands alone. Somebody with their own Anthropic account should
// be able to use it, the way they would bring their own credentials anywhere
// else, and an administrator should be able to hand out theirs without that
// being the only way anything runs.
//
// Encrypted with the same envelope as every other stored credential, so a
// database dump yields no usable keys. Deleted with the account: a key nobody
// owns is a charge nobody can stop.
//
// One account holds as many of these as it likes, including several for the same
// provider - a work key and a personal one, or one per spend limit. They are an
// ordered list rather than a set: `priority` is the order they are tried in, and
// it is the only place that order is recorded.
model UserModelKey {
    id              String   @id @default(uuid(7)) @db.Uuid
    userId          String   @db.Uuid
    // The provider's integration slug, e.g. `anthropic`, `groq`.
    provider        String
    // What its owner calls it. Unique across the whole account, not per provider:
    // it is how a person names one key in a sentence, and two rows answering to
    // "prod-main" makes that sentence ambiguous wherever it is read.
    name            String
    // Position in the owner's list, ascending, lowest tried first. Ties break on
    // creation order, so a list that has had rows removed still reads the same.
    priority        Int      @default(0)
    encryptedSecret Bytes
    secretNonce     Bytes
    secretKeyId     String
    // A keyed hash of the secret, which is the only way to notice the same key
    // being stored twice: the envelope uses a fresh nonce every time, so two rows
    // holding one credential have nothing in common to compare. Keyed rather than
    // plain so a database dump cannot be tested against a list of known keys.
    // Null on rows written before this existed - the store cannot compute one
    // without decrypting, and Postgres counts nulls as distinct, so they simply
    // do not participate.
    secretFingerprint String?
    // When the key stops being offered to a run, if its owner said. Polaris does
    // not learn this from the provider - most of them will not say - so it is
    // what the person entered when they set an expiry on their side.
    expiresAt       DateTime?
    // Which expiry warning has already been sent: "" | "soon" | "expired". Held
    // so a daily sweep announces each step once, and pushing the date out starts
    // the announcements over.
    expiryNotice    String   @default("")
    // Non-secret settings this credential needs, as stringified JSON. Only the
    // gateway shape uses it - a base URL, a model, and the two token limits an
    // endpoint publishes no catalogue for.
    config          String   @default("{}")
    // When a run last used it, so somebody can tell a key that is working from
    // one they pasted and forgot. Null until the first run reads it.
    lastUsedAt      DateTime?
    createdAt       DateTime @default(now())
    updatedAt       DateTime @updatedAt

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([userId, name])
    @@unique([userId, provider, secretFingerprint])
    @@index([userId, priority])
    // The daily expiry sweep reads by date across every account.
    @@index([expiresAt])
}

// One model a provider serves, as its public catalogue describes it.
//
// Downloaded rather than written down. Providers add and retire models
// constantly, and the hand-kept list this replaced offered exactly one model per
// provider - so somebody with a Groq key could pick `gpt-oss-120b` and nothing
// else, with no way to see that the account it ran on could not afford a single
// request of that size. The numbers here are what let a screen say what a model
// holds before a run finds out the hard way.
//
// Nothing depends on this being present. A deployment that has never reached the
// catalogue, or is offline, falls back to the one default each provider carries
// in the integrations registry, so the pickers are never empty.
model AgentModel {
    // `provider/model-id` exactly as it is handed to the runtime, e.g.
    // `groq/openai/gpt-oss-120b`. The provider's own id can itself contain a
    // slash, which is why the two are also stored apart.
    slug          String   @id
    provider      String
    modelId       String
    name          String
    // What it can hold, and the most it will write. Zero means the catalogue did
    // not say - which is not the same as none, and callers have to tell them
    // apart before doing arithmetic on it.
    contextTokens Int      @default(0)
    outputTokens  Int      @default(0)
    // Reasoning-effort rungs the model accepts, ascending, as a JSON string
    // array. Empty when it has no effort control and the setting is a no-op.
    effortRungs   String   @default("[]")
    reasoning     Boolean  @default(false)
    attachment    Boolean  @default(false)
    // USD per million tokens as published. Display only - what an operator is
    // actually billed is settled by the provider, so this is never summed into
    // anything Polaris presents as a charge.
    costInput     Float?
    costOutput    Float?
    releaseDate   String?
    refreshedAt   DateTime @updatedAt

    @@index([provider])
}

model AgentDefaults {
    id           String   @id @default(uuid(7)) @db.Uuid
    ownerId      String   @db.Uuid
    // "" for the instance-wide row, a GitHub login otherwise.
    scope        String   @default("")
    // actions | runners | server, and the pool that goes with `runners`.
    execution    String?
    poolId       String?  @db.Uuid
    model        String?
    effort       String?
    // Models to try when the one above will not serve the run, most preferred
    // first, as a JSON string array. Null is "inherit"; an empty array is a
    // deliberate "do not fall back anywhere", which is not the same thing.
    fallback     String?
    // disabled | restricted | enabled, for git and for the shell.
    push         String?
    shell        String?
    // Whether the agent may run on a repository of that visibility at all. A
    // public repository is the one a stranger can open a pull request on, which
    // is why it is a switch of its own.
    publicRepos  Boolean?
    privateRepos Boolean?
    // Whether pull-request and issue events start runs. A direct mention is not
    // covered by either: that is somebody addressing the app, not Polaris
    // starting a run on its own.
    pullRequests Boolean?
    issues       Boolean?
    // off | checks | full.
    gate         String?
    createdAt    DateTime @default(now())
    updatedAt    DateTime @updatedAt

    owner User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
    pool  RunnerPool? @relation(fields: [poolId], references: [id], onDelete: SetNull)

    @@unique([ownerId, scope])
    @@index([ownerId])
    @@index([poolId])
}

// When to start a run, and what to tell it.
//
// A repository with no rows here still answers a direct mention: that is not an
// automation but the baseline of having the App installed, and storing it as a
// row would let somebody delete the only way to ask the agent for anything.
model AgentAutomation {
    id           String   @id @default(uuid(7)) @db.Uuid
    repoId       String   @db.Uuid
    // One of AGENT_TRIGGERS. Polaris's own names, not GitHub event names: one
    // trigger can span several events, and the mapping belongs in the webhook.
    trigger      String
    // Stringified JSON narrowing the trigger: labels, branches, authors. An
    // absent or empty list does not narrow, so a malformed row is permissive in
    // the same direction the operator's empty form is.
    condition    String   @default("{}")
    // The runtime mode to force (Build, Review, ...), or null to let the agent
    // choose from what it was handed.
    mode         String?
    // Operator prose folded into the run's prompt. Never joined with text from
    // an issue or a comment, which is a different trust level entirely.
    instructions String   @default("")
    enabled      Boolean  @default(true)
    createdAt    DateTime @default(now())
    updatedAt    DateTime @updatedAt

    repo AgentRepo @relation(fields: [repoId], references: [id], onDelete: Cascade)

    @@index([repoId])
}

// One run, from the moment something asked for it.
//
// The row is written before the run is dispatched, not after it reports in. A
// dispatch that fails, a workflow that never starts and a container that dies on
// boot are all things somebody has to be able to see, and none of them would
// write their own row.
model AgentRun {
    id          String   @id @default(uuid(7)) @db.Uuid
    repoId      String   @db.Uuid
    // Which of AGENT_TRIGGERS started it, or `manual`.
    trigger     String
    // actions | runners | server, as resolved at dispatch. Copied rather than
    // read back off the repository, because the repository's setting can change
    // while a run is in flight and the run happened where it happened.
    execution   String
    // queued | running | succeeded | failed | cancelled.
    state       String   @default("queued")
    mode        String?
    model       String
    // What the run was pointed at, when it was pointed at anything.
    issueNumber Int?
    prNumber    Int?
    // GitHub's workflow run id, for the two executions GitHub schedules. Null on
    // `server` runs and until the dispatch is acknowledged.
    githubRunId String?
    // The container `server` runs happen in, so the log can be streamed and the
    // run can be cancelled.
    containerId String?
    // What the agent was asked to do, so a retry on the next model asks the same
    // thing. A webhook run cannot rebuild it - the event is gone - and a retry
    // that invented its own prompt would be a different piece of work wearing the
    // first one's name.
    prompt      String?
    // Which try this is on the fallback chain, and the run it followed. A run
    // started because the one before it could not be served is a second attempt at
    // ONE piece of work, and a screen that showed them as unrelated failures would
    // be describing the chain as breakage.
    attempt     Int      @default(1)
    parentRunId String?  @db.Uuid
    // Which classification the failure landed on, as a value rather than as the
    // prose in `error` - what decides whether the next candidate is tried.
    failureKind String?
    // SHA-256 of the token this run authenticates its callbacks with. The raw
    // value is handed to the runtime once, at dispatch, and never stored: a
    // database dump therefore cannot be replayed as a live run credential. The
    // token stops working when the run reaches a terminal state.
    tokenHash   String?
    // Who asked, for a manual run. Null when a webhook did.
    startedById String?  @db.Uuid
    startedAt   DateTime?
    finishedAt  DateTime?
    // Token counts as reported by the run, for the usage the operator is paying
    // their provider for.
    tokensIn    Int?
    tokensOut   Int?
    // Why it failed, in the words shown on the run.
    error       String?
    // The structured result a run was asked to produce, as stringified JSON.
    result      String?
    // What the Enigma quality gate has reported so far, as stringified JSON:
    // one entry per step, appended as the pre-push hook works through them. Kept
    // on the run rather than in the log so the screen can show the pipeline
    // without reading a container's output.
    gateSteps   String?
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    repo AgentRepo @relation(fields: [repoId], references: [id], onDelete: Cascade)

    @@index([repoId, createdAt])
    @@unique([tokenHash])
    @@index([state])
    @@index([githubRunId])
    @@index([parentRunId])
}

// ---------------------------------------------------------------------------
// Backups (what is protected, by which policy, and where the copies live)
// ---------------------------------------------------------------------------

// Somewhere copies are written.
//
// Four kinds, because "where" genuinely has four answers here and collapsing
// them would only move the branch somewhere less visible. `local` is the data
// dir Polaris already owns. `source-local` is beside the thing itself - a game
// server's own disk, where an archive is cheap and instant - which is worth
// naming rather than hiding, because it is the one destination that does NOT
// survive the disk it protects. `connection` is any StorageConnection, so a NAS,
// an S3 bucket and a linked Dropbox are the same row with a different driver
// behind it. `host` is a machine already enrolled here, reached over the SSH
// credentials Polaris holds, so replicating to a server somebody has connected
// costs them no second set of credentials.
//
// Deleting a connection or a host that still holds copies is refused rather than
// cascaded: the rows would survive as pointers to bytes nobody can fetch, which
// reads on screen exactly like a backup that exists.
model BackupDestination {
    id            String    @id @default(uuid(7)) @db.Uuid
    ownerId       String    @db.Uuid
    name          String
    // local | source-local | connection | host
    kind          String
    // Set for kind=connection; the bucket/share this writes into.
    connectionId  String?   @db.Uuid
    // Set for kind=host; the enrolled machine copies are pushed to over SFTP.
    hostId        String?   @db.Uuid
    // Prefix everything is written under, so backups never share a namespace
    // with whatever else lives on the target.
    basePath      String    @default("polaris-backups")
    // The one offered first when somebody protects something without choosing.
    isDefault     Boolean   @default(false)
    // active | unreachable. Set by the last write or the explicit test, so a
    // destination that has started refusing says so before the next backup is due.
    status        String    @default("active")
    lastCheckedAt DateTime?
    lastError     String?
    createdAt     DateTime  @default(now())
    updatedAt     DateTime  @updatedAt

    owner      User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
    connection StorageConnection? @relation(fields: [connectionId], references: [id], onDelete: Restrict)
    host       Host?              @relation(fields: [hostId], references: [id], onDelete: Restrict)
    plans      BackupPlanDestination[]
    copies     RecoveryPointCopy[]

    @@unique([ownerId, name])
    @@index([ownerId])
    @@index([connectionId])
    @@index([hostId])
}

// How often a copy is taken, how many are kept, and where they go.
//
// Schedule and retention are one row for the reason the Minecraft policy this
// generalizes gave: a schedule without a retention rule is a disk that fills up,
// and a full disk is the outcome backups existed to prevent. Three limits rather
// than one because operators reason in all three - "a week of dailies" is a
// count, "30 days" is an age, "under 200 GB" is a budget. Any may be off; when
// several are on, the strictest simply bites first.
model BackupPlan {
    id              String   @id @default(uuid(7)) @db.Uuid
    ownerId         String   @db.Uuid
    name            String
    // off | hourly | six-hourly | daily | weekly | monthly. Nothing faster than
    // hourly: archiving a real world or database takes real seconds, and a
    // schedule that overlaps its own last run is a thing permanently mid-backup.
    every           String   @default("off")
    // How many copies to keep per destination, newest first. 0 means no limit.
    keepLast        Int      @default(7)
    // How long a copy may live, in days. 0 means no limit.
    keepDays        Int      @default(0)
    // A budget for every copy in one destination together, in bytes. 0 means no limit.
    maxBytes        BigInt   @default(0)
    notifyOnFailure Boolean  @default(true)
    createdAt       DateTime @default(now())
    updatedAt       DateTime @updatedAt

    owner        User                    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
    destinations BackupPlanDestination[]
    resources    ProtectedResource[]

    @@unique([ownerId, name])
    @@index([ownerId])
}

// One destination a plan writes to, and how early in the fan-out it is written.
//
// A plan with three of these makes three copies of every backup. `position` 0 is
// produced first and is the one the other copies are replicated from, so the
// cheapest reachable destination belongs at the front: the source is read once,
// however many places the result ends up.
model BackupPlanDestination {
    id            String @id @default(uuid(7)) @db.Uuid
    planId        String @db.Uuid
    destinationId String @db.Uuid
    position      Int    @default(0)

    plan        BackupPlan        @relation(fields: [planId], references: [id], onDelete: Cascade)
    destination BackupDestination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

    @@unique([planId, destinationId])
    @@index([destinationId])
}

// One thing being backed up.
//
// The row exists so that "what is protected" is a question with an answer, which
// is what the old screen could not do: backups were files in a folder and a
// policy hidden in an app's config, so nothing could list them, count them, or
// notice one had stopped running.
//
// `selector` is the normalized identity - "managed-database:<uuid>",
// "nas-path:<uuid>:/photos" - and it is what uniqueness is enforced on, so the
// same database cannot be protected twice under two names. The counters and
// timestamps are denormalized on purpose: this table is read as a list of
// hundreds of rows that has to sort by last backup and filter by status, and
// deriving either from RecoveryPoint would make every page load a scan.
model ProtectedResource {
    id                  String    @id @default(uuid(7)) @db.Uuid
    ownerId             String    @db.Uuid
    // polaris-database | managed-database | external-database | minecraft-world |
    // deploy-volume | nas-path
    kind                String
    selector            String
    // What to call it on screen. A copy of the source's own name, refreshed when
    // the source is read, so a list of 500 rows needs no join per row.
    name                String
    // Kind-specific settings as stringified JSON (the level, the subpath, the
    // database engine and host).
    config              String    @default("{}")
    // Envelope-encrypted credentials, set only for external databases - the one
    // kind whose source Polaris does not already hold credentials for.
    encryptedCredential Bytes?
    credentialNonce     Bytes?
    credentialKeyId     String?
    // Null means on-demand only: protected, backed up when somebody asks, never
    // on a schedule. It is a legitimate state, not a half-configured one.
    planId              String?   @db.Uuid
    // active | paused | missing. `missing` is set when the source has gone (the
    // server was deleted, the volume removed) - the copies are still there and
    // still restorable, which is exactly when somebody needs them.
    status              String    @default("active")
    lastBackupAt        DateTime?
    // ok | partial | failed
    lastStatus          String?
    lastError           String?
    // When the schedule wants the next one. Written by the sweep so the cron can
    // find due work with an index instead of evaluating every policy.
    nextDueAt           DateTime?
    copyCount           Int       @default(0)
    sizeBytes           BigInt    @default(0)
    createdAt           DateTime  @default(now())
    updatedAt           DateTime  @updatedAt

    owner  User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
    plan   BackupPlan?     @relation(fields: [planId], references: [id], onDelete: SetNull)
    points RecoveryPoint[]

    @@unique([ownerId, selector])
    @@index([ownerId, kind])
    @@index([ownerId, status])
    @@index([ownerId, lastBackupAt])
    @@index([nextDueAt])
    @@index([planId])
}

// One backup: a moment of a resource, however many places it ended up.
//
// Separate from the copies below because those are the same bytes in different
// destinations. Somebody restoring picks a point in time first and a place to
// fetch it from second - and a point whose S3 copy failed while its local copy
// landed is still a restorable backup, which is what `partial` says.
model RecoveryPoint {
    id         String    @id @default(uuid(7)) @db.Uuid
    resourceId String    @db.Uuid
    // Which plan took it; null when somebody asked for it. Deliberately not a
    // foreign key: deleting a plan must not rewrite the history of what ran.
    planId     String?   @db.Uuid
    takenAt    DateTime  @default(now())
    // When retention says it may go. Null when no age limit applies.
    expiresAt  DateTime?
    sizeBytes  BigInt    @default(0)
    // creating | available | partial | failed | deleting
    status     String    @default("creating")
    // What the source knew at the time (engine and version, the level's name),
    // as stringified JSON. A restore needs it and the source may be gone by then.
    metadata   String    @default("{}")
    error      String?
    createdAt  DateTime  @default(now())

    resource ProtectedResource   @relation(fields: [resourceId], references: [id], onDelete: Cascade)
    copies   RecoveryPointCopy[]

    @@index([resourceId, takenAt])
    @@index([status])
    @@index([expiresAt])
}

// The same backup, in one destination.
//
// Retention is applied per destination rather than per point, because the
// destinations are not equivalent: a game server's own disk holds a few days and
// a bucket holds a year, and forcing one number on both would either fill the
// disk or throw away the archive somebody is paying to keep.
model RecoveryPointCopy {
    id            String   @id @default(uuid(7)) @db.Uuid
    pointId       String   @db.Uuid
    destinationId String   @db.Uuid
    // Where it is inside the destination: the key, the path, the file id.
    path          String
    sizeBytes     BigInt   @default(0)
    // pending | available | failed | deleting
    status        String   @default("pending")
    error         String?
    createdAt     DateTime @default(now())
    updatedAt     DateTime @updatedAt

    point       RecoveryPoint     @relation(fields: [pointId], references: [id], onDelete: Cascade)
    destination BackupDestination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

    @@unique([pointId, destinationId])
    @@index([destinationId, status])
}

// What ran, when, and how it ended.
//
// Kept for every attempt including the ones that worked, because the question
// somebody opens this for is usually "is it still running" rather than "what
// broke" - and a log that only records failures cannot answer the first one.
model BackupJob {
    id          String    @id @default(uuid(7)) @db.Uuid
    ownerId     String    @db.Uuid
    resourceId  String?   @db.Uuid
    pointId     String?   @db.Uuid
    // backup | restore | prune | replicate
    type        String
    // manual | scheduled
    trigger     String    @default("manual")
    // running | succeeded | failed
    status      String    @default("running")
    // Who asked. Null for the ones the schedule started. Not a foreign key: the
    // record of what ran outlives the account that asked for it.
    actorUserId String?   @db.Uuid
    startedAt   DateTime  @default(now())
    finishedAt  DateTime?
    bytes       BigInt    @default(0)
    error       String?

    owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

    @@index([ownerId, startedAt])
    @@index([resourceId, startedAt])
    @@index([status])
}
// ---------------------------------------------------------------------------
// Chat (internal conversation)
// ---------------------------------------------------------------------------

// A place with channels in it - what Discord calls a server and Slack calls a
// workspace.
//
// Deliberately not the Organization: an organization is who somebody works for
// and answers a permission question, while a chat space is who somebody talks
// to, and the two are not the same set. A space can belong to an organization,
// and then the roster is the organization's; one that belongs to nobody in
// particular is its owner's, and people are added to it by hand. The shape is
// TaskSpace's on purpose - the same question was already answered there, and two
// answers to "who owns a container of work" is a thing somebody has to learn
// twice.
model ChatSpace {
    id          String   @id @default(uuid(7)) @db.Uuid
    ownerId     String   @db.Uuid
    // The organization this space belongs to, or null for a personal one.
    orgId       String?  @db.Uuid
    name        String
    description String   @default("")
    // The dot beside the name in the rail. Free-form hex, like a task space's.
    color       String   @default("#7c5cff")
    // private | internal - the same two words a task space uses, and the same
    // meanings: private is the roster, internal is everybody who can see the
    // owner (the instance, or the organization when there is one).
    visibility  String   @default("private")
    archived    Boolean  @default(false)
    order       Float    @default(1024)
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    owner    User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
    org      Organization?     @relation(fields: [orgId], references: [id], onDelete: Cascade)
    avatar     ChatSpaceAvatar?
    members    ChatSpaceMember[]
    bans       ChatSpaceBan[]
    channels   ChatChannel[]
    categories ChatCategory[]
    invites    ChatSpaceInvite[]

    @@index([ownerId])
    @@index([orgId])
}

// Somebody other than the owner who may reach a space. The owner is never a row
// here, so removing every member cannot lock the space away from its creator.
// An invitation into a space.
//
// The code is the whole credential, so what one grants is deliberately narrow
// and deliberately bounded: one space, until it expires, for as many people as
// it was made for. Both bounds are optional and both are checked on every use,
// because a link that can be forwarded is a link that will be.
//
// Uses are counted rather than the people recorded: who accepted is already a
// membership row, and a second list of it would be a second thing to keep right.
// A revoked invite is kept rather than deleted so a link that stops working can
// say it was withdrawn instead of pretending it never existed.
model ChatSpaceInvite {
    id          String    @id @default(uuid(7)) @db.Uuid
    spaceId     String    @db.Uuid
    // The part that appears in a URL. Unique across the instance, so an invite
    // is resolved by the code alone and nobody has to name the space to use one.
    code        String    @unique
    createdById String    @db.Uuid
    // Null for one with no end.
    expiresAt   DateTime?
    // Null for one with no limit.
    maxUses     Int?
    uses        Int       @default(0)
    revokedAt   DateTime?
    createdAt   DateTime  @default(now())

    space     ChatSpace @relation(fields: [spaceId], references: [id], onDelete: Cascade)
    createdBy User      @relation(fields: [createdById], references: [id], onDelete: Cascade)

    @@index([spaceId, createdAt])
}

// A picture somebody kept, so they can send it again.
//
// One row per person per thing, because keeping something is a fact about a
// reader and not about the message it was seen in - the message can be deleted,
// the channel can be left, and what was kept stays kept.
//
// `source` is either an http address, for a picture posted as a link, or
// `attachment:<id>` for one already stored here. One column with a prefix rather
// than two nullable ones, the same shape Drive uses for its prefixed sources: a
// pair of columns where exactly one is set is a pair that can be wrong.
model ChatSavedMedia {
    id          String   @id @default(uuid(7)) @db.Uuid
    userId      String   @db.Uuid
    source      String
    // What it is called and what it is, so the picker can label it without
    // fetching anything. Whatever it was called where it was found.
    name        String   @default("")
    contentType String   @default("")
    createdAt   DateTime @default(now())

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([userId, source])
    @@index([userId, createdAt])
}

model ChatSpaceMember {
    id        String   @id @default(uuid(7)) @db.Uuid
    spaceId   String   @db.Uuid
    userId    String   @db.Uuid
    // member | admin - an admin may add channels and people, a member may talk.
    role      String   @default("member")
    // Until when they may read but not speak. Null is the ordinary case. A
    // moment rather than a flag, so it ends on its own: a timeout somebody has
    // to remember to lift is a timeout that becomes a ban by accident.
    timeoutUntil DateTime?
    createdAt DateTime @default(now())

    space ChatSpace @relation(fields: [spaceId], references: [id], onDelete: Cascade)
    user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([spaceId, userId])
    @@index([userId])
}

// Somebody kept out of a space, and who decided that.
//
// Only a space has these. A group is a handful of people who got there by
// invitation from somebody already in it - there is no door to stand at, so
// taking somebody out of one is all there is to do and putting them back is a
// matter of inviting them again.
//
// The row is what refuses them: it is checked when anybody is added and when an
// invitation is followed, so a ban survives being forgotten about. Lifting one
// is deleting it, which is why there is nothing here for "lifted at" - a space
// that wants that history has the activity log.
model ChatSpaceBan {
    id        String   @id @default(uuid(7)) @db.Uuid
    spaceId   String   @db.Uuid
    userId    String   @db.Uuid
    // Who decided, so the list of bans reads as decisions rather than as facts.
    // Null once that account is gone: the ban outlives whoever made it.
    byId      String?  @db.Uuid
    reason    String   @default("")
    createdAt DateTime @default(now())

    space ChatSpace @relation(fields: [spaceId], references: [id], onDelete: Cascade)
    user  User      @relation("ChatSpaceBanUser", fields: [userId], references: [id], onDelete: Cascade)
    by    User?     @relation("ChatSpaceBanBy", fields: [byId], references: [id], onDelete: SetNull)

    @@unique([spaceId, userId])
    @@index([spaceId])
}

// One conversation: a channel in a space, or a direct message that belongs to no
// space at all.
//
// Both are the same row because everything downstream of them is identical - the
// messages, the threads, the reactions, the unread mark, the call - and a second
// table would have meant a second copy of each. What separates them is `kind`
// and whether `spaceId` is set.
//
// `dmKey` is what stops two people opening two different direct messages with
// each other from two tabs: it is the participants' ids sorted and joined, so
// the pair itself is the unique key. Group messages and channels leave it null,
// where the uniqueness does not apply.
model ChatChannel {
    id            String    @id @default(uuid(7)) @db.Uuid
    spaceId       String?   @db.Uuid
    // The heading it sits under inside its space, or null for the channels above
    // the first one. ON DELETE SET NULL: removing a heading must not remove the
    // rooms under it.
    categoryId    String?   @db.Uuid
    // text | voice | dm | group
    kind          String    @default("text")
    name          String
    topic         String    @default("")
    // A channel only its members see. Always true for dm and group, and the
    // reason the flag exists rather than being read off `kind`.
    private       Boolean   @default(false)
    dmKey         String?   @unique
    createdById   String?   @db.Uuid
    // Who runs a group. The creator to begin with, and transferable - a group
    // whose owner cannot hand it over is a group that dies with an account.
    // Null for everything that is not a group: a channel is run by whoever
    // administers its space, and a direct message is between equals.
    ownerId       String?   @db.Uuid
    // Whether anybody in the group may change its name and its picture, or only
    // the owner. Off by default: a group photo anybody can change is a group
    // photo that changes.
    membersMayEdit Boolean  @default(false)
    // How long somebody waits between messages here, in seconds. Zero is off,
    // which is every channel until whoever runs it decides otherwise. Whoever
    // may moderate the room is not held by it - a moderator who cannot answer
    // for five minutes cannot moderate.
    slowmode      Int       @default(0)
    // Denormalized so the rail can sort conversations by what is happening
    // without reading every message table.
    lastMessageAt DateTime?
    order         Float     @default(1024)
    archived      Boolean   @default(false)
    createdAt     DateTime  @default(now())
    updatedAt     DateTime  @updatedAt

    space    ChatSpace?          @relation(fields: [spaceId], references: [id], onDelete: Cascade)
    category ChatCategory?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
    avatar   ChatChannelAvatar?
    members  ChatChannelMember[]
    messages ChatMessage[]
    meetings Meeting[]
    scheduled ChatScheduledMessage[]

    @@index([spaceId, order])
    @@index([categoryId, order])
    @@index([lastMessageAt])
}

// The picture on a space, and the one on a conversation.
//
// Two tables rather than one keyed by a kind, so each cascades with the thing it
// belongs to: a space that is deleted must not leave a row pointing at a file
// nobody will ever ask for again. They are otherwise the same shape as an
// account's photo and an organization's, and go through the same service and the
// same storage target - a picture is a picture.
//
// A group with none is not blank: it is drawn from the faces of the people in
// it, which is what every messenger does and what makes a list of groups
// readable before any of them are named.
model ChatSpaceAvatar {
    spaceId      String   @id @db.Uuid
    // Null when the bytes are on the disk Polaris runs on.
    connectionId String?
    path         String
    mime         String
    size         Int      @default(0)
    updatedAt    DateTime @updatedAt

    space ChatSpace @relation(fields: [spaceId], references: [id], onDelete: Cascade)
}

model ChatChannelAvatar {
    channelId    String   @id @db.Uuid
    connectionId String?
    path         String
    mime         String
    size         Int      @default(0)
    updatedAt    DateTime @updatedAt

    channel ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
}

// A heading inside a space, with channels under it.
//
// Purely an arrangement: a category grants nothing and hides nothing, and a
// channel that belongs to none is simply drawn above the first heading. That is
// deliberate - a grouping that also carried permissions would be two ideas
// wearing one name, and the second one would be invisible.
model ChatCategory {
    id        String   @id @default(uuid(7)) @db.Uuid
    spaceId   String   @db.Uuid
    // A label somebody wrote rather than a slug: nothing is addressed by it.
    name      String
    order     Float    @default(1024)
    createdAt DateTime @default(now())

    space    ChatSpace     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
    channels ChatChannel[]

    @@index([spaceId, order])
}

// Who is in a channel, and how much of it they have read.
//
// The read mark lives here rather than in a table of its own because it is one
// row per person per channel either way, and keeping it beside the membership
// means catching up is one write and leaving a channel takes the mark with it.
model ChatChannelMember {
    id                String    @id @default(uuid(7)) @db.Uuid
    channelId         String    @db.Uuid
    userId            String    @db.Uuid
    // member | admin
    role              String    @default("member")
    // Until when they may read but not speak here. The same idea as a space
    // member's, for a group - which has no roles to take away instead.
    timeoutUntil      DateTime?
    // The last message this person has seen. Null before they have read any.
    lastReadMessageId String?   @db.Uuid
    lastReadAt        DateTime?
    // When their browser last had the messages in hand, which is a different
    // claim to having read them: one is the device, the other is the person.
    // What the second tick means.
    lastDeliveredAt   DateTime?
    // No badge, and no notification, without leaving the channel.
    muted             Boolean   @default(false)
    // When the quiet ends. Null while `muted` means "until I turn it back on",
    // which is a different thing from a silence that expires and the only way
    // the screen can say which one is on. A lapsed row is cleared on the next
    // read rather than by a job: nothing else has to run for it to be right.
    mutedUntil        DateTime?
    // Held at the top of this person's list, and nobody else's: a conversation
    // being important to one person says nothing about the others in it. The
    // time rather than a flag, so several pinned conversations keep the order
    // they were pinned in instead of an arbitrary one.
    pinnedAt          DateTime?
    createdAt         DateTime  @default(now())

    channel ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
    user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([channelId, userId])
    @@index([userId])
}

// One message.
//
// The body is the same Markdown everything else in Polaris is written in, so a
// mention of a person or a task is the same address here as it is in a note or a
// comment, and pasting between them keeps the chips.
//
// A thread is a message with `parentId` set, and only one level deep: a reply to
// a reply belongs to the same thread rather than starting another. `replyCount`
// and `lastReplyAt` are kept on the root so a channel can be drawn without
// reading every thread it holds.
//
// `deletedAt` rather than a delete: a removed message leaves a tombstone, which
// is what keeps the replies under it from becoming orphans and what stops the
// message above it from silently absorbing its meaning.
model ChatMessage {
    id          String    @id @default(uuid(7)) @db.Uuid
    channelId   String    @db.Uuid
    // Null for the ones Polaris writes itself: somebody joined, a call started.
    // Not a foreign key, so a message survives the account that wrote it - what
    // was said stays said, and the name resolves to nobody.
    authorId    String?   @db.Uuid
    // text | system | call
    kind        String    @default("text")
    body        String    @default("")
    parentId    String?   @db.Uuid
    // The message this one quotes, for a reply shown inline in the channel or a
    // message forwarded into another conversation. Distinct from `parentId`,
    // which puts a message inside a thread and takes it out of the channel:
    // a reply stays in the flow and carries the thing it answers above it, which
    // is what people reach for far more often.
    //
    // ON DELETE SET NULL: deleting what was quoted must not delete the answer.
    // The quote falls back to saying the original is gone.
    replyToId   String?   @db.Uuid
    // Whether the quote is a forward rather than a reply. One column pair for
    // both because they are the same relationship - this message stands on that
    // one - and only the wording and the placement differ.
    forwarded   Boolean   @default(false)
    replyCount  Int       @default(0)
    lastReplyAt DateTime?
    editedAt    DateTime?
    deletedAt   DateTime?
    // When the other person's device first picked this up, and when they first
    // saw it. Only ever written in a one-to-one conversation, and only on
    // somebody else's message: "read by three of the seven people here" is a
    // different feature, and this is what the message information panel reads.
    //
    // Stamped once and never moved. The marks on the membership row are
    // monotonic and say how far somebody has got now, which cannot answer when
    // they got to a particular message - that is what these are for. Null means
    // it did not happen, or happened before Polaris recorded it.
    deliveredAt DateTime?
    readAt      DateTime?
    createdAt   DateTime  @default(now())

    channel     ChatChannel      @relation(fields: [channelId], references: [id], onDelete: Cascade)
    parent      ChatMessage?     @relation("ChatThread", fields: [parentId], references: [id], onDelete: Cascade)
    replies     ChatMessage[]    @relation("ChatThread")
    replyTo     ChatMessage?     @relation("ChatQuote", fields: [replyToId], references: [id], onDelete: SetNull)
    quotedBy    ChatMessage[]    @relation("ChatQuote")
    reactions   ChatReaction[]
    attachments ChatAttachment[]
    poll        ChatPoll?
    stars       ChatStar[]
    edits       ChatMessageEdit[]
    reports     ChatReport[]

    @@index([channelId, createdAt])
    @@index([parentId, createdAt])
    @@index([replyToId])
}

// What one person calls another.
//
// Theirs alone and visible to nobody else, which is the whole feature: somebody
// whose display name is a handle nobody recognises is "Dad" in one person's
// list and unchanged in everybody else's. It replaces the name wherever Polaris
// draws it *for that reader* - the conversation list, the message they wrote,
// the roster - and never where it would be a claim about who somebody is: an
// audit entry, a moderation queue, an invitation.
//
// No relation to anything but the two accounts. A nickname is not a fact about
// the person named; it is a note the namer keeps.
model ContactName {
    id        String   @id @default(uuid(7)) @db.Uuid
    ownerId   String   @db.Uuid
    subjectId String   @db.Uuid
    nickname  String
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    owner   User @relation("ContactNamesGiven", fields: [ownerId], references: [id], onDelete: Cascade)
    subject User @relation("ContactNamesReceived", fields: [subjectId], references: [id], onDelete: Cascade)

    @@unique([ownerId, subjectId])
    @@index([ownerId])
}

// Something somebody said was wrong with a message.
//
// The row is the reader's, not the message's: a report is one person saying
// this, and two people objecting to the same message is two reports and not a
// counter. One each, so pressing it twice does not stack, and the second press
// finds their own report still open rather than making another.
//
// The message is kept whichever way it is settled. A moderator who deletes it
// deletes the message; the report stays as the record of why, which is the half
// people go looking for a month later - and it is why `status` is settled rather
// than the row removed.
//
// Nothing here is a permission. Being able to report something is being able to
// see it, and what a moderator may do about it is decided where every other
// moderation decision is.
model ChatReport {
    id         String  @id @default(uuid(7)) @db.Uuid
    // Null once the message it named is gone. An instance set to leave no trace
    // deletes the row outright, and a moderation record that vanished with the
    // thing it was about would be a record of nothing - so what was reported is
    // copied onto the report below, and this becomes a link that used to work.
    messageId  String? @db.Uuid
    // Denormalized so the queue can be filtered and read without walking to the
    // message for every row - and so a report survives being looked at after the
    // message it names was deleted.
    channelId  String  @db.Uuid
    reporterId String  @db.Uuid
    // spam | abuse | sexual | violence | illegal | other - see core's list.
    reason     String
    // What they added in their own words, which is most of what makes a report
    // actionable. Optional: making somebody write an essay is how a report does
    // not get made at all.
    note       String  @default("")
    // Who wrote the message and the first of what it said, taken when the report
    // was made. Not a convenience: it is what the queue reads instead of walking
    // into every conversation, and it is what is left when the message is gone.
    //
    // It does mean a line of a private conversation sits in a moderation table.
    // That is what reporting something is - the reader handing it over - and it
    // is only ever read by somebody who already administers the instance.
    authorId   String? @db.Uuid
    excerpt    String  @default("")
    // open | kept | removed - what a moderator decided, and nothing else. There
    // is no "in progress": a queue with a middle state is a queue with rows
    // nobody owns.
    status     String  @default("open")
    // Who settled it and when, so the record answers "who decided this".
    handledById String?   @db.Uuid
    handledAt   DateTime?
    createdAt   DateTime  @default(now())

    message  ChatMessage? @relation(fields: [messageId], references: [id], onDelete: SetNull)
    reporter User        @relation("ChatReportsMade", fields: [reporterId], references: [id], onDelete: Cascade)
    handledBy User?      @relation("ChatReportsHandled", fields: [handledById], references: [id], onDelete: SetNull)
    files    ChatReportFile[]

    // One report per person per message. A second press is the same report.
    @@unique([messageId, reporterId])
    @@index([status, createdAt])
    @@index([channelId])
}

// A file that was on the message when somebody reported it.
//
// Most reports are about a picture. The queue showed the text and nothing else,
// so the one thing a moderator had to look at to decide anything was the one
// thing that was not there - and a report of a photograph read "No text", which
// is true and useless.
//
// This is the row, not the bytes. `path` points at the very same file the
// message points at: nothing is copied, and a conversation full of pictures does
// not cost twice as much because somebody objected to one of them. What that
// buys is the problem this row also solves - the author can delete the message,
// and with it the evidence. So when the message goes, the file is MOVED out from
// under it into the report's own folder and `held` is set. Still one copy; it
// simply belongs to the report now.
//
// Which is also why every field is duplicated here rather than read through
// `attachmentId`: the attachment row is deleted with the message, and this has
// to be able to draw and serve the file without it.
model ChatReportFile {
    id           String  @id @default(uuid(7)) @db.Uuid
    reportId     String  @db.Uuid
    // The attachment it was taken from, while that still exists. Null once the
    // message has been deleted - it is what this is asked by, when the bytes
    // have to be rescued before they go.
    attachmentId String? @db.Uuid
    name         String
    // The same width the attachment carries it in, so nothing is rounded on the
    // way across.
    size         BigInt  @default(0)
    contentType  String
    // Where the bytes are, in the same two columns the attachment uses. Both
    // change exactly once, if the message is ever deleted.
    connectionId String? @db.Uuid
    path         String
    // What the browser measured about a recording, so the report can draw the
    // same player the conversation does rather than a link.
    durationMs   Int?
    waveform     String?
    // Whether the bytes now belong to the report. False means they are still the
    // message's, and deleting the message is what changes it.
    held         Boolean @default(false)
    createdAt    DateTime @default(now())

    report ChatReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

    @@index([reportId])
    // The lookup that runs on every message deletion, so it must not be a scan.
    @@index([attachmentId])
}

// An emoji somebody put on a message. One row per person per emoji per message,
// so the count is the row count and pressing it twice takes it back off.
model ChatReaction {
    id        String   @id @default(uuid(7)) @db.Uuid
    messageId String   @db.Uuid
    userId    String   @db.Uuid
    // The emoji itself rather than a shortcode: what was pressed is what is
    // stored, and no table has to be kept in step to draw it back.
    emoji     String
    createdAt DateTime @default(now())

    message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

    @@unique([messageId, userId, emoji])
    @@index([messageId])
}

// A question asked in a conversation, and the answers under it.
//
// Keyed by the message rather than carrying an id of its own: a poll is a
// message, and there is exactly one per message. That also means the question
// needs no column here - it is the message's body - so a poll is searched,
// quoted, forwarded and previewed in the rail by every path that already knows
// how to read a message, and none of them needed a special case.
//
// Nothing is denormalized onto it. The tallies are counted from the votes on
// read: a running count kept here would be a second source of truth for the one
// number the whole feature is about, and the first vote lost in a retry would
// leave it wrong forever with nothing to compare against.
model ChatPoll {
    messageId   String    @id @db.Uuid
    // Whether somebody may pick more than one answer.
    multiple    Boolean   @default(false)
    // Whether the tallies stay hidden until it closes. A poll that shows a
    // running total is one where the first few votes decide the rest, which is
    // exactly what a room asking something contentious wants to avoid.
    hideResults Boolean   @default(false)
    // When it runs out on its own, or null for one that only a person ends.
    // Whether it is over is worked out on read from these two, the same way a
    // mute that expires is: nothing has to be running for a poll to close on
    // time.
    closesAt    DateTime?
    // When somebody ended it early. Distinct from `closesAt` because they are
    // different facts - one is the clock and the other is a decision - and the
    // card says which.
    closedAt    DateTime?
    createdAt   DateTime  @default(now())

    message ChatMessage      @relation(fields: [messageId], references: [id], onDelete: Cascade)
    options ChatPollOption[]

    @@index([closesAt])
}

// One answer on a poll.
//
// `position` rather than the order they were written: the answers are read as a
// list and the order somebody typed them in is the order they meant.
model ChatPollOption {
    id       String @id @default(uuid(7)) @db.Uuid
    pollId   String @db.Uuid
    text     String
    position Int

    poll  ChatPoll         @relation(fields: [pollId], references: [messageId], onDelete: Cascade)
    votes ChatPollVote[]

    @@index([pollId, position])
}

// Somebody picking one answer.
//
// One row per answer picked rather than one per voter, so a poll that allows
// several is the same shape as one that does not - what changes is how many rows
// a person may hold, and that is enforced where the vote is written rather than
// by the schema. Taking a vote back deletes the row: a poll is a count of who
// stands where now, not a history of who changed their mind.
//
// The poll is reached through the answer rather than named here as well. A page
// of polls loads its answers to draw them anyway, so the votes are fetched by
// those ids - which makes a second column pointing at the poll a copy of what
// the answer already says, and one that could disagree with it.
model ChatPollVote {
    id        String   @id @default(uuid(7)) @db.Uuid
    optionId  String   @db.Uuid
    userId    String   @db.Uuid
    createdAt DateTime @default(now())

    option ChatPollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
    user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([optionId, userId])
    @@index([optionId])
    @@index([userId])
}

// A file on a message.
//
// The bytes go wherever uploads go on this instance - the same destination
// avatars and task attachments use - and this row is the reference. Deleting the
// message takes the row; sweeping the bytes is the upload layer's job, the same
// as everywhere else.
model ChatAttachment {
    id           String   @id @default(uuid(7)) @db.Uuid
    messageId    String   @db.Uuid
    name         String
    size         BigInt   @default(0)
    contentType  String   @default("application/octet-stream")
    // The storage connection it was written to, or null for the disk Polaris
    // runs on. Recorded per file rather than read from the setting: an operator
    // who points chat at a NAS next month must not break every file already
    // written somewhere else.
    connectionId String?  @db.Uuid
    // Where it landed, as that storage addresses it.
    path         String
    // How long it plays for, when it is something that plays and the browser
    // that recorded it said so. Kept rather than worked out on the way in: a
    // recording made in a browser carries no duration in its container, so the
    // only place the answer exists for free is the machine that made it - and
    // asking for it later means every reader downloading the whole file to draw
    // a number.
    durationMs   Int?
    // The shape of the sound, one digit 0-9 per bar. A string because it is
    // written once, read whole and never queried, and because sixty-four
    // characters is smaller than any structure that would hold the same numbers.
    waveform     String?
    // A still from a video, taken by the browser that sent it and written beside
    // it. Null for everything that is not a video, and for videos sent before
    // there was one.
    //
    // Kept rather than made on demand because the alternative is every reader
    // fetching the head of every video in the room to draw a frame - which is
    // the thing a thumbnail exists to avoid. It is a few kilobytes against a
    // file that is measured in megabytes, and it is the difference between a
    // list of black rectangles and a list somebody can read.
    posterPath   String?
    // Where that still is, on the same terms as the file itself: a storage that
    // moves next month must not orphan the ones already written.
    posterConnectionId String? @db.Uuid
    createdAt    DateTime @default(now())

    message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

    @@index([messageId])
}

// A message written now and sent later.
//
// It is not a message yet, which is the whole design: nothing about it appears
// in the conversation, nothing counts it as unread, and it can be taken back
// without anybody knowing it existed. The room hears about it at the moment it
// is sent and not a second before.
//
// The files are written at the moment it is scheduled rather than at the moment
// it goes, because the bytes live on the machine that wrote them: a browser
// closed overnight - or a laptop lid shut - would take them with it. What is
// kept here is exactly what an attachment row keeps, so sending is the same
// call the live path makes with the same records.
//
// It carries what it was answering too. A reply written at midnight and sent at
// nine is still a reply, and one that arrived detached from what it answers is a
// message nobody can read.
model ChatScheduledMessage {
    id         String   @id @default(uuid(7)) @db.Uuid
    channelId  String   @db.Uuid
    authorId   String   @db.Uuid
    body       String
    // The thread it belongs to, for one written under a message.
    parentId   String?  @db.Uuid
    // What it answers, and whether that is a reply or something being passed on.
    replyToId  String?  @db.Uuid
    forwarded  Boolean  @default(false)
    // When it goes. The only column the sweep reads.
    sendAt     DateTime
    createdAt  DateTime @default(now())
    // Why it never went. Set instead of deleting the row: a message that
    // silently disappeared at nine in the morning is worse than one that says it
    // was refused - the person who wrote it is entitled to know it did not go,
    // and to the words they wrote.
    failure    String?
    failedAt   DateTime?

    channel ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
    author  User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
    files   ChatScheduledFile[]

    // What the sweep asks: due, and not already dealt with.
    @@index([sendAt])
    // What the composer asks: mine, here, soonest first.
    @@index([channelId, authorId, sendAt])
}

// A file waiting with the message it belongs to.
//
// The same columns an attachment has, because it becomes one: the bytes are
// already on whatever storage this instance uses, and sending is a matter of
// tying them to the message that finally exists. Deleting the row takes the file
// with it - see `cancelScheduled`, which is the only place that happens.
model ChatScheduledFile {
    id           String   @id @default(uuid(7)) @db.Uuid
    scheduledId  String   @db.Uuid
    name         String
    size         BigInt   @default(0)
    contentType  String   @default("application/octet-stream")
    connectionId String?  @db.Uuid
    path         String
    durationMs   Int?
    waveform     String?
    // The still that came with it, carried across so a message scheduled with a
    // video arrives with the same thumbnail it would have had.
    posterPath   String?
    posterConnectionId String? @db.Uuid
    createdAt    DateTime @default(now())

    scheduled ChatScheduledMessage @relation(fields: [scheduledId], references: [id], onDelete: Cascade)

    @@index([scheduledId])
}

// A message somebody kept.
//
// Private to the person who kept it - starring is a bookmark, not a signal to
// the room, and a public one would turn "I need to come back to this" into a
// statement about somebody else's message. That is what reactions are for.
model ChatStar {
    id        String   @id @default(uuid(7)) @db.Uuid
    messageId String   @db.Uuid
    userId    String   @db.Uuid
    createdAt DateTime @default(now())

    message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

    @@unique([messageId, userId])
    @@index([userId, createdAt])
}

// What a message said before somebody edited it.
//
// One row per edit, holding the text that was replaced and the moment it was
// replaced; the current body on the message is the newest version and needs no
// row of its own. That way the history is exactly "what this used to say", which
// is the question somebody clicking (edited) is asking.
//
// Written only while the scope's rules keep history. An admin who turns it off
// is not left with one accumulating in the database that nobody can read.
model ChatMessageEdit {
    id         String   @id @default(uuid(7)) @db.Uuid
    messageId  String   @db.Uuid
    // The body as it stood before this edit.
    body       String
    // When it stopped being the current text.
    replacedAt DateTime @default(now())

    message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

    @@index([messageId, replacedAt])
}

// What a link posted in a conversation turned out to be.
//
// Keyed by the address rather than by the message: the same link posted in four
// rooms is one page, and fetching it four times would tell whoever runs that
// page four times over that somebody here read it.
//
// A row is written even when the look failed, which is what stops a dead link
// being re-fetched on every render. `ok` is what the difference is.
model LinkPreview {
    id          String   @id @default(uuid(7)) @db.Uuid
    // Capped by the caller at what a unique index can hold; longer than that is
    // a payload rather than a link.
    url         String   @unique
    title       String   @default("")
    description String   @default("")
    // Who made the thing, when the site says so: the channel behind a video, the
    // byline on an article.
    author      String   @default("")
    siteName    String   @default("")
    // The colour the site declares for itself, as `#rrggbb`. Written by the edge
    // of the card, so a video reads as the site it is on before it is read at
    // all.
    accent      String?
    // Where the picture is, as that site addresses it. Never handed to a
    // browser: it is fetched back through Polaris, so reading a message does not
    // announce the reader to a third party.
    imageUrl    String?
    ok          Boolean  @default(false)
    fetchedAt   DateTime @default(now())

    @@index([fetchedAt])
}

// Who may see what about somebody.
//
// One row per account, written only when they change something - an account with
// no row is on the defaults, which are the open ones. Every field is the same
// three-valued audience so the screen reads as one idea rather than a switch, a
// dropdown and a radio group that happen to sit together.
model UserPrivacy {
    userId String @id @db.Uuid
    // everyone | friends | nobody
    //
    // Whether the account turns up when somebody searches for people. Not a
    // detail of their presence like the three below it but a fact about the
    // account, and the one setting here that decides whether two people who
    // share an instance can find each other at all.
    discoverable String   @default("everyone")
    lastSeen     String   @default("everyone")
    readReceipts String   @default("everyone")
    avatar       String   @default("everyone")
    // Whether the photo can be opened and looked at full size, which is a
    // separate question from whether it is shown at all: being recognisable in a
    // list is what a photo is for, and it is not the same as offering it to be
    // studied. Open by default like the rest.
    photoFullSize String  @default("everyone")
    // The three that are shut until somebody opens them, and the only ones. An
    // address and a number are not details of a presence: they are what spam,
    // password resets and impersonation start from, and nothing in Polaris needs
    // either to name somebody, mention them or write to them.
    //
    // Somebody's actual name is the third, and it is shut for the same reason the
    // display name exists at all: the name an account shows is the one it chose
    // to be known by, and the name on its documents is a different fact about a
    // person that being in a conversation with them is not consent to.
    fullName     String   @default("nobody")
    email        String   @default("nobody")
    phone        String   @default("nobody")
    // Who may send something this account wrote into another conversation. Open
    // by default, like the rest: a messenger where nothing can be passed on is
    // not what anybody expects, and a default that removed a button would read
    // as a bug rather than as a setting.
    forwarding   String   @default("everyone")
    updatedAt    DateTime @updatedAt

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// One repeating window in which an account appears as something it decided in
// advance rather than something worked out from whether it is at a screen.
//
// A rule about a week, not a moment: minutes past midnight and a set of
// weekdays, read against the account's own clock. Stored that way rather than as
// a pair of timestamps because it is the only shape that survives the clocks
// moving, a change of timezone, and next Tuesday - and because nothing has to
// rewrite anything for tomorrow's window to be right.
//
// An end at or before the start is a window that crosses midnight, which is the
// common case (23:00 to 07:00) rather than an edge one. The days named are the
// days it opens on.
//
// Nothing sweeps these and no job applies them: whether one is open is worked
// out when somebody's dot is drawn, which matters more here than for a lapsed
// status - a background job that has to be running for somebody to be invisible
// is a job whose absence tells everybody where they are.
model PresenceSchedule {
    id          String   @id @default(uuid(7)) @db.Uuid
    userId      String   @db.Uuid
    // What to appear as while it is open: busy | away | invisible. Never `auto`,
    // which means "work it out" and so would schedule nothing.
    presence    String
    // Which days it opens on, as a bitmask of getDay() indexes - bit 0 Sunday
    // through bit 6 Saturday. One integer rather than seven columns or a row per
    // day: every question asked of it is a bit test, and it is portable to both
    // engines this schema has to fit.
    days        Int
    // Minutes past midnight on the account's own clock, 0 to 1439.
    startMinute Int
    endMinute   Int
    // Off keeps the window without applying it, which is what somebody wants for
    // the week they are on holiday and is not what deleting it means.
    enabled     Boolean  @default(true)
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
}

// A set of people one account names in its privacy settings.
//
// Saved and reused rather than picked per setting: the same three or four names
// are usually the answer to more than one question, and re-picking them is how
// two settings that were meant to agree drift apart.
//
// A list with an empty name is one picked for a single setting rather than kept -
// it belongs to that setting, is edited from its row, and is never offered
// anywhere else. Same table because it is the same thing; the name is what makes
// one worth showing in the list of lists.
model PrivacyList {
    id        String   @id @default(uuid(7)) @db.Uuid
    userId    String   @db.Uuid
    name      String   @default("")
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    user    User                @relation(fields: [userId], references: [id], onDelete: Cascade)
    members PrivacyListMember[]
    usedBy  PrivacyFieldList[]

    @@index([userId])
}

model PrivacyListMember {
    listId String @db.Uuid
    userId String @db.Uuid

    list PrivacyList @relation(fields: [listId], references: [id], onDelete: Cascade)
    user User        @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@id([listId, userId])
    @@index([userId])
}

// Which set one of an account's settings names.
//
// Its own row rather than a column per setting: the settings are a list that
// grows, and a table that grows a pair of columns every time one is added is a
// migration nobody remembers to write. One row per setting that names a list at
// all, which is the uncommon case.
//
// A rule left pointing at nothing reads as one naming nobody, which is why a
// list that is still in use cannot be deleted from the screen: "only these
// people" would go on meaning nobody, quietly, and "everybody except" would go
// on meaning everybody. The rule is asked about, never assumed.
model PrivacyFieldList {
    userId String @db.Uuid
    // One of PRIVACY_FIELDS in @polaris/core.
    field  String
    listId String @db.Uuid

    user User        @relation(fields: [userId], references: [id], onDelete: Cascade)
    list PrivacyList @relation(fields: [listId], references: [id], onDelete: Cascade)

    @@id([userId, field])
    @@index([listId])
}

// One account that has decided it does not want to hear from another.
//
// A person's own decision, and the opposite of a timeout in every way that
// matters: a timeout is a room deciding somebody may not speak in it, ends by
// itself, and is visible to whoever runs the room. This is one-sided, lasts
// until it is lifted, and is nobody else's business - least of all the person
// blocked, who is never told.
//
// Kept as a direction rather than a pair, because it is not symmetric: it says
// nothing about how the other person feels, and each side can hold one without
// the other. Everything that lets one account reach another asks about both
// directions and refuses if either is set - a blocked account must not be able
// to write to whoever blocked them, and somebody who blocked a person should not
// be surprised by a conversation with them either.
model UserBlock {
    blockerId String   @db.Uuid
    blockedId String   @db.Uuid
    createdAt DateTime @default(now())

    blocker User @relation("UserBlockBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
    blocked User @relation("UserBlockBlocked", fields: [blockedId], references: [id], onDelete: Cascade)

    @@id([blockerId, blockedId])
    // Answering "who has blocked me", which every reach check asks and which the
    // primary key alone cannot serve.
    @@index([blockedId])
}

// Two accounts that know each other.
//
// One row per pair, and the direction is kept because it is the answer to "who
// asked" while it is pending. Once accepted the pair is unordered and every read
// looks at both columns.
model Friendship {
    id          String    @id @default(uuid(7)) @db.Uuid
    requesterId String    @db.Uuid
    addresseeId String    @db.Uuid
    // pending | accepted
    status      String    @default("pending")
    createdAt   DateTime  @default(now())
    respondedAt DateTime?

    requester User @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
    addressee User @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

    // One pair, one row in each direction at most. Asking somebody who has
    // already asked you is answered by the service rather than stored twice.
    @@unique([requesterId, addresseeId])
    @@index([addresseeId, status])
    @@index([requesterId, status])
}

// ---------------------------------------------------------------------------
// Meetings (calls)
// ---------------------------------------------------------------------------

// A call.
//
// Started from a conversation, or standing on its own. Media never touches
// Polaris - the browsers connect to each other directly - so what is stored here
// is who is in the room and how somebody gets into it, not a second of audio.
//
// `guestToken` is the whole of the outside-access story: a link that lets
// somebody with no Polaris account join a call an account holder started. It is
// null when the host did not want that, and it is per-meeting rather than
// per-account, so handing one out grants exactly one room and only while it
// runs.
//
// `hostId` is a bare uuid rather than a foreign key. A meeting is minutes long
// and its record is a fact about what happened; it is not worth a cascade that
// would rewrite history when somebody leaves the company.
model Meeting {
    id            String    @id @default(uuid(7)) @db.Uuid
    // The conversation it belongs to, or null for one that belongs to nothing.
    channelId     String?   @db.Uuid
    // The conversation this call holds while it runs, and null once it has
    // ended. Unique, so two people pressing the call button at the same instant
    // end up in one room rather than two: the second insert is refused and reads
    // back the first. Null is distinct from null in Postgres, which is what
    // lets every ended call keep sitting here.
    liveKey       String?   @unique @db.Uuid
    hostId        String    @db.Uuid
    title         String    @default("")
    guestToken    String?   @unique
    // Whether a guest waits in a lobby until somebody inside lets them in. On by
    // default: a link that can be forwarded is a link that will be, and the host
    // seeing who is at the door is the only check left after that.
    approveGuests Boolean   @default(true)
    // Whether getting in takes a Polaris account. Off by default, because the
    // whole point of a meeting link is that the person on the other end does not
    // have one - but a host discussing something internal can say otherwise, and
    // then the link still names the meeting and the only way through it is
    // signing in.
    requireAccount Boolean  @default(false)
    // When it is meant to happen, for a meeting somebody put in the diary rather
    // than started on the spot. Null for a call that began the moment a button
    // was pressed, which is every call started from a conversation.
    scheduledAt   DateTime?
    startedAt     DateTime  @default(now())
    // Set when the last person leaves, or when the host ends it. A meeting with
    // this set refuses every join, including one holding the guest token.
    endedAt       DateTime?
    createdAt     DateTime  @default(now())

    channel      ChatChannel?         @relation(fields: [channelId], references: [id], onDelete: Cascade)
    participants MeetingParticipant[]
    invites      MeetingInvite[]
    messages     MeetingMessage[]

    @@index([channelId, endedAt])
    @@index([endedAt])
    @@index([scheduledAt])
}

// Somebody with an account, convened to a meeting.
//
// Not a seat and not a permission: it is a fact that they were asked, which is
// what puts the meeting on their own list and an alert in their bell. Whether
// they may get in is answered when they knock - by the meeting, not by this row -
// so removing an invitation does not lock somebody out of a call they are
// already sitting in, and holding one does not walk anybody past a lobby.
model MeetingInvite {
    id          String   @id @default(uuid(7)) @db.Uuid
    meetingId   String   @db.Uuid
    userId      String   @db.Uuid
    invitedById String   @db.Uuid
    createdAt   DateTime @default(now())

    meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

    @@unique([meetingId, userId])
    @@index([userId])
}

// What was said in a meeting's own chat.
//
// Its own table rather than the conversation's, and it has to be: half the room
// may have no account at all, and every message in Chat is written by a user id
// against a channel somebody is a member of. Neither is true of a guest who
// typed a name into a link ten seconds ago.
//
// So a line here is written by a *seat* - the same participant row the roster
// draws - which is the only identity a meeting can promise for everybody in it.
// It goes when the meeting goes, which is the other half of the bargain: this is
// the chat of a call, not a record of a conversation, and nobody should discover
// a year later that what they typed into a call outlived the call.
model MeetingMessage {
    id            String   @id @default(uuid(7)) @db.Uuid
    meetingId     String   @db.Uuid
    participantId String   @db.Uuid
    body          String
    createdAt     DateTime @default(now())

    meeting     Meeting            @relation(fields: [meetingId], references: [id], onDelete: Cascade)
    participant MeetingParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

    @@index([meetingId, createdAt])
}

// Somebody in a call, or somebody at the door.
//
// One row per join rather than one per person: leaving and coming back is two
// rows, which is what makes "who was in this call" answerable afterwards.
//
// `guestKey` is a guest's credential for their own row and nothing else. It is
// minted server-side, handed back once in a cookie, and is the only thing that
// lets a browser with no session say "this is me" - so it is unique, unguessable
// and worth nothing outside this meeting.
model MeetingParticipant {
    id         String    @id @default(uuid(7)) @db.Uuid
    meetingId  String    @db.Uuid
    // The account, or null for somebody who arrived on the guest link.
    userId     String?   @db.Uuid
    // What to draw beside them. An account's own name, or what a guest typed.
    name       String
    guestKey   String?   @unique
    // admitted | waiting | denied. Only ever anything but `admitted` for a guest
    // at a meeting whose host asked to approve them.
    admission  String    @default("admitted")
    joinedAt   DateTime  @default(now())
    leftAt     DateTime?
    // Refreshed while their browser is on the call, so a participant whose
    // laptop shut is swept rather than left in the room forever.
    lastSeenAt DateTime  @default(now())

    meeting  Meeting          @relation(fields: [meetingId], references: [id], onDelete: Cascade)
    messages MeetingMessage[]

    @@index([meetingId, leftAt])
    @@index([meetingId, admission])
}
// One capability switched on or off for one account, regardless of their role.
//
// Roles answer "what does somebody like this do", and that is the right question
// almost always. This is the exception: one person who needs the chat and whose
// role does not carry it, one person who must not have it and whose role does.
// Making a role for each of those is how an instance ends up with nine roles and
// nobody able to say what any of them means.
//
// It is a statement source like a role or a policy, not a field that shadows
// them: `effect` is allow or deny, and the same engine resolves it, so an
// explicit deny beats every allow underneath it exactly as it does anywhere
// else. An account with no row for a permission simply falls through to whatever
// their role and policies say, which is why absence is not the same as deny and
// the screen has three states rather than a checkbox.
model UserPermission {
    id         String   @id @default(uuid(7)) @db.Uuid
    userId     String   @db.Uuid
    // A key from PERMISSIONS in @polaris/core. Stored as text rather than an
    // enum for the same reason every other permission column is: the list grows,
    // and a migration per capability is a tax on adding one.
    permission String
    // allow | deny
    effect     String
    // Who set it and when. An override is an exception to the rules the instance
    // otherwise runs on, so it is worth being able to ask who made it.
    setById    String?  @db.Uuid
    createdAt  DateTime @default(now())
    updatedAt  DateTime @updatedAt

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([userId, permission])
    @@index([userId])
}
// A place the cameras are in: a house, an office, a workshop, a site.
//
// Home began as one house because that is what one person has, and it is not
// what anybody has for long: a flat and a parents' house, an office and the
// warehouse behind it. The alternative to this table is a "location" field on a
// camera, which reads the same on the first screen and cannot carry what a place
// actually owns - who may see it, what it alerts on, what the cameras there are
// keeping.
//
// Not an organization and not a scope: those say whose work this is. A place says
// where a camera physically points, which is a different question and one that
// somebody with a single account still has more than one answer to.
model Place {
    id             String @id @default(uuid(7)) @db.Uuid
    // The Home install this belongs to. Bare uuid, per the InstalledApp precedent.
    installedAppId String @db.Uuid
    name           String
    /// house | office | site | other - what it is, which is only ever a label and
    /// an icon. Nothing behaves differently; it is there because "Warehouse" and
    /// "Mum's" read better with the right symbol beside them.
    kind           String @default("house")
    /// Where it is, in the words somebody would use. Never geocoded - a house is
    /// not a map pin here, and a stored coordinate for somebody's home is a
    /// liability with no use.
    address        String?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    cameras Camera[]

    @@index([installedAppId])
}

// A camera Polaris watches.
//
// One row per physical camera, whatever it is reached through. Most of what makes
// a camera awkward is that the same box answers on several addresses at once - a
// high-quality stream, a low-quality one, an ONVIF service on another port - and
// that it will usually allow only one connection to the good stream. So the paths
// are resolved once, when the camera is added, and Polaris holds exactly one pull
// open per camera and re-serves it to everybody watching. Nothing in the
// dashboard ever opens a second connection to a camera.
//
// The password is envelope-encrypted, like a Host's: it is the credential to a
// live view of somebody's home, and a database dump must not be a way in.
model Camera {
    id             String  @id @default(uuid(7)) @db.Uuid
    // The Home install this belongs to. Bare uuid, per the InstalledApp precedent
    // of not linking installs by foreign key.
    installedAppId String  @db.Uuid
    /// The place it is in. Null on a camera added before places existed, which
    /// the app reads as "the first one" and repairs on sight - a camera somebody
    /// already set up must not disappear because a table was added under it.
    placeId        String? @db.Uuid
    name           String
    /// Where in that place it points ("Front door"). Free text, and the only
    /// grouping the wall has - a table of zones would be a second thing to
    /// maintain for a list that is read once per screen.
    zone           String?
    /// tapo | reolink | hikvision | dahua | onvif | generic - what it is, which
    /// decides the stream paths and how it is controlled when it was not probed.
    vendor         String  @default("generic")
    /// What the camera calls itself, as reported over ONVIF. Kept for the row,
    /// not for logic.
    model          String?

    // How Polaris reaches it.
    address   String
    rtspPort  Int     @default(554)
    /// The ONVIF service port when it speaks ONVIF: 80 on most, 2020 on Tapo.
    /// Null when it does not, which is what makes the movement controls absent
    /// rather than broken.
    onvifPort Int?
    /// Stream paths below the host, resolved when the camera was added and then
    /// left alone. `mainPath` is the quality that gets recorded and watched;
    /// `subPath` is the small one detection reads, because running detection on
    /// the main stream is how a house of cameras eats a machine.
    mainPath  String?
    subPath   String?
    username  String?
    // Envelope-encrypted camera password.
    encryptedSecret Bytes?
    secretNonce     Bytes?
    secretKeyId     String?

    /// direct, or `server:<hostId>` for a camera on a network Polaris cannot
    /// reach: that machine holds the RTSP connection on its own LAN and the
    /// stream comes back over the channel Polaris already has to it.
    reachVia      String  @default("direct")
    /// The DeployTarget running the relay that holds this camera's connection.
    /// Null until the first viewer, which is what keeps an added-but-never-opened
    /// camera from costing anything.
    relayTargetId String? @db.Uuid

    /// none | camera | motion | objects | faces - the most expensive stage this
    /// camera is allowed to reach. Each stage gates the next, so `faces` still
    /// means "only when movement was seen, and only if it looked like a person".
    detector         String  @default("camera")
    /// Where that detection runs, when it is not the camera doing it itself.
    detectorTargetId String? @db.Uuid
    /// Tuning for the chosen detector as a JSON object: sensitivity, the hours it
    /// is on, the shortest gap between two looks. Read whole with the camera and
    /// never queried by field, so it is one column rather than a table per knob.
    detectionConfig  String  @default("{}")

    /// off | motion | continuous.
    recording     String  @default("off")
    /// Which storage this camera's footage is written to: a storage connection
    /// id, `local` for this server, or null for whatever the instance is set to
    /// under Uploads. Per camera because the disks are not interchangeable - a
    /// doorbell recording all day and a garage that fires twice a week do not
    /// belong on the same one just because they were added on the same evening.
    storageTarget String?
    /// Days a clip from this camera is kept. Storage is the one resource a camera
    /// spends whether or not anybody watches, so every camera has a limit and it
    /// is per camera - a doorbell and a garage do not deserve the same month.
    retentionDays Int     @default(7)
    /// Off means Polaris does not connect to it at all: no relay, no detection,
    /// no recording. The row stays, so its clips and its settings survive.
    enabled       Boolean @default(true)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    place  Place?        @relation(fields: [placeId], references: [id], onDelete: SetNull)
    events CameraEvent[]
    clips  CameraClip[]
    zones  CameraZone[]

    @@index([installedAppId])
    @@index([placeId])
    @@index([installedAppId, zone])
}

// Something a camera saw.
//
// The row is the record; the picture and the footage are not in it. A still is a
// key into the storage the house writes to, and a clip is its own row, so an
// event costs a few hundred bytes however many of them a windy afternoon
// produces.
model CameraEvent {
    id        String    @id @default(uuid(7)) @db.Uuid
    cameraId  String    @db.Uuid
    at        DateTime  @default(now())
    /// motion | person | vehicle | animal | face | offline | tamper - what was
    /// seen, at the most specific stage that ran.
    kind      String
    /// Who or what, when the stage that ran can say: the name of a known face,
    /// the object class. Null for bare movement.
    label     String?
    /// 0-100, as the detector reported it, so a threshold can be moved later
    /// without the events already recorded becoming unreadable.
    score     Int?
    /// Where the still is, as a key in the house's storage. Null when the stage
    /// that fired keeps no picture (a camera reporting its own motion).
    stillKey  String?
    /// Where in the picture it was, as a JSON [x1, y1, x2, y2] of fractions of
    /// the frame. Relative rather than pixels so it can be drawn over a still of
    /// any size, and over the live view of a camera whose stream has since
    /// changed resolution. Null on anything that did not come from a detector
    /// with an opinion about position - a camera's own alert, or a warning.
    box       String?
    /// The areas of the camera it was standing in, as a JSON array of their
    /// names. Names rather than ids on purpose: an area redrawn or removed next
    /// month must not silently rewrite what a camera saw last night.
    zones     String  @default("[]")
    /// When it stopped being there. A detector that follows something across
    /// frames knows the difference between somebody arriving and somebody still
    /// standing there, so an event has a length rather than only an instant.
    /// Null on an event that was an instant, and on one still happening.
    endedAt   DateTime?
    /// What the detector called this thing while it was following it. Not a
    /// stable identity - the same person tomorrow is a different one - only the
    /// handle that lets a later frame update the event it already opened.
    trackId   String?
    /// The recording this event sits inside, when one was kept.
    clipId    String?   @db.Uuid
    /// Somebody has seen this and it needs no further attention.
    ackedAt   DateTime?
    ackedById String?   @db.Uuid

    camera Camera      @relation(fields: [cameraId], references: [id], onDelete: Cascade)
    clip   CameraClip? @relation(fields: [clipId], references: [id], onDelete: SetNull)

    // The three questions asked of this table: what happened on this camera, what
    // happened anywhere (the house's feed), and what of one kind happened here.
    @@index([cameraId, at])
    @@index([at])
    @@index([cameraId, kind, at])
    // How a later frame finds the event it already opened for this thing.
    @@index([cameraId, trackId])
}

// Footage kept on disk.
//
// Written in segments rather than as one file per event, so a camera that records
// all day does not become one unbounded recording, and an event that spans two
// segments still resolves to both.
model CameraClip {
    id        String    @id @default(uuid(7)) @db.Uuid
    cameraId  String    @db.Uuid
    startedAt DateTime
    endedAt   DateTime?
    /// motion | continuous | manual - why this segment exists, which is also what
    /// decides whether retention may drop it.
    reason    String    @default("motion")
    /// Where the file is: the storage connection it was written to, and the path
    /// inside it. A null connection means the house's default destination, so a
    /// clip does not go missing when that default is changed later.
    connectionId String? @db.Uuid
    path         String
    bytes        BigInt  @default(0)
    durationMs   Int     @default(0)
    /// Kept until somebody removes it, whatever the retention says. This is how
    /// the clip of the one night that mattered survives a seven-day house.
    pinned       Boolean @default(false)

    createdAt DateTime @default(now())

    camera Camera        @relation(fields: [cameraId], references: [id], onDelete: Cascade)
    events CameraEvent[]

    // Listing a camera's footage newest first, and the retention sweep, which
    // asks for everything older than a date and not pinned.
    @@index([cameraId, startedAt])
    @@index([startedAt])
}

// When to tell somebody, and who.
//
// The bell is a record: a list you come back to and clear, and the right home
// for "an update is available". Somebody walking up to the door at three in the
// morning is not that - it is worth interrupting for, once, and then it is over.
// So an alert is delivered as a message in a conversation: it appears where a
// message appears, it can be muted the way a conversation is muted, and it
// leaves a thread somebody can scroll rather than a badge they clear.
//
// A rule is deliberately small. What was seen, optionally who, optionally where,
// optionally between which hours - and who hears about it. Anything more
// expressive is a rules engine, and a rules engine is a thing people configure
// once and then cannot read six months later.
model AlertRule {
    id             String  @id @default(uuid(7)) @db.Uuid
    installedAppId String  @db.Uuid
    /// The place this watches. Null means everywhere.
    placeId        String? @db.Uuid
    /// One camera, or every camera in that place.
    cameraId       String? @db.Uuid
    name           String
    /// Which detections it fires on, as a JSON array of event kinds. Read whole
    /// and never queried by element, so it is one column rather than a table.
    kinds          String  @default("[\"person\"]")
    /// Only this person, by the name the recognizer puts to them. Null is
    /// anybody - including, deliberately, a stranger.
    label          String?
    /// The hours it applies, as a JSON {from,to} in local time, or null for all
    /// day. The same shape a camera's detection window uses.
    hours          String?
    /// Who hears about it, as a JSON array of user ids.
    recipients     String  @default("[]")
    /// The conversation it posts into, made the first time it fires so a rule
    /// nobody triggers never creates a room.
    channelId      String? @db.Uuid
    enabled        Boolean @default(true)
    createdById    String? @db.Uuid

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([installedAppId])
    @@index([placeId])
    @@index([cameraId])
}

// Somebody the house knows by sight.
//
// Deliberately holds no face data. The template that recognizes a person lives in
// whichever recognition service the operator chose to install and stays on that
// machine; this is the name they are known by here and the id they answer to
// there, so removing a person from Polaris is a delete in both and never leaves a
// biometric record behind in the one nobody thinks to look at.
model HomePerson {
    id             String  @id @default(uuid(7)) @db.Uuid
    installedAppId String  @db.Uuid
    name           String
    /// The subject this person is filed under in the recognition service. Set
    /// from the name when they were written down and never moved afterwards, so
    /// correcting a name does not cost somebody the photographs already taught
    /// for them. Unique per house for the same reason the name is: two people
    /// sharing a subject share a face.
    subjectId      String
    /// Whether seeing them is worth reporting. A household is recognized so that
    /// it stops raising alerts, not so that every arrival home becomes one.
    notify         Boolean @default(false)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([installedAppId, name])
    @@unique([installedAppId, subjectId])
    @@index([installedAppId])
}

// The parts of a camera's picture that count, and the ones that never do.
//
// A camera sees one rectangle and has no opinion about it, and that is where
// almost every useless alert comes from: the road at the bottom of the drive,
// the tree by the fence, the neighbour's door. None of those is a detection
// fault - the detector is right, a car really did go past - so no amount of
// sensitivity fixes them. What is missing is a way to say where in the picture
// Polaris is looking.
//
// Two kinds and no more. A `watch` zone narrows the camera: once one exists,
// something only counts when it is standing inside one of them, and the event
// records which. An `ignore` zone is never reported, whatever else says
// otherwise. Between them they cover the mask, the required area and the
// per-area object filter that the field's three main projects each spell
// differently.
model CameraZone {
    id       String @id @default(uuid(7)) @db.Uuid
    cameraId String @db.Uuid
    name     String
    /// watch | ignore.
    kind     String @default("watch")
    /// The outline, as a JSON array of [x, y] pairs from 0 to 1 across the
    /// frame. Relative rather than pixels because a zone is drawn on whatever
    /// size picture the browser loaded and tested against whatever size frame
    /// the detector decoded, and those are never the same number - storing
    /// pixels means the zone silently moves the day the stream's resolution
    /// changes.
    points   String
    /// Which classes count here, as a JSON array, or empty for all of them. A
    /// drive that only cares about vehicles and a doorway that only cares about
    /// people are the same camera.
    objects  String @default("[]")
    /// Frames running something must be inside before it is counted as inside.
    /// A detector's box wobbles by a few pixels every frame, and on a boundary
    /// that reads as somebody stepping in and out twice a second.
    inertia  Int    @default(3)
    /// Seconds it must stay before it counts at all. Zero is the normal case;
    /// a car park that only cares about somebody who stopped is not.
    loiterSeconds Int @default(0)
    enabled  Boolean @default(true)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    camera Camera @relation(fields: [cameraId], references: [id], onDelete: Cascade)

    // Two names on one camera would make an event's zone list ambiguous, which
    // is the one thing the list has to be.
    @@unique([cameraId, name])
    @@index([cameraId])
}
