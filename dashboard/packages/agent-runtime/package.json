{
    "name": "@polaris/agent-runtime",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "description": "Coding-agent runtime: drives an agent over a checked-out repository with a git/GitHub tool server. Runs in a GitHub Actions job, on a Polaris runner, or in a container on the Polaris box.",
    "exports": {
        "./shared": {
            "types": "./dist/shared.d.ts",
            "import": "./dist/shared.js"
        },
        "./control": {
            "types": "./dist/control.d.ts",
            "import": "./dist/control.js"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "build": "tsup --entry.shared external.ts --entry.control internal/index.ts --format esm --dts --clean --out-dir dist && node esbuild.config.js",
        "build:bundle": "node esbuild.config.js",
        "typecheck": "tsc --noEmit",
        "test": "vitest run --passWithNoTests"
    },
    "//": "The agent CLIs (@anthropic-ai/claude-code, opencode-ai, agent-browser, skills) are NOT imported. utils/install.ts reads their version from this file and installs them into the run's workspace, so these entries are version pins and removing one breaks the run rather than the build.",
    "devDependencies": {
        "@actions/core": "1.11.1",
        "@anthropic-ai/claude-code": "2.1.150",
        "@modelcontextprotocol/sdk": "1.26.0",
        "@octokit/plugin-throttling": "11.0.3",
        "@octokit/rest": "22.0.0",
        "@octokit/webhooks-types": "7.6.1",
        "@opencode-ai/sdk": "1.18.5",
        "@standard-schema/spec": "1.1.0",
        "@toon-format/toon": "1.0.0",
        "@types/node": "24.7.2",
        "@types/object-hash": "3.0.6",
        "@types/semver": "7.7.1",
        "@types/turndown": "5.0.5",
        "agent-browser": "0.25.4",
        "ajv": "8.18.0",
        "arkregex": "0.0.5",
        "arktype": "2.2.0",
        "dotenv": "17.2.3",
        "esbuild": "0.28.1",
        "fastmcp": "3.34.0",
        "file-type": "21.3.0",
        "lru-cache": "11.0.0",
        "object-hash": "3.0.0",
        "opencode-ai": "1.18.5",
        "package-manager-detector": "1.6.0",
        "semver": "7.7.3",
        "skills": "1.4.9",
        "table": "6.9.0",
        "turndown": "7.2.0",
        "typescript": "5.9.3",
        "undici": "7.22.0",
        "zod": "3.24.1"
    }
}
