{
    "name": "@polaris/font-metrics",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "description": "Font metrics without a font file: the tables a layout needs to measure text. Ported from GenOffice (Apache-2.0) - see NOTICE.",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "scripts": {
        "build": "tsup src/index.ts --format esm --dts --clean",
        "typecheck": "tsc --noEmit",
        "test": "vitest run --passWithNoTests"
    },
    "dependencies": {}
}
