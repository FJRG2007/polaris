{
    "name": "@polaris/genoffice-markdown",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "description": "GenOffice's markdown editor, its renderer half. Ported from GenOffice (Apache-2.0) - see NOTICE. Not wired to a route: the bridge it talks to is an Electron channel, and Polaris' equivalent is server actions.",
    "exports": {
        ".": {
            "types": "./dist/App.d.ts",
            "import": "./dist/App.js",
            "default": "./dist/App.js"
        },
        "./styles.css": "./dist/styles.css"
    },
    "scripts": {
        "build": "tsup src/renderer/App.tsx --format esm --dts --clean --external react --external react-dom && node ../../scripts/scope-editor-styles.mjs genoffice-markdown --assets=/office-fonts @ui/tokens.css @ui/screentip.css @ui/dropdown.css @ui/ribbon-collapse.css @ui/markdown.css src/renderer/styles.css ../../node_modules/katex/dist/katex.min.css",
        "typecheck": "tsc --noEmit",
        "test": "vitest run --passWithNoTests"
    },
    "dependencies": {
        "@polaris/genoffice-agent": "*",
        "@polaris/genoffice-ai": "*",
        "@polaris/genoffice-docs": "*",
        "@polaris/genoffice-i18n": "*",
        "@polaris/genoffice-ui": "*",
        "@polaris/project-store": "*",
        "@tiptap/core": "3.31.0",
        "@tiptap/extension-code-block": "3.31.0",
        "@tiptap/extension-image": "3.31.0",
        "@tiptap/extension-list": "3.31.0",
        "@tiptap/extension-mathematics": "3.31.0",
        "@tiptap/extension-table": "3.31.0",
        "@tiptap/extensions": "3.31.0",
        "@tiptap/markdown": "3.31.0",
        "@tiptap/pm": "3.31.0",
        "@tiptap/react": "3.31.0",
        "@tiptap/starter-kit": "3.31.0",
        "@tiptap/suggestion": "3.31.0",
        "katex": "0.16.11",
        "react": "19.0.0",
        "react-dom": "19.0.0"
    },
    "main": "./dist/App.js",
    "types": "./dist/App.d.ts",
    "devDependencies": {
        "postcss": "^8.5.19",
        "postcss-selector-parser": "^6.1.4"
    }
}
