{
    "name": "@polaris/core",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "description": "Pure Polaris domain logic: schemas, CIDR matching, tokens, permissions, path safety.",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./tokens": {
            "types": "./dist/tokens.d.ts",
            "import": "./dist/tokens.js"
        },
        "./waf": {
            "types": "./dist/waf.d.ts",
            "import": "./dist/waf.js"
        },
        "./link-password": {
            "types": "./dist/link-password.d.ts",
            "import": "./dist/link-password.js"
        },
        "./faces": {
            "types": "./dist/faces.d.ts",
            "import": "./dist/faces.js"
        },
        "./password-generator": {
            "types": "./dist/password-generator.d.ts",
            "import": "./dist/password-generator.js"
        },
        "./catalog-search": {
            "types": "./dist/catalog-search.d.ts",
            "import": "./dist/catalog-search.js"
        },
        "./sheets": {
            "types": "./dist/sheets/index.d.ts",
            "import": "./dist/sheets/index.js"
        }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "scripts": {
        "build": "tsup src/index.ts src/tokens.ts src/link-password.ts src/password-generator.ts src/faces.ts src/waf.ts src/sheets/index.ts src/catalog-search.ts --format esm --dts --clean",
        "typecheck": "tsc --noEmit",
        "test": "vitest run --passWithNoTests"
    },
    "dependencies": {
        "fuse.js": "7.0.0",
        "ipaddr.js": "2.2.0",
        "zod": "3.24.1"
    }
}
