{
    "name": "@polaris/core",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "description": "Pure Polaris domain logic: schemas, CIDR matching, tokens, permissions, path safety.",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./tokens": {
            "types": "./dist/tokens.d.ts",
            "import": "./dist/tokens.js"
        },
        "./waf": {
            "types": "./dist/waf.d.ts",
            "import": "./dist/waf.js"
        },
        "./link-password": {
            "types": "./dist/link-password.d.ts",
            "import": "./dist/link-password.js"
        },
        "./faces": {
            "types": "./dist/faces.d.ts",
            "import": "./dist/faces.js"
        },
        "./password-generator": {
            "types": "./dist/password-generator.d.ts",
            "import": "./dist/password-generator.js"
        },
        "./extension-install": {
            "types": "./dist/extension-install.d.ts",
            "import": "./dist/extension-install.js"
        },
        "./browser-agent": {
            "types": "./dist/browser-agent.d.ts",
            "import": "./dist/browser-agent.js"
        },
        "./search-text": {
            "types": "./dist/search-text.d.ts",
            "import": "./dist/search-text.js"
        },
        "./catalog-search": {
            "types": "./dist/catalog-search.d.ts",
            "import": "./dist/catalog-search.js"
        },
        "./sheets": {
            "types": "./dist/sheets/index.d.ts",
            "import": "./dist/sheets/index.js"
        },
        "./variable-groups": {
            "types": "./dist/variable-groups.d.ts",
            "import": "./dist/variable-groups.js"
        },
        "./instance-fallback": {
            "types": "./dist/instance-fallback.d.ts",
            "import": "./dist/instance-fallback.js"
        }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "scripts": {
        "build": "tsup src/index.ts src/tokens.ts src/link-password.ts src/password-generator.ts src/faces.ts src/waf.ts src/sheets/index.ts src/catalog-search.ts src/search-text.ts src/extension-install.ts src/browser-agent.ts src/variable-groups.ts src/instance-fallback.ts --format esm --dts --clean",
        "typecheck": "tsc --noEmit",
        "test": "vitest run --passWithNoTests"
    },
    "dependencies": {
        "intl-messageformat": "12.1.3",
        "ipaddr.js": "2.2.0",
        "zod": "3.25.76"
    }
}
