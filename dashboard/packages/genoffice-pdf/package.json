{
    "name": "@polaris/genoffice-pdf",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "description": "GenOffice's pdf editor, its renderer half. Ported from GenOffice (Apache-2.0) - see NOTICE. Not wired to a route: the bridge it talks to is an Electron channel, and Polaris' equivalent is server actions.",
    "exports": {
        ".": {
            "types": "./dist/App.d.ts",
            "import": "./dist/App.js",
            "default": "./dist/App.js"
        }
    },
    "scripts": {
        "build": "tsup src/renderer/App.tsx --format esm --dts --clean --external react --external react-dom",
        "typecheck": "tsc --noEmit",
        "test": "vitest run --passWithNoTests"
    },
    "dependencies": {
        "@polaris/genoffice-agent": "*",
        "@polaris/genoffice-ai": "*",
        "@polaris/genoffice-i18n": "*",
        "@polaris/genoffice-ui": "*",
        "@polaris/pdf2docx": "*",
        "@polaris/project-store": "*",
        "pdfjs-dist": "6.1.200",
        "react": "19.0.0",
        "react-dom": "19.0.0"
    },
    "main": "./dist/App.js",
    "types": "./dist/App.d.ts"
}
