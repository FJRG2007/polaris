{
    "name": "@polaris/genoffice-agent",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "description": "The agent loop GenOffice's editors drive: turns, tools and their results. Ported from GenOffice (Apache-2.0) - see NOTICE.",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
