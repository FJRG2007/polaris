{
    "name": "@polaris/chat-crypto",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "description": "Chat end-to-end encryption, client side: the account key, the locks that wrap it, and the hybrid post-quantum envelope for stored keys.",
    "exports": {
        "./account-key": {
            "types": "./dist/account-key.d.ts",
            "import": "./dist/account-key.js"
        },
        "./locks": {
            "types": "./dist/locks.d.ts",
            "import": "./dist/locks.js"
        },
        "./device-lock": {
            "types": "./dist/device-lock.d.ts",
            "import": "./dist/device-lock.js"
        },
        "./password-lock": {
            "types": "./dist/password-lock.d.ts",
            "import": "./dist/password-lock.js"
        },
        "./passkey-lock": {
            "types": "./dist/passkey-lock.d.ts",
            "import": "./dist/passkey-lock.js"
        },
        "./hybrid-envelope": {
            "types": "./dist/hybrid-envelope.d.ts",
            "import": "./dist/hybrid-envelope.js"
        },
        "./message-content": {
            "types": "./dist/message-content.d.ts",
            "import": "./dist/message-content.js"
        },
        "./qr-approval": {
            "types": "./dist/qr-approval.d.ts",
            "import": "./dist/qr-approval.js"
        },
        "./platform-store": {
            "types": "./dist/platform-store.d.ts",
            "import": "./dist/platform-store.js"
        },
        "./opaque-server": {
            "types": "./dist/opaque-server.d.ts",
            "import": "./dist/opaque-server.js"
        }
    },
    "scripts": {
        "build": "tsup src/account-key.ts src/locks.ts src/device-lock.ts src/password-lock.ts src/passkey-lock.ts src/hybrid-envelope.ts src/message-content.ts src/opaque-server.ts src/qr-approval.ts src/platform-store.ts --format esm --dts --clean",
        "typecheck": "tsc --noEmit",
        "test": "vitest run --passWithNoTests"
    },
    "dependencies": {
        "@hpke/core": "1.10.1",
        "@hpke/hybridkem-x-wing": "0.7.1",
        "@serenity-kit/opaque": "1.1.0"
    },
    "devDependencies": {
        "fake-indexeddb": "6.2.8"
    }
}
