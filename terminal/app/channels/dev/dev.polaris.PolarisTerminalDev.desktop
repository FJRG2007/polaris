[Desktop Entry]
# The version of the desktop entry spec this conforms to.
Version=1.0

Type=Application

Name=PolarisTerminalDev
GenericName=TerminalEmulator

Exec=polaris-terminal-dev %U
StartupWMClass=dev.polaris.PolarisTerminalDev

Keywords=shell;prompt;command;commandline;cmd;

Icon=dev.polaris.PolarisTerminalDev

Categories=System;TerminalEmulator;

# Don't run this application within a terminal.
Terminal=false

# Register ourselves as the handler for polaris-terminal-dev:// URLs.
MimeType=x-scheme-handler/polaris-terminal-dev;
