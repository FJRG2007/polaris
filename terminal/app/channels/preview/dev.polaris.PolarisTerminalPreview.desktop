[Desktop Entry]
# The version of the desktop entry spec this conforms to.
Version=1.0

Type=Application

Name=PolarisTerminalPreview
GenericName=TerminalEmulator

Exec=polaris-terminal-preview %U
StartupWMClass=dev.polaris.PolarisTerminalPreview

Keywords=shell;prompt;command;commandline;cmd;

Icon=dev.polaris.PolarisTerminalPreview

Categories=System;TerminalEmulator;

# Don't run this application within a terminal.
Terminal=false

# Register ourselves as the handler for polaris-terminal-preview:// URLs.
MimeType=x-scheme-handler/polaris-terminal-preview;
