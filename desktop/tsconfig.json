{
    "compilerOptions": {
        "target": "ES2023",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "lib": ["ES2023", "DOM", "DOM.Iterable"],
        "types": ["node"],
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "noImplicitOverride": true,
        "noFallthroughCasesInSwitch": true,
        "isolatedModules": true,
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "noEmit": true,
        "jsx": "react-jsx",
        "baseUrl": ".",
        "paths": {
            "@/*": ["./src/*"],
            "@tv-compat/*": ["../dashboard/packages/core/src/tv-compat/*"],
            "@toolchain/*": ["../dashboard/packages/core/src/toolchain/*"],
            "zod": ["./node_modules/zod"],
            // The dashboard's UI sources the launcher draws import their
            // packages by name; they resolve here, from this app's own
            // node_modules, as esbuild resolves them (build/launcher-ui.mjs).
            "@polaris/core/*": ["../dashboard/packages/core/src/*"],
            "react": ["./node_modules/@types/react"],
            "react/*": ["./node_modules/@types/react/*"],
            "react-dom/*": ["./node_modules/@types/react-dom/*"],
            "lucide-react": ["./node_modules/lucide-react"],
            "clsx": ["./node_modules/clsx"],
            "tailwind-merge": ["./node_modules/tailwind-merge"]
        }
    },
    "include": ["src/**/*.ts", "src/**/*.tsx", "test/**/*.ts"],
    // Built against the dashboard's own "@" alias by run.mjs, not this one.
    "exclude": ["test/electron/links/page.ts"]
}
